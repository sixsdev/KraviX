	topBar.ZIndex = 11

	local titleLbl = lbl(topBar, title, 12, Enum.Font.GothamBold, T.Text, Enum.TextXAlignment.Left)
	titleLbl.Size = UDim2.new(1, -30, 1, 0)
	titleLbl.Position = UDim2.new(0, 8, 0, 0)
	titleLbl.ZIndex = 12

	local closeBtn = Instance.new("TextButton", topBar)
	closeBtn.Size = UDim2.new(0, 18, 0, 18)
	closeBtn.AnchorPoint = Vector2.new(1, 0.5)
	closeBtn.Position = UDim2.new(1, -5, 0.5, 0)
	closeBtn.BackgroundColor3 = T.Bg3
	closeBtn.Text = "×"
	closeBtn.TextSize = 14
	closeBtn.Font = Enum.Font.GothamBold
	closeBtn.TextColor3 = T.Sub
	closeBtn.AutoButtonColor = false
	closeBtn.BorderSizePixel = 0
	closeBtn.ZIndex = 12
	corner(closeBtn, 4)
	closeBtn.MouseEnter:Connect(function() tw(closeBtn, {BackgroundColor3=T.Red, TextColor3=T.Text}, 0.08) end)
	closeBtn.MouseLeave:Connect(function() tw(closeBtn, {BackgroundColor3=T.Bg3, TextColor3=T.Sub}, 0.08) end)


	local sep = Instance.new("Frame", main)
	sep.Size = UDim2.new(1, 0, 0, 1)
	sep.Position = UDim2.new(0, 0, 0, 26)
	sep.BackgroundColor3 = T.Border
	sep.BorderSizePixel = 0


	local content = Instance.new("Frame", main)
	content.Name = "Content"
	content.Size = UDim2.new(1, 0, 1, -27)
	content.Position = UDim2.new(0, 0, 0, 27)
	content.BackgroundTransparency = 1
	content.BorderSizePixel = 0
	content.ClipsDescendants = true
	content.ZIndex = 11

	makeDraggable(main, topBar)

	local win = {Gui=sg, Main=main, TopBar=topBar, Content=content, TitleLbl=titleLbl, CloseBtn=closeBtn, Open=false}

	function win:Show()
		if self.Open then return end
		self.Open = true
		sg.Enabled = true
		main.Size = UDim2.new(0, w*0.88, 0, h*0.88)
		main.Position = UDim2.new(0.5, -(w*0.88)/2, 0.5, -(h*0.88)/2)
		main.BackgroundTransparency = 1
		tw(main, {
			Size = UDim2.new(0,w,0,h),
			Position = UDim2.new(0.5,-w/2,0.5,-h/2),
			BackgroundTransparency = 0
		}, 0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	end

	function win:Hide()
		if not self.Open then return end
		self.Open = false
		tw(main, {
			Size = UDim2.new(0, w*0.88, 0, h*0.88),
			Position = UDim2.new(0.5, -(w*0.88)/2, 0.5, -(h*0.88)/2),
			BackgroundTransparency = 1
		}, 0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
		task.delay(0.2, function() if not self.Open then sg.Enabled = false end end)
	end

	function win:Toggle()
		if self.Open then self:Hide() else self:Show() end
	end

	function win:SetTitle(t) self.TitleLbl.Text = t end

	closeBtn.MouseButton1Click:Connect(function() win:Hide() end)

	return win
end


local Explorer = {}

function Explorer.Init(guiParent)
	local win = makeWindow("Explorer", 280, 500, guiParent)
	Explorer.Window = win


	local searchFrame = Instance.new("Frame", win.Content)
	searchFrame.Size = UDim2.new(1, -8, 0, 22)
