	local codeArea = Instance.new("Frame", win.Content)
	codeArea.Position = UDim2.fromOffset(0, 28)
	codeArea.Size = UDim2.new(1, 0, 1, -28)
	codeArea.BackgroundColor3 = T.SyntaxBg
	codeArea.BorderSizePixel = 0


	local lineNumFrame = Instance.new("Frame", codeArea)
	lineNumFrame.Size = UDim2.new(0, 40, 1, 0)
	lineNumFrame.BackgroundColor3 = T.Bg2
	lineNumFrame.BorderSizePixel = 0

	local lineNums = Instance.new("TextLabel", lineNumFrame)
	lineNums.Size = UDim2.new(1, -4, 1, 0)
	lineNums.Position = UDim2.fromOffset(0, 4)
	lineNums.BackgroundTransparency = 1
	lineNums.Font = Enum.Font.Code
	lineNums.TextSize = 13
	lineNums.TextColor3 = T.Muted
	lineNums.TextXAlignment = Enum.TextXAlignment.Right
	lineNums.TextYAlignment = Enum.TextYAlignment.Top
	lineNums.TextWrapped = false
	lineNums.RichText = false


	local codeScroll = Instance.new("ScrollingFrame", codeArea)
	codeScroll.Position = UDim2.fromOffset(44, 0)
	codeScroll.Size = UDim2.new(1, -44, 1, 0)
	codeScroll.BackgroundTransparency = 1
	codeScroll.BorderSizePixel = 0
	codeScroll.ScrollBarThickness = 4
	codeScroll.ScrollBarImageColor3 = T.Accent
	codeScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
	codeScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y

	local codeLabel = Instance.new("TextLabel", codeScroll)
	codeLabel.Size = UDim2.new(1, -8, 0, 0)
	codeLabel.AutomaticSize = Enum.AutomaticSize.Y
	codeLabel.BackgroundTransparency = 1
	codeLabel.Font = Enum.Font.Code
	codeLabel.TextSize = 13
	codeLabel.TextColor3 = T.Text
	codeLabel.TextXAlignment = Enum.TextXAlignment.Left
	codeLabel.TextYAlignment = Enum.TextYAlignment.Top
	codeLabel.TextWrapped = false
	codeLabel.RichText = true
	codeLabel.Position = UDim2.fromOffset(4, 4)


	codeScroll:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
		lineNums.Position = UDim2.new(0, 0, 0, 4 - codeScroll.CanvasPosition.Y)
	end)

	
	local KEYWORDS = {
		["and"]=true,["break"]=true,["do"]=true,["else"]=true,["elseif"]=true,
		["end"]=true,["false"]=true,["for"]=true,["function"]=true,["if"]=true,
		["in"]=true,["local"]=true,["nil"]=true,["not"]=true,["or"]=true,
		["repeat"]=true,["return"]=true,["then"]=true,["true"]=true,["until"]=true,
		["while"]=true,["continue"]=true,["self"]=true,
	}
	local BUILTINS = {
		["game"]=true,["workspace"]=true,["script"]=true,["print"]=true,["warn"]=true,
		["error"]=true,["pcall"]=true,["xpcall"]=true,["type"]=true,["typeof"]=true,
		["tostring"]=true,["tonumber"]=true,["pairs"]=true,["ipairs"]=true,
		["next"]=true,["select"]=true,["unpack"]=true,["table"]=true,["string"]=true,
		["math"]=true,["os"]=true,["require"]=true,["wait"]=true,["spawn"]=true,
		["delay"]=true,["tick"]=true,["Instance"]=true,["Vector3"]=true,["Color3"]=true,
		["CFrame"]=true,["UDim2"]=true,["UDim"]=true,["Vector2"]=true,
		["Enum"]=true,["TweenInfo"]=true,["BrickColor"]=true,
	}

	local function escape(s)
		return s:gsub("&","&amp;"):gsub("<","&lt;"):gsub(">","&gt;")
	end

	local function colorize(code)

		local lines = {}
		local kwColor    = "#"..T.SyntaxKw:ToHex()
		local strColor   = "#"..T.SyntaxStr:ToHex()
		local cmtColor   = "#"..T.SyntaxCmt:ToHex()
		local numColor   = "#"..T.SyntaxNum:ToHex()
		local builtColor = "#"..T.SyntaxBuilt:ToHex()
		local fnColor    = "#"..T.SyntaxFn:ToHex()
		local opColor    = "#"..T.SyntaxOp:ToHex()
		local textColor  = "#"..T.Text:ToHex()

		for rawLine in (code.."\n"):gmatch("([^\n]*)\n") do
			local result = ""
			local i = 1
			local len = #rawLine


			local stripped = rawLine:match("^%s*(.*)")
			if stripped:sub(1,2) == "--" then
				result = '<font color="'..cmtColor..'">'..escape(rawLine)..'</font>'
				lines[#lines+1] = result
			else

			while i <= len do
				local c = rawLine:sub(i,i)


				if c == '"' or c == "'" then
					local endPos = rawLine:find(c, i+1, true) or len
					local strContent = rawLine:sub(i, endPos)
					result = result..'<font color="'..strColor..'">'..escape(strContent)..'</font>'
					i = endPos + 1


				elseif c:match("%d") or (c == "." and rawLine:sub(i+1,i+1):match("%d")) then
					local numEnd = rawLine:find("[^%d%.xXeEaAbBcCdDfF_]", i) or (len+1)
					local numStr = rawLine:sub(i, numEnd-1)
					result = result..'<font color="'..numColor..'">'..escape(numStr)..'</font>'
					i = numEnd

				elseif c:match("[%a_]") then
					local wordEnd = rawLine:find("[^%w_]", i) or (len+1)
					local word = rawLine:sub(i, wordEnd-1)
					if KEYWORDS[word] then
						result = result..'<font color="'..kwColor..'">'..escape(word)..'</font>'
					elseif BUILTINS[word] then
						result = result..'<font color="'..builtColor..'">'..escape(word)..'</font>'
					else

						local after = rawLine:sub(wordEnd):match("^%s*%(")
						if after then
							result = result..'<font color="'..fnColor..'">'..escape(word)..'</font>'
						else
							result = result..'<font color="'..textColor..'">'..escape(word)..'</font>'
						end
					end
					i = wordEnd


				elseif c:match("[%+%-%*%/%=%!%&%|%^%~%<%>%%%#]") then
					result = result..'<font color="'..opColor..'">'..escape(c)..'</font>'
					i = i + 1


				else
					result = result..escape(c)
					i = i + 1
				end
			end -- while
			lines[#lines+1] = result == "" and " " or result
			end -- else
		end -- for rawLine

		return table.concat(lines, "\n")
	end

	local currentSource = ""
	local currentScriptObj = nil
	local scriptCon = nil

	function ScriptViewer.View(scriptObj)
		if not scriptObj then return end
		if scriptCon then scriptCon:Disconnect() scriptCon = nil end

		currentScriptObj = scriptObj
		scriptName.Text = tostring(scriptObj)
		win:SetTitle("Script Viewer — "..tostring(scriptObj))

		local src = "-- could not read source"
		if env and env.decompile then
			local ok, result = pcall(env.decompile, scriptObj)
			if ok and result and #result > 0 then src = result end
		end
		if src == "-- could not read source" then
			local ok, result = pcall(function() return scriptObj.Source end)
			if ok and result then src = result end
		end

		currentSource = src


		local colored = colorize(src)
		codeLabel.Text = colored

		local numLines = select(2, src:gsub("\n", "\n")) + 1
		local numStr = ""
		for i = 1, numLines do
			numStr = numStr..(i < numLines and (i.."\n") or tostring(i))
		end
		lineNums.Text = numStr

		if win.Gui.Enabled == false then
			win:Show()
		end


		scriptCon = scriptObj.AncestryChanged:Connect(function()
			if not scriptObj.Parent then
				codeLabel.Text = "-- Script removed from game"
				lineNums.Text = "1"
				if scriptCon then scriptCon:Disconnect() scriptCon = nil end
			end
		end)
	end

	copyBtn.MouseButton1Click:Connect(function()
		if currentSource == "" then return end
		if env and env.setclipboard then env.setclipboard(currentSource)
		elseif env and env.toclipboard then env.toclipboard(currentSource) end
	end)

	saveBtn.MouseButton1Click:Connect(function()
		if currentSource == "" or not currentScriptObj then return end
		if env and env.writefile then
			local name = tostring(currentScriptObj):gsub("[^%w_%-]","_")..".lua"
			pcall(env.writefile, name, currentSource)
		end
	end)

	return win
end


local _initialized = false
local _guiParent

function KDex.Init(KraviXWindow)
	if _initialized then return end
	_initialized = true


	local sg = KraviXWindow and KraviXWindow._ScreenGui
	if sg then
		_guiParent = sg.Parent  -- CoreGui ou gethui()
	else
		_guiParent = Instance.new("ScreenGui")
		_guiParent.Name = "KDexHolder"
		_guiParent.ResetOnSpawn = false
		if syn and syn.protect_gui then
			syn.protect_gui(_guiParent)
			_guiParent.Parent = CoreGui
		elseif gethui then
			_guiParent.Parent = gethui()
		else
			_guiParent.Parent = CoreGui
		end
	end


	env = {}
	local function tryGet(name)
		if _G[name] then return _G[name] end
		if getgenv and getgenv()[name] then return getgenv()[name] end
		return nil
	end
	for _, name in ipairs({"decompile","setclipboard","toclipboard","writefile","readfile","protectgui"}) do
		env[name] = tryGet(name)
	end
	if syn then
		if syn.decompile   then env.decompile   = syn.decompile end
		if syn.protect_gui then env.protectgui  = syn.protect_gui end
	end


	Explorer.Init(_guiParent)
	Properties.Init(_guiParent)
	ScriptViewer.Init(_guiParent)


	Explorer.SelectionChanged:Connect(function(node)
		Properties.ShowObject(node and node.Obj or nil)
		if not Properties.Window.Open then
			Properties.Window:Show()
		end
	end)


	_G.__KDexScriptViewer = ScriptViewer


	Explorer.Window.Main.Position = UDim2.fromOffset(50, 80)
	Properties.Window.Main.Position = UDim2.fromOffset(340, 80)
	ScriptViewer.Window.Main.Position = UDim2.fromOffset(50, 80)


	if KraviXWindow and KraviXWindow._ScreenGui then
		KraviXWindow._ScreenGui:GetPropertyChangedSignal("Enabled"):Connect(function()
			if not KraviXWindow._ScreenGui.Enabled then
				Explorer.Window:Hide()
				Properties.Window:Hide()
				ScriptViewer.Window:Hide()
			end
		end)
	end

	print("[KraviXDex] Iniciado — Explorer, Properties e ScriptViewer prontos.")
end


function KDex.Toggle()
	if not _initialized then
		warn("[KDex] Chame KDex.Init(Window) primeiro.")
		return
	end
	if Explorer.Window.Open then
		Explorer.Window:Hide()
		Properties.Window:Hide()
	else
		Explorer.Window:Show()
		Properties.Window:Show()
	end
end

function KDex.ToggleScriptViewer()
	if ScriptViewer.Window then
		ScriptViewer.Window:Toggle()
	end
end

return KDex
