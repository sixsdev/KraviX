	function Properties.ShowObject(obj)
		scroll:ClearAllChildren()
		local newList = Instance.new("UIListLayout", scroll)
		newList.SortOrder = Enum.SortOrder.LayoutOrder
		newList.Padding = UDim.new(0, 1)

		if not obj then
			local noSel = lbl(scroll, "Select an object in the Explorer", 12, Enum.Font.Gotham, T.Muted, Enum.TextXAlignment.Center)
			noSel.Size = UDim2.new(1, 0, 0, 40)
			noSel.Position = UDim2.fromOffset(0, 20)
			return
		end


		local rowIndex = 0


		makeCategoryHeader("Instance", rowIndex)
		rowIndex += 1

		local props = {
			{"Name",       tostring(obj),           false},
			{"ClassName",  obj.ClassName,            true},
			{"Parent",     obj.Parent and tostring(obj.Parent) or "nil", true},
		}


		local ok, extraProps = pcall(function()
			local result = {}

			local function tryGet(propName)
				local ok2, val = pcall(function() return obj[propName] end)
				if ok2 and val ~= nil then
					result[#result+1] = {propName, tostring(val), false}
				end
			end
			local commonProps = {
				"Transparency","Reflectance","Material","BrickColor","Color","Size",
				"Position","Rotation","CFrame","Anchored","CanCollide","Locked",
				"Visible","Text","Font","TextSize","TextColor3","BackgroundColor3",
				"BackgroundTransparency","ZIndex","Enabled","Value","Speed",
				"WalkSpeed","JumpPower","Health","MaxHealth",
			}
			for _, p in ipairs(commonProps) do tryGet(p) end
			return result
		end)

		for _, prop in ipairs(props) do
			makePropRow(prop[1], prop[2], prop[3], rowIndex)
			rowIndex += 1
		end

		if ok and extraProps then
			if #extraProps > 0 then
				makeCategoryHeader("Properties", rowIndex)
				rowIndex += 1
			end
			for _, prop in ipairs(extraProps) do
				makePropRow(prop[1], prop[2], prop[3], rowIndex)
				rowIndex += 1
			end
		end


		local okA, attrs = pcall(function() return obj:GetAttributes() end)
		if okA and next(attrs) then
			makeCategoryHeader("Attributes", rowIndex)
			rowIndex += 1
			for k, v in pairs(attrs) do
				makePropRow(tostring(k), tostring(v), false, rowIndex)
				rowIndex += 1
			end
		end


		local function onPropChange(propName, valBox, obj2)
			valBox.FocusLost:Connect(function(enter)
				if enter then
					pcall(function() obj2[propName] = valBox.Text end)
				end
			end)
		end


		task.defer(function()
			local nameBoxes = {}
			for _, child in ipairs(scroll:GetChildren()) do
				if child:IsA("Frame") and child.LayoutOrder >= 1 then
					local tb = child:FindFirstChildOfClass("TextBox")
					local lbl2 = child:FindFirstChild("__name")
					if tb and lbl2 then
						onPropChange(lbl2.Text, tb, obj)
					end
				end
			end
		end)
	end

	return win
end


local ScriptViewer = {}

function ScriptViewer.Init(guiParent)
	local win = makeWindow("Script Viewer", 600, 420, guiParent)
	ScriptViewer.Window = win


	local toolbar = Instance.new("Frame", win.Content)
