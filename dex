	searchBox.Position = UDim2.new(0, 4, 0, 0)
	searchBox.BackgroundTransparency = 1
	searchBox.Font = Enum.Font.Gotham
	searchBox.TextSize = 12
	searchBox.TextColor3 = T.Text
	searchBox.PlaceholderColor3 = T.Muted
	searchBox.PlaceholderText = "Search..."
	searchBox.ClearTextOnFocus = false
	searchBox.Text = ""
	searchBox.TextXAlignment = Enum.TextXAlignment.Left


	local tree = Instance.new("ScrollingFrame", win.Content)
	tree.Name = "Tree"
	tree.Position = UDim2.new(0, 0, 0, 30)
	tree.Size = UDim2.new(1, -8, 1, -34)
	tree.BackgroundTransparency = 1
	tree.BorderSizePixel = 0
	tree.ScrollBarThickness = 4
	tree.ScrollBarImageColor3 = T.Accent
	tree.CanvasSize = UDim2.new(0, 0, 0, 0)
	tree.AutomaticCanvasSize = Enum.AutomaticSize.Y

	local treeList = Instance.new("UIListLayout", tree)
	treeList.SortOrder = Enum.SortOrder.LayoutOrder
	treeList.Padding = UDim.new(0, 0)


	local scrollRight = Instance.new("Frame", win.Content)
	scrollRight.Size = UDim2.new(0, 8, 1, -34)
	scrollRight.Position = UDim2.new(1, -8, 0, 30)
	scrollRight.BackgroundColor3 = T.Bg2
	scrollRight.BorderSizePixel = 0
	corner(scrollRight, 4)


	local nodes = {}
	local expanded = setmetatable({}, {__mode="k"})
	local selection = nil
	local SelectionChanged = newSignal()
	Explorer.SelectionChanged = SelectionChanged

	local function getPath(obj)
		local path = ""
		local cur = obj
		while cur do
			if cur == game then path = "game"..path break end
			local name = tostring(cur)
			if name:match("^[%a_][%w_]*$") then
				path = "."..name..path
			else
				path = '["'..name..'"]'..path
			end
			cur = cur.Parent
		end
		return path
	end

	local function makeEntry(node, depth)
		local obj = node.Obj
		local entry = Instance.new("TextButton")
		entry.Name = "Entry"
		entry.Size = UDim2.new(1, 0, 0, 20)
		entry.BackgroundTransparency = 1
		entry.Text = ""
		entry.AutoButtonColor = false
		entry.BorderSizePixel = 0

		local icon = Instance.new("ImageLabel", entry)
		icon.Size = UDim2.new(0, 16, 0, 16)
		icon.Position = UDim2.new(0, depth*16 + 18, 0, 2)
		icon.BackgroundTransparency = 1
		icon.Image = "rbxasset://textures/ClassImages.png"
		local rmd_idx = 0
		local ok2, rmdEntry = pcall(function()

			return rmd_idx
		end)
		icon.ImageRectSize = Vector2.new(16,16)
		icon.ImageRectOffset = Vector2.new(0,0)


		local nameLbl = Instance.new("TextLabel", entry)
		nameLbl.Size = UDim2.new(1, -(depth*16+36), 1, 0)
		nameLbl.Position = UDim2.new(0, depth*16+36, 0, 0)
		nameLbl.BackgroundTransparency = 1
		nameLbl.Font = Enum.Font.Gotham
		nameLbl.TextSize = 12
		nameLbl.TextColor3 = T.Text
		nameLbl.TextXAlignment = Enum.TextXAlignment.Left
		nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
		nameLbl.Text = tostring(obj)


		local arrow = Instance.new("TextButton", entry)
		arrow.Size = UDim2.new(0, 16, 0, 16)
		arrow.Position = UDim2.new(0, depth*16 + 2, 0, 2)
		arrow.BackgroundTransparency = 1
		arrow.Font = Enum.Font.GothamBold
		arrow.TextSize = 9
		arrow.TextColor3 = T.Sub
		arrow.AutoButtonColor = false
		arrow.Text = (#node > 0) and (expanded[node] and "▼" or "▶") or ""

		entry.MouseButton1Click:Connect(function()
			selection = node
			SelectionChanged:Fire(node)
			Explorer.Refresh()
		end)

		entry.MouseButton2Click:Connect(function()
			selection = node
			SelectionChanged:Fire(node)
			Explorer.ShowContext(obj)
		end)

		arrow.MouseButton1Click:Connect(function()
			if #node == 0 then return end
			expanded[node] = not expanded[node]
			Explorer.Refresh()
		end)

		return entry
	end

	local searchText = ""
	local viewList = {}

	local function buildView(root, depth)
		local lower = string.lower
		local find = string.find
		for i = 1, #root do
			local node = root[i]
			if not node.Del then
				local name = tostring(node.Obj)
				if searchText == "" or find(lower(name), lower(searchText), 1, true) then
					viewList[#viewList+1] = {node=node, depth=depth}
				end
				if expanded[node] then
					buildView(node, depth+1)
				end
			end
		end
	end

	function Explorer.Refresh()
		tree:ClearAllChildren()
		local listLayout = Instance.new("UIListLayout", tree)
		listLayout.SortOrder = Enum.SortOrder.LayoutOrder
		listLayout.Padding = UDim.new(0,0)

		viewList = {}
		if nodes[game] then buildView(nodes[game], 0) end

		for i, item in ipairs(viewList) do
			local entry = makeEntry(item.node, item.depth)
			entry.LayoutOrder = i
			if item.node == selection then
				entry.BackgroundColor3 = T.Selection
				entry.BackgroundTransparency = 0
				entry.EntryName = entry -- alias
			end
			entry.Parent = tree
		end
	end


	local function populate(obj, parent)
		if not pcall(function() return obj.ClassName end) then return end
		local node = {Obj=obj, Parent=parent}
		nodes[obj] = node
		if parent then parent[#parent+1] = node end
		local ok, children = pcall(function() return obj:GetChildren() end)
		if ok then
			for _, child in ipairs(children) do
				populate(child, node)
			end
		end
		return node
	end

	local gameNode = populate(game, nil)
	expanded[gameNode] = true


	game.DescendantAdded:Connect(function(obj)
		if nodes[obj] then return end
		local ok, par = pcall(function() return obj.Parent end)
		if not ok then return end
		local parNode = nodes[par]
		if not parNode then return end
		local node = {Obj=obj, Parent=parNode}
		nodes[obj] = node
		parNode[#parNode+1] = node
		if Explorer.Window.Open then Explorer.Refresh() end
	end)

	game.DescendantRemoving:Connect(function(obj)
		local node = nodes[obj]
		if not node then return end
		local par = node.Parent
		if par then
			for i, v in ipairs(par) do
				if v == node then table.remove(par, i) break end
			end
		end
		nodes[obj] = nil
		if Explorer.Window.Open then Explorer.Refresh() end
	end)


	function Explorer.ShowContext(obj)
		local existingCtx = guiParent:FindFirstChild("KDex_Ctx")
		if existingCtx then existingCtx:Destroy() end

		local ctxGui = Instance.new("ScreenGui", guiParent)
		ctxGui.Name = "KDex_Ctx"
		ctxGui.DisplayOrder = 500
		ctxGui.ZIndexBehavior = Enum.ZIndexBehavior.Global

		local mp = UIS:GetMouseLocation()
		local ctx = Instance.new("Frame", ctxGui)
		ctx.BackgroundColor3 = T.Bg2
		ctx.BorderSizePixel = 0
		ctx.Position = UDim2.fromOffset(mp.X, mp.Y)
		ctx.Size = UDim2.new(0, 140, 0, 0)
		ctx.AutomaticSize = Enum.AutomaticSize.Y
		corner(ctx, 6)
		stroke(ctx, T.Border2, 1)

		local list = Instance.new("UIListLayout", ctx)
		list.SortOrder = Enum.SortOrder.LayoutOrder
		list.Padding = UDim.new(0, 1)

		local items = {
			{"Copy Path", function()
				if env and env.setclipboard then env.setclipboard(getPath(obj)) end
				ctxGui:Destroy()
			end},
			{"Select Children", function()
				ctxGui:Destroy()
			end},
			{"View Script", function()
				local isa = game.IsA
				if pcall(isa, obj, "LuaSourceContainer") and obj:IsA("LuaSourceContainer") then
					ScriptViewer.View(obj)
				end
				ctxGui:Destroy()
			end},
			{"Delete", function()
				pcall(function() obj:Destroy() end)
				ctxGui:Destroy()
			end},
		}

		for i, item in ipairs(items) do
			local b = Instance.new("TextButton", ctx)
			b.Size = UDim2.new(1, 0, 0, 22)
			b.BackgroundColor3 = T.Bg2
			b.BorderSizePixel = 0
			b.Font = Enum.Font.Gotham
			b.TextSize = 12
			b.TextColor3 = T.Text
			b.TextXAlignment = Enum.TextXAlignment.Left
			b.AutoButtonColor = false
			b.LayoutOrder = i
			b.Text = ""
			corner(b, 0)

			local nameLbl = lbl(b, item[1], 12, Enum.Font.Gotham, T.Text, Enum.TextXAlignment.Left)
			nameLbl.Size = UDim2.new(1, 0, 1, 0)
			nameLbl.Position = UDim2.fromOffset(8, 0)
			nameLbl.ZIndex = 2

			b.MouseEnter:Connect(function() b.BackgroundColor3 = T.Selection end)
			b.MouseLeave:Connect(function() b.BackgroundColor3 = T.Bg2 end)
			b.MouseButton1Click:Connect(item[2])
		end


		local closeCon
		closeCon = UIS.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				local mp2 = UIS:GetMouseLocation()
				local cp = ctx.AbsolutePosition
				local cs = ctx.AbsoluteSize
				if not (mp2.X>=cp.X and mp2.X<=cp.X+cs.X and mp2.Y>=cp.Y and mp2.Y<=cp.Y+cs.Y) then
					closeCon:Disconnect()
					ctxGui:Destroy()
				end
			end
		end)
	end

	searchBox:GetPropertyChangedSignal("Text"):Connect(function()
		searchText = searchBox.Text
		Explorer.Refresh()
	end)

	win.OnActivate = newSignal()
	win.OnDeactivate = newSignal()

	Explorer.Refresh()
	Explorer.GetSelected = function() return selection end
	Explorer.Selection = {
		List = {},
		Changed = SelectionChanged,
	}
	SelectionChanged:Connect(function(node)
		Explorer.Selection.List = node and {node} or {}
	end)

	return win
end


