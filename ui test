local function PlaySound(id)
    local s = Instance.new("Sound")
    s.SoundId = id; s.Volume = 0.5; s.Parent = SoundService; s:Play()
    game:GetService("Debris"):AddItem(s, 5)
end
local function Tween(obj, props, t, style, dir)
    return TweenService:Create(obj,
        TweenInfo.new(t or 0.15, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out),
        props)
end
local function protect(gui)
    for _, v in ipairs(CoreGui:GetChildren()) do
        if v.Name == gui.Name then v:Destroy() end
    end
    if gethui then
        for _, v in ipairs(gethui():GetChildren()) do
            if v.Name == gui.Name then v:Destroy() end
        end
    end
    if syn and syn.protect_gui then syn.protect_gui(gui); gui.Parent = CoreGui
    elseif gethui then gui.Parent = gethui()
    else gui.Parent = CoreGui end
end
local function mkCorner(p, r) local c=Instance.new("UICorner"); c.CornerRadius=UDim.new(0,r or 4); c.Parent=p; return c end
local function mkStroke(p, col, thick, trans) local s=Instance.new("UIStroke"); s.Color=col or Color3.fromRGB(40,40,40); s.Thickness=thick or 1; s.Transparency=trans or 0; s.Parent=p; return s end
local function mkPad(p, t, b, l, r) local pad=Instance.new("UIPadding"); pad.PaddingTop=UDim.new(0,t or 0); pad.PaddingBottom=UDim.new(0,b or 0); pad.PaddingLeft=UDim.new(0,l or 0); pad.PaddingRight=UDim.new(0,r or 0); pad.Parent=p; return pad end

