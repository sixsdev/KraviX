                function Section:AddMouseKeybind(cfg)
                    cfg=cfg or {}
                    local cur
                    if type(cfg.Default)=="table" and cfg.Default.type then cur=cfg.Default
                    else cur={type="key",value=cfg.Default or Enum.KeyCode.E} end
                    local listen=false
                    local _ignoreNext=false  -- FIX v4.6: ignora o próprio clique que ativou o listen
                    local callback=cfg.Callback or function() end
                    local function bindLabel(b)
                        if not b then return "None" end
                        if b.type=="mouse" then return MOUSE_NAMES[b.value] or "Mouse?" end
                        return b.value and b.value.Name or "?"
                    end
                    local Row=Instance.new("Frame")
                    Row.Size=UDim2.new(1,0,0,26); Row.BackgroundTransparency=1; Row.ZIndex=13
                    local Lbl=Instance.new("TextLabel",Row)
                    Lbl.Size=UDim2.new(0.65,0,1,0); Lbl.BackgroundTransparency=1
                    Lbl.Text=cfg.Name or "Keybind"; Lbl.TextColor3=C.Sub
                    Lbl.TextSize=11; Lbl.Font=Enum.Font.Gotham
                    Lbl.TextXAlignment=Enum.TextXAlignment.Left; Lbl.ZIndex=14
                    local KB=Instance.new("TextButton",Row)
                    KB.Size=UDim2.new(0,46,0,20); KB.AnchorPoint=Vector2.new(1,0.5)
                    KB.Position=UDim2.new(1,0,0.5,0)
                    KB.BackgroundColor3=Color3.fromRGB(20,20,20); KB.Text=bindLabel(cur)
                    KB.TextColor3=C.Sub; KB.TextSize=9; KB.Font=Enum.Font.Code
                    KB.AutoButtonColor=false; KB.ZIndex=14
                    mkCorner(KB,4); mkStroke(KB,C.BorderBt,1,0)
                    local Bind={Value=cur}
                    -- FIX v4.6: usa MouseButton1Click no botão para evitar capturar o próprio clique
                    KB.MouseButton1Click:Connect(function()
                        if listen then return end
                        listen=true
                        _ignoreNext=true  -- próximo MB1 é o release do clique atual, ignorar
                        KB.Text="..."; KB.TextColor3=C.Accent
                    end)
                    UserInputService.InputBegan:Connect(function(inp, processed)
                        if not listen then return end
                        -- FIX v4.6: não bloqueia por 'processed' pois aimbot bind (MB2) não é processed
                        -- mas ignora inputs da UI (TextBox focado, etc)
                        if processed and inp.UserInputType==Enum.UserInputType.Keyboard then return end

                        -- ignora o MB1 imediato após clicar no botão
                        if _ignoreNext and inp.UserInputType==Enum.UserInputType.MouseButton1 then
                            _ignoreNext=false; return
                        end
                        _ignoreNext=false

                        -- Escape cancela
                        if inp.UserInputType==Enum.UserInputType.Keyboard and inp.KeyCode==Enum.KeyCode.Escape then
                            listen=false; KB.Text=bindLabel(cur); KB.TextColor3=C.Sub; return
                        end

                        local isMouse=false
                        for _,mt in ipairs(MOUSE_TYPES) do
                            if inp.UserInputType==mt then
                                isMouse=true; cur={type="mouse",value=inp.UserInputType}; break
                            end
                        end
                        if not isMouse then
                            if inp.UserInputType==Enum.UserInputType.Keyboard then
                                cur={type="key",value=inp.KeyCode}
                            else return end  -- ignora outros tipos (gamepad, etc)
                        end
                        listen=false; Bind.Value=cur
                        KB.Text=bindLabel(cur); KB.TextColor3=C.Sub; callback(cur)
                    end)
                    function Bind:Set(b)
                        if type(b)=="table" and b.type then cur=b else cur={type="key",value=b} end
                        Bind.Value=cur; KB.Text=bindLabel(cur); KB.TextColor3=C.Sub; callback(cur)
                    end
                    AddItem(Row); return Bind
                end

                function Section:AddColorPicker(cfg)
