                Sel.AutoButtonColor=false; Sel.ZIndex=14
                makeCorner(Sel,4); makeStroke(Sel,C.Border,1,0)

                local Dropdown={Value=selected}

                local DFrame=Instance.new("Frame",ScreenGui)
                DFrame.Size=UDim2.new(0,140,0,#options*22+8)
                DFrame.BackgroundColor3=C.Bg4; DFrame.BorderSizePixel=0
                DFrame.Visible=false; DFrame.ZIndex=200
                makeCorner(DFrame,5); makeStroke(DFrame,C.Accent,1,0.5)
                local DL=Instance.new("UIListLayout",DFrame)
                DL.Padding=UDim.new(0,2); DL.SortOrder=Enum.SortOrder.LayoutOrder
                makePadding(DFrame,4,4,4,4)

                local _dropHovered=false
                DFrame.MouseEnter:Connect(function() _dropHovered=true end)
                DFrame.MouseLeave:Connect(function() _dropHovered=false end)

                local optBtns={}
                for _,opt in ipairs(options) do
                    local OBtn=Instance.new("TextButton",DFrame)
                    OBtn.Size=UDim2.new(1,0,0,20); OBtn.BackgroundColor3=C.Bg5
                    OBtn.BackgroundTransparency=opt==selected and 0.4 or 1
                    OBtn.Text=opt; OBtn.TextColor3=opt==selected and C.Accent or C.Sub
                    OBtn.TextSize=10; OBtn.Font=Enum.Font.Gotham
                    OBtn.AutoButtonColor=false; OBtn.ZIndex=201
                    makeCorner(OBtn,3)
                    optBtns[opt]=OBtn
                    OBtn.MouseEnter:Connect(function()
                        _dropHovered=true
                        if OBtn.Text~=Dropdown.Value then Tween(OBtn,{BackgroundTransparency=0.5,TextColor3=C.Text},0.08):Play() end
                    end)
                    OBtn.MouseLeave:Connect(function()
                        if OBtn.Text~=Dropdown.Value then Tween(OBtn,{BackgroundTransparency=1,TextColor3=C.Sub},0.08):Play() end
                    end)
                    OBtn.MouseButton1Click:Connect(function()
                        local prev=Dropdown.Value
                        Dropdown.Value=opt; Sel.Text=opt.."  ▾"
                        for o,b in pairs(optBtns) do
                            b.TextColor3=o==opt and C.Accent or C.Sub
                            b.BackgroundTransparency=o==opt and 0.4 or 1
                        end
                        opened=false; DFrame.Visible=false; _dropHovered=false
                        if prev~=opt then callback(opt) end
                    end)
                end

                Sel.MouseButton1Click:Connect(function()
                    opened=not opened; DFrame.Visible=opened
                    if opened then
                        local abs=Sel.AbsolutePosition
                        local vpH=ScreenGui.AbsoluteSize.Y
                        local fH=#options*22+8
                        if abs.Y+Sel.AbsoluteSize.Y+fH+4>vpH then
                            DFrame.Position=UDim2.fromOffset(abs.X,abs.Y-fH-4)
                        else
                            DFrame.Position=UDim2.fromOffset(abs.X,abs.Y+Sel.AbsoluteSize.Y+3)
                        end
                    end
                end)
                UserInputService.InputBegan:Connect(function(inp)
                    if inp.UserInputType==Enum.UserInputType.MouseButton1 then
                        if not _dropHovered then opened=false; DFrame.Visible=false end
                    end
                end)
                Main:GetPropertyChangedSignal("Visible"):Connect(function()
                    opened=false; DFrame.Visible=false; _dropHovered=false
                end)
                function Dropdown:Set(v)
                    if table.find(options,v) then
                        Dropdown.Value=v; Sel.Text=v.."  ▾"
                        for o,b in pairs(optBtns) do
                            b.TextColor3=o==v and C.Accent or C.Sub
                            b.BackgroundTransparency=o==v and 0.4 or 1
                        end
                        callback(v)
                    end
                end
                if selected then task.defer(function() callback(selected) end) end
                Dropdown._Row=Row; Dropdown._DFrame=DFrame
                AddItem(Row); return Dropdown
            end

