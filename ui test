    local TabBar=Instance.new("ScrollingFrame",Main)
    TabBar.Size=UDim2.new(1,0,0,36)
    TabBar.Position=UDim2.new(0,0,0,35)
    TabBar.BackgroundColor3=C.Bg2
    TabBar.BackgroundTransparency=0
    TabBar.BorderSizePixel=0; TabBar.ZIndex=11
    TabBar.ScrollBarThickness=0; TabBar.ScrollingDirection=Enum.ScrollingDirection.X
    TabBar.AutomaticCanvasSize=Enum.AutomaticSize.X
    TabBar.CanvasSize=UDim2.new(0,0,0,0); TabBar.ElasticBehavior=Enum.ElasticBehavior.Never
    local TabList=Instance.new("UIListLayout",TabBar)
    TabList.FillDirection=Enum.FillDirection.Horizontal
    TabList.SortOrder=Enum.SortOrder.LayoutOrder
    TabList.HorizontalAlignment=Enum.HorizontalAlignment.Left
    TabList.VerticalAlignment=Enum.VerticalAlignment.Center
    TabList.Padding=UDim.new(0,0)
    makePadding(TabBar,0,0,10,10)

    -- separador abaixo das tabs principais
    local TabSep=Instance.new("Frame",Main)
    TabSep.Size=UDim2.new(1,0,0,1); TabSep.Position=UDim2.new(0,0,0,71)
    TabSep.BackgroundColor3=C.Border; TabSep.BorderSizePixel=0; TabSep.ZIndex=11

    -- ── ÁREA DE CONTEÚDO ──
    local ContentFrame=Instance.new("Frame",Main)
    ContentFrame.Size=UDim2.new(1,0,1,-72)
    ContentFrame.Position=UDim2.new(0,0,0,72)
    ContentFrame.BackgroundTransparency=1; ContentFrame.BorderSizePixel=0
    ContentFrame.ZIndex=10; ContentFrame.ClipsDescendants=true

    -- ══════════════════════════════════════
    --  SHOW / HIDE
    -- ══════════════════════════════════════
    local function HideWindow()
        if not Main.Visible then return end
        Main.ClipsDescendants=true
        Tween(TopBar,  {BackgroundTransparency=1},0.1):Play()
        Tween(TabBar,  {BackgroundTransparency=1},0.1):Play()
        task.wait(0.06)
        Tween(Main,{Size=UDim2.new(0,WIN_W,0,0),Position=UDim2.new(0.5,-WIN_W/2,0.5,0),BackgroundTransparency=0.7},0.2,Enum.EasingStyle.Quint,Enum.EasingDirection.In):Play()
        Tween(Backdrop,{BackgroundTransparency=1},0.18):Play()
        task.wait(0.22)
        Main.Visible=false; Backdrop.Visible=false
        Main.Size=UDim2.new(0,WIN_W,0,WIN_H)
        Main.Position=UDim2.new(0.5,-WIN_W/2,0.5,-WIN_H/2)
        Main.BackgroundTransparency=0
        TopBar.BackgroundTransparency=0; TabBar.BackgroundTransparency=0
        Backdrop.BackgroundTransparency=0.6; Main.ClipsDescendants=false
    end

    local function ShowWindow()
        if Main.Visible then return end
        Main.Visible=true; Backdrop.Visible=true
        Main.ClipsDescendants=true
        Main.Size=UDim2.new(0,WIN_W*0.88,0,WIN_H*0.88)
        Main.Position=UDim2.new(0.5,-(WIN_W*0.88)/2,0.5,-(WIN_H*0.88)/2+22)
        Main.BackgroundTransparency=0.9
        TopBar.BackgroundTransparency=1; TabBar.BackgroundTransparency=1
        Backdrop.BackgroundTransparency=1
        Tween(Backdrop,{BackgroundTransparency=0.6},0.2,Enum.EasingStyle.Quad):Play()
        Tween(Main,{Size=UDim2.new(0,WIN_W,0,WIN_H),Position=UDim2.new(0.5,-WIN_W/2,0.5,-WIN_H/2),BackgroundTransparency=0},0.5,Enum.EasingStyle.Elastic,Enum.EasingDirection.Out):Play()
        task.delay(0.12,function() Tween(TopBar,{BackgroundTransparency=0},0.18):Play() end)
        task.delay(0.2,function() Tween(TabBar,{BackgroundTransparency=0},0.18):Play(); Main.ClipsDescendants=false end)
    end

    local function ToggleWindow()
        if Main.Visible then HideWindow() else ShowWindow() end
    end
    Window.HideWindow=HideWindow; Window.ShowWindow=ShowWindow; Window.ToggleWindow=ToggleWindow

    MakeDraggable(Main,TopBar)

    CreateLoader(ScreenGui,function()
        PlaySound(SOUND_OPEN); ShowWindow()
        CreateNotification("KraviX","Carregado com sucesso!",3,"success")
    end)

    -- ══════════════════════════════════════
    --  CRIAR TAB (nível 1 — barra principal)
    -- ══════════════════════════════════════
    function Window:CreateTab(name, icon)
        local Tab      = {}
        local tabIndex = #Window.Tabs + 1

        -- botão da tab — sem fundo, só texto; ativo = rosa + borda inferior
        local TabBtn=Instance.new("TextButton",TabBar)
        TabBtn.Size=UDim2.new(0,0,1,0); TabBtn.AutomaticSize=Enum.AutomaticSize.X
        TabBtn.BackgroundTransparency=1
        TabBtn.Text=(icon and icon.."  " or "")..name
        TabBtn.TextColor3=C.Muted; TabBtn.TextSize=12; TabBtn.Font=Enum.Font.Gotham
        TabBtn.AutoButtonColor=false; TabBtn.ZIndex=12; TabBtn.LayoutOrder=tabIndex
        local TBP=Instance.new("UIPadding",TabBtn)
        TBP.PaddingLeft=UDim.new(0,12); TBP.PaddingRight=UDim.new(0,12)
        TBP.PaddingTop=UDim.new(0,0); TBP.PaddingBottom=UDim.new(0,0)

        -- indicador inferior (linha rosa quando ativa)
        local TabUnder=Instance.new("Frame",TabBtn)
        TabUnder.Size=UDim2.new(1,-24,0,2)
        TabUnder.AnchorPoint=Vector2.new(0.5,1)
        TabUnder.Position=UDim2.new(0.5,0,1,0)
        TabUnder.BackgroundColor3=C.Accent; TabUnder.BorderSizePixel=0
        TabUnder.BackgroundTransparency=1; TabUnder.ZIndex=13
        makeCorner(TabUnder,2)

        -- conteúdo desta tab
        local TabContent=Instance.new("Frame",ContentFrame)
        TabContent.Size=UDim2.new(1,0,1,0); TabContent.BackgroundTransparency=1
        TabContent.BorderSizePixel=0; TabContent.Visible=false; TabContent.ZIndex=11

        -- ── SUB TAB BAR (nível 2 — dentro do conteúdo, estilo Matcha) ──
        local SubTabBar=Instance.new("Frame",TabContent)
        SubTabBar.Size=UDim2.new(1,0,0,30)
        SubTabBar.BackgroundColor3=C.Bg2
        SubTabBar.BorderSizePixel=0; SubTabBar.ZIndex=12
        local SubList=Instance.new("UIListLayout",SubTabBar)
        SubList.FillDirection=Enum.FillDirection.Horizontal
        SubList.SortOrder=Enum.SortOrder.LayoutOrder
        SubList.VerticalAlignment=Enum.VerticalAlignment.Center
        SubList.Padding=UDim.new(0,0)
        makePadding(SubTabBar,0,0,10,10)

        local SubSep=Instance.new("Frame",TabContent)
        SubSep.Size=UDim2.new(1,0,0,1); SubSep.Position=UDim2.new(0,0,0,30)
        SubSep.BackgroundColor3=C.Border; SubSep.BorderSizePixel=0; SubSep.ZIndex=12

        -- área de conteúdo das sub tabs (abaixo da sub tab bar)
        local SubContent=Instance.new("Frame",TabContent)
        SubContent.Size=UDim2.new(1,0,1,-31)
        SubContent.Position=UDim2.new(0,0,0,31)
        SubContent.BackgroundTransparency=1; SubContent.BorderSizePixel=0
        SubContent.ZIndex=11; SubContent.ClipsDescendants=true

        table.insert(Window.Tabs,{Btn=TabBtn,Under=TabUnder,Container=TabContent,Index=tabIndex,SubTabs={},ActiveSub=0})
        local tabEntry=Window.Tabs[tabIndex]

        local FadeOverlay=Instance.new("Frame",TabContent)
        FadeOverlay.Size=UDim2.new(1,0,1,0); FadeOverlay.BackgroundColor3=C.Bg2
        FadeOverlay.BackgroundTransparency=1; FadeOverlay.BorderSizePixel=0; FadeOverlay.ZIndex=50

        local function SelectTab()
            activeTabIndex=tabIndex
            for _,t in ipairs(Window.Tabs) do
                local on=t.Index==activeTabIndex
                if not on then t.Container.Visible=false end
                Tween(t.Btn,{TextColor3=on and C.Text or C.Muted,},0.12):Play()
                t.Btn.Font = on and Enum.Font.GothamBold or Enum.Font.Gotham
                Tween(t.Under,{BackgroundTransparency=on and 0 or 1},0.12):Play()
            end
            TabContent.Visible=true
            FadeOverlay.BackgroundTransparency=0
            Tween(FadeOverlay,{BackgroundTransparency=1},0.16,Enum.EasingStyle.Quad):Play()
        end

        TabBtn.MouseButton1Click:Connect(SelectTab)
        TabBtn.MouseEnter:Connect(function()
            if tabIndex~=activeTabIndex then Tween(TabBtn,{TextColor3=C.Sub},0.1):Play() end
        end)
        TabBtn.MouseLeave:Connect(function()
            if tabIndex~=activeTabIndex then Tween(TabBtn,{TextColor3=C.Muted},0.1):Play() end
        end)
        if #Window.Tabs==1 then SelectTab() end

        -- ══════════════════════════════════════
        --  CRIAR SUB TAB (nível 2)
        -- ══════════════════════════════════════
        function Tab:AddSubTab(subName)
            local SubTab    = {}
            local subIndex  = #tabEntry.SubTabs + 1

            -- botão sub tab — texto simples, underline rosa quando ativa
            local SBtn=Instance.new("TextButton",SubTabBar)
            SBtn.Size=UDim2.new(0,0,1,0); SBtn.AutomaticSize=Enum.AutomaticSize.X
            SBtn.BackgroundTransparency=1
            SBtn.Text=subName
            SBtn.TextColor3=C.Muted; SBtn.TextSize=11; SBtn.Font=Enum.Font.Gotham
            SBtn.AutoButtonColor=false; SBtn.ZIndex=13; SBtn.LayoutOrder=subIndex
            local SP=Instance.new("UIPadding",SBtn)
            SP.PaddingLeft=UDim.new(0,10); SP.PaddingRight=UDim.new(0,10)

            local SUnder=Instance.new("Frame",SBtn)
            SUnder.Size=UDim2.new(1,-20,0,2); SUnder.AnchorPoint=Vector2.new(0.5,1)
            SUnder.Position=UDim2.new(0.5,0,1,0)
            SUnder.BackgroundColor3=C.Accent; SUnder.BorderSizePixel=0
            SUnder.BackgroundTransparency=1; SUnder.ZIndex=14
            makeCorner(SUnder,2)

            -- painel desta sub tab (duas colunas)
            local SubPanel=Instance.new("Frame",SubContent)
            SubPanel.Size=UDim2.new(1,0,1,0); SubPanel.BackgroundTransparency=1
            SubPanel.BorderSizePixel=0; SubPanel.Visible=false; SubPanel.ZIndex=12

            local function makeColumn(xScale,xOff)
                local s=Instance.new("ScrollingFrame",SubPanel)
                s.Size=UDim2.new(0.5,xOff,1,0)
                s.Position=UDim2.new(xScale,math.max(0,-xOff),0,0)
                s.BackgroundTransparency=1; s.BorderSizePixel=0
                s.ScrollBarThickness=2; s.ScrollBarImageColor3=C.Muted2
                s.CanvasSize=UDim2.new(0,0,0,0); s.ZIndex=12
                local l=Instance.new("UIListLayout",s)
                l.Padding=UDim.new(0,2); l.SortOrder=Enum.SortOrder.LayoutOrder
                l.HorizontalAlignment=Enum.HorizontalAlignment.Left
                makePadding(s,8,12,10,8)
                l:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                    s.CanvasSize=UDim2.new(0,0,0,l.AbsoluteContentSize.Y+16)
                end)
                return s
            end

            local LeftScroll=makeColumn(0,-1)
            local Div=Instance.new("Frame",SubPanel)
            Div.Size=UDim2.new(0,1,1,0); Div.Position=UDim2.new(0.5,0,0,0)
            Div.BackgroundColor3=C.Border; Div.BorderSizePixel=0; Div.ZIndex=12
            local RightScroll=makeColumn(0.5,-1)
            RightScroll.Position=UDim2.new(0.5,2,0,0)

            table.insert(tabEntry.SubTabs,{Btn=SBtn,Under=SUnder,Panel=SubPanel,Index=subIndex})

            local function SelectSub()
                tabEntry.ActiveSub=subIndex
                for _,st in ipairs(tabEntry.SubTabs) do
                    local on=st.Index==subIndex
                    if not on then st.Panel.Visible=false end
                    Tween(st.Btn,{TextColor3=on and C.Accent or C.Muted},0.1):Play()
                    st.Btn.Font=on and Enum.Font.GothamBold or Enum.Font.Gotham
                    Tween(st.Under,{BackgroundTransparency=on and 0 or 1},0.1):Play()
                end
                SubPanel.Visible=true
            end

            SBtn.MouseButton1Click:Connect(SelectSub)
            SBtn.MouseEnter:Connect(function()
                if subIndex~=tabEntry.ActiveSub then Tween(SBtn,{TextColor3=C.Sub},0.08):Play() end
            end)
            SBtn.MouseLeave:Connect(function()
                if subIndex~=tabEntry.ActiveSub then Tween(SBtn,{TextColor3=C.Muted},0.08):Play() end
            end)
            if #tabEntry.SubTabs==1 then SelectSub() end

            -- ══════════════════════════════════════
            --  ADICIONAR SEÇÃO
            -- ══════════════════════════════════════
            function SubTab:AddSection(sectionName, column)
                local Section={}
                local scroll=(column=="Right") and RightScroll or LeftScroll

                -- cabeçalho da seção — rosa bold uppercase
                local Hdr=Instance.new("TextLabel",scroll)
                Hdr.Size=UDim2.new(1,0,0,20); Hdr.BackgroundTransparency=1
                Hdr.Text=string.upper(sectionName or "")
                Hdr.TextColor3=C.Accent; Hdr.TextSize=9; Hdr.Font=Enum.Font.GothamBlack
                Hdr.TextXAlignment=Enum.TextXAlignment.Left; Hdr.ZIndex=13

                local function AddItem(item) item.Parent=scroll end

                -- ───── TOGGLE ─────
                function Section:AddToggle(cfg)
                    cfg=cfg or {}
                    local toggled=cfg.Default or false
                    local callback=cfg.Callback or function() end

                    local Row=Instance.new("Frame")
                    Row.Size=UDim2.new(1,0,0,24); Row.BackgroundTransparency=1; Row.ZIndex=13

                    -- checkbox quadrado simples (estilo Matcha)
                    local Box=Instance.new("Frame",Row)
                    Box.Size=UDim2.new(0,13,0,13); Box.Position=UDim2.new(0,0,0.5,-6)
                    Box.BackgroundColor3=toggled and C.Accent or Color3.fromRGB(28,28,28)
                    Box.BorderSizePixel=0; Box.ZIndex=14; makeCorner(Box,3)
                    makeStroke(Box,toggled and C.Accent or C.BorderBright,1,0)

                    local Check=Instance.new("TextLabel",Box)
                    Check.Size=UDim2.new(1,0,1,0); Check.BackgroundTransparency=1
                    Check.Text="✓"; Check.TextColor3=C.White
                    Check.TextSize=9; Check.Font=Enum.Font.GothamBold
                    Check.TextXAlignment=Enum.TextXAlignment.Center
                    Check.TextTransparency=toggled and 0 or 1; Check.ZIndex=15

                    local Lbl=Instance.new("TextLabel",Row)
                    Lbl.Size=UDim2.new(1,-20,1,0); Lbl.Position=UDim2.new(0,18,0,0)
                    Lbl.BackgroundTransparency=1; Lbl.Text=cfg.Name or "Toggle"
                    Lbl.TextColor3=toggled and C.Text or C.Sub
                    Lbl.TextSize=11; Lbl.Font=Enum.Font.Gotham
                    Lbl.TextXAlignment=Enum.TextXAlignment.Left; Lbl.ZIndex=14

                    -- keybind inline (direita) — como no Matcha
                    local KBLabel
                    if cfg.Keybind then
                        KBLabel=Instance.new("TextLabel",Row)
                        KBLabel.Size=UDim2.new(0,30,0,16); KBLabel.AnchorPoint=Vector2.new(1,0.5)
                        KBLabel.Position=UDim2.new(1,0,0.5,0)
                        KBLabel.BackgroundColor3=C.Bg4; KBLabel.BackgroundTransparency=0
                        KBLabel.Text=cfg.Keybind; KBLabel.TextColor3=C.Sub
                        KBLabel.TextSize=9; KBLabel.Font=Enum.Font.Code
                        KBLabel.TextXAlignment=Enum.TextXAlignment.Center; KBLabel.ZIndex=14
                        makeCorner(KBLabel,3); makeStroke(KBLabel,C.Border,1,0)
                    end

                    local Toggle={Value=toggled}
                    local function Update()
                        local v=Toggle.Value
                        Tween(Box,{BackgroundColor3=v and C.Accent or Color3.fromRGB(28,28,28)},0.1):Play()
                        Tween(Check,{TextTransparency=v and 0 or 1},0.1):Play()
                        Tween(Lbl,{TextColor3=v and C.Text or C.Sub},0.1):Play()
                        local st=Box:FindFirstChildOfClass("UIStroke")
                        if st then Tween(st,{Color=v and C.Accent or C.BorderBright},0.1):Play() end
                    end

                    local Hit=Instance.new("TextButton",Row)
                    Hit.Size=UDim2.new(1,0,1,0); Hit.BackgroundTransparency=1
                    Hit.Text=""; Hit.ZIndex=16
                    Hit.MouseEnter:Connect(function()
                        Tween(Row,{BackgroundColor3=C.BgHover,BackgroundTransparency=0.5},0.08):Play()
                    end)
                    Hit.MouseLeave:Connect(function()
                        Tween(Row,{BackgroundTransparency=1},0.08):Play()
                    end)
                    Hit.MouseButton1Click:Connect(function()
                        Toggle.Value=not Toggle.Value; Update(); callback(Toggle.Value)
                    end)
                    function Toggle:Set(v) Toggle.Value=v; Update(); callback(v) end
                    AddItem(Row); return Toggle
                end

                -- ───── SLIDER ─────
                function Section:AddSlider(cfg)
                    cfg=cfg or {}
                    local min=cfg.Min or 0; local max=cfg.Max or 100
                    local val=cfg.Default or min; local rnd=cfg.Rounding or 0
                    local callback=cfg.Callback or function() end

                    local Row=Instance.new("Frame")
                    Row.Size=UDim2.new(1,0,0,36); Row.BackgroundTransparency=1; Row.ZIndex=13

                    -- linha superior: nome | valor
                    local Lbl=Instance.new("TextLabel",Row)
                    Lbl.Size=UDim2.new(0.7,0,0,16); Lbl.Position=UDim2.new(0,0,0,2)
                    Lbl.BackgroundTransparency=1; Lbl.Text=cfg.Name or "Slider"
                    Lbl.TextColor3=C.Sub; Lbl.TextSize=11; Lbl.Font=Enum.Font.Gotham
                    Lbl.TextXAlignment=Enum.TextXAlignment.Left; Lbl.ZIndex=14

                    local ValLbl=Instance.new("TextLabel",Row)
                    ValLbl.Size=UDim2.new(0.3,0,0,16); ValLbl.Position=UDim2.new(0.7,0,0,2)
                    ValLbl.BackgroundTransparency=1; ValLbl.Text=tostring(val)
                    ValLbl.TextColor3=C.Text; ValLbl.TextSize=11; ValLbl.Font=Enum.Font.Code
                    ValLbl.TextXAlignment=Enum.TextXAlignment.Right; ValLbl.ZIndex=14

                    -- track + fill (estilo Matcha: fino, rosa)
                    local Track=Instance.new("Frame",Row)
                    Track.Size=UDim2.new(1,0,0,3); Track.Position=UDim2.new(0,0,0,22)
                    Track.BackgroundColor3=C.Bg5; Track.BorderSizePixel=0; Track.ZIndex=14
                    makeCorner(Track,2)
                    local Fill=Instance.new("Frame",Track)
                    Fill.Size=UDim2.new((val-min)/(max-min),0,1,0)
                    Fill.BackgroundColor3=C.Accent; Fill.BorderSizePixel=0; Fill.ZIndex=15
                    makeCorner(Fill,2)
                    -- thumb pequeno (círculo rosa)
                    local Thumb=Instance.new("Frame",Fill)
                    Thumb.Size=UDim2.new(0,9,0,9); Thumb.AnchorPoint=Vector2.new(1,0.5)
                    Thumb.Position=UDim2.new(1,0,0.5,0); Thumb.BackgroundColor3=C.Accent
                    Thumb.BorderSizePixel=0; Thumb.ZIndex=16; makeCorner(Thumb,5)

                    local SliderHit=Instance.new("TextButton",Track)
                    SliderHit.Size=UDim2.new(1,0,0,20); SliderHit.Position=UDim2.new(0,0,0.5,-10)
                    SliderHit.BackgroundTransparency=1; SliderHit.Text=""; SliderHit.ZIndex=17

                    local Slider={Value=val}
                    local function Round(n)
                        if rnd==0 then return math.floor(n+0.5)
                        else return tonumber(string.format("%."..rnd.."f",n)) end
                    end
                    local function SetPx(px)
                        local pct=math.clamp(px/Track.AbsoluteSize.X,0,1)
                        local nv=Round(min+(max-min)*pct)
                        Slider.Value=nv; ValLbl.Text=tostring(nv)
                        Fill.Size=UDim2.new(pct,0,1,0); callback(nv)
                    end
                    local dragging=false
                    SliderHit.InputBegan:Connect(function(i)
                        if i.UserInputType==Enum.UserInputType.MouseButton1 then
                            dragging=true; SetPx(Mouse.X-Track.AbsolutePosition.X) end
                    end)
                    UserInputService.InputEnded:Connect(function(i)
                        if i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=false end
                    end)
                    UserInputService.InputChanged:Connect(function(i)
                        if dragging and i.UserInputType==Enum.UserInputType.MouseMovement then
                            SetPx(Mouse.X-Track.AbsolutePosition.X) end
                    end)
                    function Slider:Set(v)
                        v=math.clamp(Round(v),min,max); Slider.Value=v
                        ValLbl.Text=tostring(v)
                        Fill.Size=UDim2.new((v-min)/(max-min),0,1,0); callback(v)
                    end
                    task.defer(function() callback(val) end)
                    AddItem(Row); return Slider
                end

                -- ───── DROPDOWN ─────
                function Section:AddDropdown(cfg)
                    cfg=cfg or {}
                    local options=cfg.Values or {}
                    local selected=cfg.Default or options[1]
                    local callback=cfg.Callback or function() end
                    local opened=false

                    -- label acima
                    local LblRow=Instance.new("TextLabel")
                    LblRow.Size=UDim2.new(1,0,0,16); LblRow.BackgroundTransparency=1
                    LblRow.Text=cfg.Name or ""; LblRow.TextColor3=C.Sub
                    LblRow.TextSize=11; LblRow.Font=Enum.Font.Gotham
                    LblRow.TextXAlignment=Enum.TextXAlignment.Left; LblRow.ZIndex=13
                    if cfg.Name and cfg.Name~="" then AddItem(LblRow) end

                    -- botão dropdown — fundo escuro, borda, seta direita
                    local Sel=Instance.new("TextButton")
                    Sel.Size=UDim2.new(1,0,0,26); Sel.BackgroundColor3=C.Bg4
                    Sel.Text=""; Sel.AutoButtonColor=false; Sel.ZIndex=13
                    makeCorner(Sel,4); makeStroke(Sel,C.BorderBright,1,0)

                    local SelTxt=Instance.new("TextLabel",Sel)
                    SelTxt.Size=UDim2.new(1,-28,1,0); SelTxt.Position=UDim2.new(0,10,0,0)
                    SelTxt.BackgroundTransparency=1; SelTxt.Text=selected or "--"
                    SelTxt.TextColor3=C.Text; SelTxt.TextSize=11; SelTxt.Font=Enum.Font.Gotham
                    SelTxt.TextXAlignment=Enum.TextXAlignment.Left; SelTxt.ZIndex=14

                    local Arrow=Instance.new("TextLabel",Sel)
                    Arrow.Size=UDim2.new(0,20,1,0); Arrow.Position=UDim2.new(1,-22,0,0)
                    Arrow.BackgroundTransparency=1; Arrow.Text="▾"
                    Arrow.TextColor3=C.Muted; Arrow.TextSize=11; Arrow.Font=Enum.Font.Gotham
                    Arrow.TextXAlignment=Enum.TextXAlignment.Center; Arrow.ZIndex=14

                    local Dropdown={Value=selected}

                    local DFrame=Instance.new("Frame",ScreenGui)
                    DFrame.Size=UDim2.new(0,0,0,#options*24+8)
                    DFrame.AutomaticSize=Enum.AutomaticSize.X
                    DFrame.BackgroundColor3=C.Bg4; DFrame.BorderSizePixel=0
                    DFrame.Visible=false; DFrame.ZIndex=200
                    makeCorner(DFrame,5); makeStroke(DFrame,C.BorderBright,1,0)
                    local DL=Instance.new("UIListLayout",DFrame)
                    DL.Padding=UDim.new(0,2); DL.SortOrder=Enum.SortOrder.LayoutOrder
                    makePadding(DFrame,4,4,4,4)

                    local _hov=false
                    DFrame.MouseEnter:Connect(function() _hov=true end)
                    DFrame.MouseLeave:Connect(function() _hov=false end)

                    local optBtns={}
                    for _,opt in ipairs(options) do
                        local OBtn=Instance.new("TextButton",DFrame)
                        OBtn.Size=UDim2.new(1,0,0,22); OBtn.BackgroundColor3=C.Bg5
                        OBtn.BackgroundTransparency=opt==selected and 0.4 or 1
                        OBtn.Text=opt; OBtn.TextColor3=opt==selected and C.Accent or C.Sub
                        OBtn.TextSize=11; OBtn.Font=Enum.Font.Gotham
                        OBtn.AutoButtonColor=false; OBtn.ZIndex=201
                        makeCorner(OBtn,3)
                        optBtns[opt]=OBtn
                        OBtn.MouseEnter:Connect(function()
                            _hov=true
                            if opt~=Dropdown.Value then Tween(OBtn,{BackgroundTransparency=0.5,TextColor3=C.Text},0.08):Play() end
                        end)
                        OBtn.MouseLeave:Connect(function()
                            if opt~=Dropdown.Value then Tween(OBtn,{BackgroundTransparency=1,TextColor3=C.Sub},0.08):Play() end
                        end)
                        OBtn.MouseButton1Click:Connect(function()
                            local prev=Dropdown.Value
                            Dropdown.Value=opt; SelTxt.Text=opt
                            for o,b in pairs(optBtns) do
                                b.TextColor3=o==opt and C.Accent or C.Sub
