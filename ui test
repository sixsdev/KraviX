        -- Atalho: Tab:AddSection vai para a primeira subtab ou cria uma automaticamente
        function Tab:AddSection(sectionName, column)
            if #tabEntry.SubTabs == 0 then
                self:AddSubTab(sectionName or "Main")
            end
            local firstSub = tabEntry.SubTabs[1]
            -- cria seção diretamente na primeira subtab
            local scroll=(column=="Right") and
                firstSub.Panel:FindFirstChild("ScrollingFrame2") or
                firstSub.Panel:FindFirstChildOfClass("ScrollingFrame")

            -- fallback: usa AddSubTab + AddSection normalmente
            local sub=self:AddSubTab(sectionName or "Main")
            return sub:AddSection(sectionName,column)
        end

        return Tab
