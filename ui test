                        end
                    end)

                    Main:GetPropertyChangedSignal("Visible"):Connect(function()
                        pickerOpen = false; PF.Visible = false
                    end)

                    task.defer(function() callback(color) end)

                    function Picker:Set(c)
                        Picker.Value = c; ph,ps,pv = c:ToHSV(); UpdateAll()
                    end

                    AddItem(Row); return Picker
                end

                function Section:AddLabel(cfg)
                    cfg = cfg or {}
                    local L = Instance.new("TextLabel")
                    L.Size = UDim2.new(1,0,0,18); L.BackgroundTransparency = 1
                    L.Text = cfg.Text or ""; L.TextColor3 = cfg.Color or C.Muted
                    L.TextSize = 10; L.Font = Enum.Font.Gotham
                    L.TextXAlignment = Enum.TextXAlignment.Left
                    L.TextWrapped = true; L.ZIndex = 13
                    AddItem(L)
                    return {SetText=function(_,t) L.Text=t end}
                end

                function Section:AddSeparator()
                    local S = Instance.new("Frame")
                    S.Size = UDim2.new(1,0,0,1); S.BackgroundColor3 = C.Border
                    S.BorderSizePixel = 0; S.ZIndex = 13
                    AddItem(S)
                end

                return Section
            end

            return SubTab
        end

        function Tab:AddSection(sectionName, column)
            if #tabEntry.SubTabs == 0 then Tab:AddSubTab("_default") end
            local lastSub = tabEntry.SubTabs[#tabEntry.SubTabs]
            return lastSub:AddSection(sectionName, column)
        end

        return Tab
    end

    local Footer = Instance.new("Frame", Main)
    Footer.Size = UDim2.new(1,0,0,22); Footer.Position = UDim2.new(0,0,1,-22)
    Footer.BackgroundColor3 = C.Bg; Footer.BackgroundTransparency = 0
    Footer.BorderSizePixel = 0; Footer.ZIndex = 12
    mkStroke(Footer, C.Border, 1, 0)

    local FUrl = Instance.new("TextLabel", Footer)
    FUrl.Size = UDim2.new(1,0,1,0); FUrl.Position = UDim2.new(0,0,0,0)
    FUrl.BackgroundTransparency = 1; FUrl.Text = config.Url
    FUrl.TextColor3 = C.Muted; FUrl.TextSize = 9; FUrl.Font = Enum.Font.Gotham
    FUrl.TextXAlignment = Enum.TextXAlignment.Center; FUrl.ZIndex = 13

    local now    = os.date("*t")
    local months = {"Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"}

    local FBuildLabel = Instance.new("TextLabel", Footer)
    FBuildLabel.Size = UDim2.new(0,42,1,0); FBuildLabel.AnchorPoint = Vector2.new(1,0)
    FBuildLabel.Position = UDim2.new(1,-10,0,0)
    FBuildLabel.BackgroundTransparency = 1; FBuildLabel.Text = "Build:"
    FBuildLabel.TextColor3 = C.Muted; FBuildLabel.TextSize = 9; FBuildLabel.Font = Enum.Font.Gotham
    FBuildLabel.TextXAlignment = Enum.TextXAlignment.Right; FBuildLabel.ZIndex = 13

    local FBuildDate = Instance.new("TextLabel", Footer)
    FBuildDate.Name = "FBuildDate"
    FBuildDate.Size = UDim2.new(0,0,1,0); FBuildDate.AutomaticSize = Enum.AutomaticSize.X
    FBuildDate.AnchorPoint = Vector2.new(1,0); FBuildDate.Position = UDim2.new(1,-10,0,0)
    FBuildDate.BackgroundTransparency = 1
    FBuildDate.Text = months[now.month].." "..now.day.." "..now.year
    FBuildDate.TextColor3 = C.Accent; FBuildDate.TextSize = 9; FBuildDate.Font = Enum.Font.GothamBold
    FBuildDate.TextXAlignment = Enum.TextXAlignment.Right; FBuildDate.ZIndex = 14

    task.defer(function()
        local dateW = FBuildDate.AbsoluteSize.X
        local labelW = FBuildLabel.AbsoluteSize.X
        FBuildDate.Position = UDim2.new(1,-8,0,0)
        FBuildLabel.Position = UDim2.new(1,-(8+dateW+4),0,0)
    end)

    return Window
end

return KraviX
