        TopBar.BackgroundTransparency = 1; TabBar.BackgroundTransparency = 1
        Backdrop.BackgroundTransparency = 1
        Tween(Backdrop,{BackgroundTransparency=0.55},0.25,Enum.EasingStyle.Quad):Play()
        Tween(Main,{Size=UDim2.new(0,WIN_W,0,WIN_H),
            Position=UDim2.new(0.5,-WIN_W/2,0.5,-WIN_H/2),
            BackgroundTransparency=0},0.45,Enum.EasingStyle.Back,Enum.EasingDirection.Out):Play()
        task.delay(0.15*TWEEN_SPD, function() Tween(TopBar,{BackgroundTransparency=0},0.2):Play() end)
        task.delay(0.2*TWEEN_SPD, function()
            Tween(TabBar,{BackgroundTransparency=0},0.2):Play()
            Main.ClipsDescendants = false
        end)
    end

    local function ToggleWindow()
        if Main.Visible then HideWindow() else ShowWindow() end
    end
