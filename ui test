        local function SelectTab()
            activeTabIndex=tabIndex
            for _, t in ipairs(Window.Tabs) do
                local on = t.Index==activeTabIndex
                if not on then t.Container.Visible=false end
                Tween(t.Btn,{
                    TextColor3             = on and C.Accent  or C.Muted,
                    BackgroundTransparency = on and 0.55 or 1,
                }, 0.12):Play()
                if on then t.Btn.BackgroundColor3=C.TabActive end
            end
            TwoCol.Visible=true
            FadeOverlay.BackgroundTransparency=0
            Tween(FadeOverlay,{BackgroundTransparency=1},0.18,Enum.EasingStyle.Quad):Play()
        end

        TabBtn.MouseButton1Click:Connect(SelectTab)
        TabBtn.MouseEnter:Connect(function()
            if tabIndex~=activeTabIndex then Tween(TabBtn,{TextColor3=C.Sub},0.1):Play() end
        end)
        TabBtn.MouseLeave:Connect(function()
            if tabIndex~=activeTabIndex then Tween(TabBtn,{TextColor3=C.Muted},0.1):Play() end
        end)
        if #Window.Tabs==1 then SelectTab() end

