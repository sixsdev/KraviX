local _notifSlots={}

local function CreateNotification(title, text, duration, ntype)
    PlaySound(SOUND_NOTIF)
    ntype=ntype or "info"
    local dotColor
    if     ntype=="error"   then dotColor=C.Red
    elseif ntype=="success" then dotColor=C.Green
    else                         dotColor=C.Accent end

    local G=Instance.new("ScreenGui")
    G.Name="KxNotif_"..tostring(tick())
    G.IgnoreGuiInset=true; G.ZIndexBehavior=Enum.ZIndexBehavior.Global; G.ResetOnSpawn=false
    if syn and syn.protect_gui then syn.protect_gui(G); G.Parent=CoreGui
    elseif gethui then G.Parent=gethui() else G.Parent=CoreGui end

    local H=30; local MARGIN=10
    local slot=0
    while _notifSlots[slot] do slot=slot+1 end
    _notifSlots[slot]=true

    local F=Instance.new("Frame",G)
    F.Size=UDim2.new(0,0,0,H); F.AutomaticSize=Enum.AutomaticSize.X
    F.Position=UDim2.new(1,30,1,-(MARGIN+(H+MARGIN)*slot))
    F.AnchorPoint=Vector2.new(1,1)
    F.BackgroundColor3=Color3.fromRGB(13,13,13)
    F.BackgroundTransparency=0; F.BorderSizePixel=0
    mkCorner(F,H/2)
    mkStroke(F,Color3.fromRGB(36,36,36),1,0)

    local List=Instance.new("UIListLayout",F)
    List.FillDirection=Enum.FillDirection.Horizontal
    List.VerticalAlignment=Enum.VerticalAlignment.Center
    List.Padding=UDim.new(0,7)
    mkPad(F,0,0,12,14)

    local Dot=Instance.new("Frame",F)
    Dot.Size=UDim2.new(0,7,0,7); Dot.BackgroundColor3=dotColor
    Dot.BorderSizePixel=0; mkCorner(Dot,4); Dot.LayoutOrder=0

    local Sep=Instance.new("Frame",F)
    Sep.Size=UDim2.new(0,1,0,12); Sep.BackgroundColor3=Color3.fromRGB(40,40,40)
    Sep.BorderSizePixel=0; Sep.LayoutOrder=1

    local T=Instance.new("TextLabel",F)
    T.Size=UDim2.new(0,0,1,0); T.AutomaticSize=Enum.AutomaticSize.X
    T.BackgroundTransparency=1; T.Text=title
    T.TextColor3=C.Text; T.TextSize=11; T.Font=Enum.Font.GothamBold
    T.TextXAlignment=Enum.TextXAlignment.Left; T.LayoutOrder=2

    local D=Instance.new("TextLabel",F)
    D.Size=UDim2.new(0,0,1,0); D.AutomaticSize=Enum.AutomaticSize.X
    D.BackgroundTransparency=1; D.Text=text
    D.TextColor3=C.Sub; D.TextSize=10; D.Font=Enum.Font.Gotham
    D.TextXAlignment=Enum.TextXAlignment.Left; D.LayoutOrder=3

    local PBg=Instance.new("Frame",G)
    PBg.AnchorPoint=Vector2.new(1,1); PBg.Size=UDim2.new(0,10,0,2)
    PBg.Position=UDim2.new(1,-MARGIN,1,-(MARGIN+(H+MARGIN)*slot)-H-3)
    PBg.BackgroundColor3=Color3.fromRGB(30,30,30); PBg.BorderSizePixel=0; mkCorner(PBg,2)
    local PFill=Instance.new("Frame",PBg)
    PFill.Size=UDim2.new(1,0,1,0); PFill.BackgroundColor3=dotColor
    PFill.BorderSizePixel=0; mkCorner(PFill,2)

    local dur=duration or 3
    Tween(F,{Position=UDim2.new(1,-MARGIN,1,-(MARGIN+(H+MARGIN)*slot))},0.28,Enum.EasingStyle.Back):Play()
    task.delay(0.06,function()
        if not F or not F.Parent then return end
        local w=F.AbsoluteSize.X
        PBg.Size=UDim2.new(0,w,0,2)
        PBg.Position=UDim2.new(1,-MARGIN,1,-(MARGIN+(H+MARGIN)*slot)-H-3)
        Tween(PFill,{Size=UDim2.new(0,0,1,0)},dur-0.06,Enum.EasingStyle.Linear):Play()
    end)
    task.delay(dur,function()
        _notifSlots[slot]=nil
        Tween(F,{Position=UDim2.new(1,30,1,-(MARGIN+(H+MARGIN)*slot))},0.2,Enum.EasingStyle.Quint,Enum.EasingDirection.In):Play()
        Tween(PBg,{BackgroundTransparency=1},0.15):Play()
        task.wait(0.22); G:Destroy()
    end)
end

