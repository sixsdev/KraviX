                function Section:AddSlider(cfg)
                    cfg = cfg or {}
                    local min = cfg.Min or 0; local max = cfg.Max or 100
                    local val = cfg.Default or min; local rnd = cfg.Rounding or 0
                    local callback = cfg.Callback or function() end

                    local Row = Instance.new("Frame")
                    Row.Size = UDim2.new(1,0,0,38); Row.BackgroundTransparency = 1; Row.ZIndex = 13

                    local Lbl = Instance.new("TextLabel", Row)
                    Lbl.Size = UDim2.new(0.7,0,0,16); Lbl.Position = UDim2.new(0,0,0,2)
                    Lbl.BackgroundTransparency = 1; Lbl.Text = cfg.Name or "Slider"
                    Lbl.TextColor3 = C.Sub; Lbl.TextSize = 11; Lbl.Font = Enum.Font.Gotham
                    Lbl.TextXAlignment = Enum.TextXAlignment.Left; Lbl.ZIndex = 14

                    local ValLbl = Instance.new("TextLabel", Row)
                    ValLbl.Size = UDim2.new(0.3,0,0,16); ValLbl.Position = UDim2.new(0.7,0,0,2)
                    ValLbl.BackgroundTransparency = 1; ValLbl.Text = tostring(val)
                    ValLbl.TextColor3 = C.Sub; ValLbl.TextSize = 11; ValLbl.Font = Enum.Font.Code
                    ValLbl.TextXAlignment = Enum.TextXAlignment.Right; ValLbl.ZIndex = 14

                    local Track = Instance.new("Frame", Row)
                    Track.Size = UDim2.new(1,0,0,3); Track.Position = UDim2.new(0,0,0,24)
                    Track.BackgroundColor3 = C.Bg5; Track.BorderSizePixel = 0
                    Track.ZIndex = 14; mkCorner(Track,2)

                    local Fill = Instance.new("Frame", Track)
                    Fill.Size = UDim2.new((val-min)/(max-min),0,1,0)
                    Fill.BackgroundColor3 = C.Accent; Fill.BorderSizePixel = 0
                    Fill.ZIndex = 15; mkCorner(Fill,2)

                    local Thumb = Instance.new("Frame", Fill)
                    Thumb.Size = UDim2.new(0,10,0,10); Thumb.AnchorPoint = Vector2.new(1,0.5)
                    Thumb.Position = UDim2.new(1,0,0.5,0); Thumb.BackgroundColor3 = C.Accent
                    Thumb.BorderSizePixel = 0; Thumb.ZIndex = 16; mkCorner(Thumb,5)

                    local SliderBtn = Instance.new("TextButton", Track)
                    SliderBtn.Size = UDim2.new(1,0,0,20); SliderBtn.Position = UDim2.new(0,0,0.5,-10)
                    SliderBtn.BackgroundTransparency = 1; SliderBtn.Text = ""; SliderBtn.ZIndex = 17

                    local Slider = {Value=val}
                    local function Round(n)
                        if rnd == 0 then return math.floor(n+0.5)
                        else return tonumber(string.format("%."..rnd.."f",n)) end
                    end
                    local function SetPx(px)
                        local pct = math.clamp(px/Track.AbsoluteSize.X,0,1)
                        local nv  = Round(min+(max-min)*pct)
                        Slider.Value = nv; ValLbl.Text = tostring(nv)
                        Fill.Size = UDim2.new(pct,0,1,0); callback(nv)
                    end
                    local drag = false
                    SliderBtn.InputBegan:Connect(function(i)
                        if i.UserInputType == Enum.UserInputType.MouseButton1 then
                            drag = true; SetPx(Mouse.X-Track.AbsolutePosition.X)
                        end
                    end)
                    UserInputService.InputEnded:Connect(function(i)
                        if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = false end
                    end)
                    UserInputService.InputChanged:Connect(function(i)
                        if drag and i.UserInputType == Enum.UserInputType.MouseMovement then
                            SetPx(Mouse.X-Track.AbsolutePosition.X)
                        end
                    end)
                    function Slider:Set(v)
                        v = math.clamp(Round(v),min,max); Slider.Value = v
                        ValLbl.Text = tostring(v)
                        Fill.Size = UDim2.new((v-min)/(max-min),0,1,0); callback(v)
                    end
                    task.defer(function() callback(val) end)
                    AddItem(Row); return Slider
                end

