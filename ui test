                Canvas.Size=UDim2.new(1,-28,1,-32); Canvas.BackgroundColor3=Color3.fromHSV(hue,1,1); Canvas.ZIndex=101; makeCorner(Canvas,4)
                local Sat2=Instance.new("UIGradient",Canvas); Sat2.Color=ColorSequence.new(Color3.fromRGB(255,255,255),Color3.fromHSV(hue,1,1))
                local Dark=Instance.new("Frame",Canvas); Dark.Size=UDim2.new(1,0,1,0); Dark.BackgroundColor3=Color3.new(0,0,0); Dark.BackgroundTransparency=0; Dark.BorderSizePixel=0; Dark.ZIndex=102; makeCorner(Dark,4)
                local DG=Instance.new("UIGradient",Dark); DG.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(1,0)}); DG.Rotation=90
                local CC=Instance.new("Frame",Canvas); CC.Size=UDim2.new(0,8,0,8); CC.AnchorPoint=Vector2.new(0.5,0.5); CC.Position=UDim2.new(sat,0,1-val2,0); CC.BackgroundColor3=C.White; CC.BorderSizePixel=1; CC.BorderColor3=C.Black; CC.ZIndex=103; makeCorner(CC,4)
                local HBar=Instance.new("ImageButton",PF)
                HBar.Size=UDim2.new(0,16,1,-32); HBar.Position=UDim2.new(1,-16,0,0); HBar.BackgroundColor3=C.White; HBar.ZIndex=101; makeCorner(HBar,4)
                local HG=Instance.new("UIGradient",HBar); HG.Rotation=90
                HG.Color=ColorSequence.new({
                    ColorSequenceKeypoint.new(0,Color3.fromRGB(255,0,0));ColorSequenceKeypoint.new(0.17,Color3.fromRGB(255,255,0));
                    ColorSequenceKeypoint.new(0.33,Color3.fromRGB(0,255,0));ColorSequenceKeypoint.new(0.5,Color3.fromRGB(0,255,255));
                    ColorSequenceKeypoint.new(0.67,Color3.fromRGB(0,0,255));ColorSequenceKeypoint.new(0.83,Color3.fromRGB(255,0,255));
                    ColorSequenceKeypoint.new(1,Color3.fromRGB(255,0,0))
                })
                local HC=Instance.new("Frame",HBar); HC.Size=UDim2.new(1,4,0,3); HC.Position=UDim2.new(0,-2,hue,0); HC.BackgroundColor3=C.White; HC.BorderSizePixel=1; HC.BorderColor3=C.Black; HC.ZIndex=102
                local function UpdateColor()
                    local c=Color3.fromHSV(hue,sat,val2); Picker.Value=c; Swatch.BackgroundColor3=c
                    Canvas.BackgroundColor3=Color3.fromHSV(hue,1,1); Sat2.Color=ColorSequence.new(Color3.fromRGB(255,255,255),Color3.fromHSV(hue,1,1))
                    CC.Position=UDim2.new(sat,0,1-val2,0); HC.Position=UDim2.new(0,-2,hue,0); callback(c)
                end
                local cDrag,hDrag=false,false
                Canvas.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then cDrag=true; sat=math.clamp((Mouse.X-Canvas.AbsolutePosition.X)/Canvas.AbsoluteSize.X,0,1); val2=1-math.clamp((Mouse.Y-Canvas.AbsolutePosition.Y)/Canvas.AbsoluteSize.Y,0,1); UpdateColor() end end)
                HBar.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then hDrag=true; hue=math.clamp((Mouse.Y-HBar.AbsolutePosition.Y)/HBar.AbsoluteSize.Y,0,1); UpdateColor() end end)
                UserInputService.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then cDrag=false; hDrag=false end end)
                UserInputService.InputChanged:Connect(function(i)
                    if i.UserInputType==Enum.UserInputType.MouseMovement then
                        if cDrag then sat=math.clamp((Mouse.X-Canvas.AbsolutePosition.X)/Canvas.AbsoluteSize.X,0,1); val2=1-math.clamp((Mouse.Y-Canvas.AbsolutePosition.Y)/Canvas.AbsoluteSize.Y,0,1); UpdateColor() end
                        if hDrag then hue=math.clamp((Mouse.Y-HBar.AbsolutePosition.Y)/HBar.AbsoluteSize.Y,0,1); UpdateColor() end
                    end
                end)
                Swatch.MouseButton1Click:Connect(function()
                    pickerOpen=not pickerOpen; PF.Visible=pickerOpen
                    if pickerOpen then local abs=Swatch.AbsolutePosition; PF.Position=UDim2.fromOffset(abs.X-148,abs.Y+22) end
                end)
                UserInputService.InputBegan:Connect(function(inp)
                    if inp.UserInputType==Enum.UserInputType.MouseButton1 then
                        local mp=UserInputService:GetMouseLocation(); local fp=PF.AbsolutePosition; local fs=PF.AbsoluteSize
                        if not (mp.X>=fp.X and mp.X<=fp.X+fs.X and mp.Y>=fp.Y and mp.Y<=fp.Y+fs.Y) then pickerOpen=false; PF.Visible=false end
                    end
                end)
                task.defer(function() callback(color) end)
                function Picker:Set(c) Picker.Value=c; hue,sat,val2=c:ToHSV(); UpdateColor() end
                AddItem(Row); return Picker
            end

            -- ─────────────────────────────────
            --  LABEL
            -- ─────────────────────────────────
            function Section:AddLabel(cfg)
                cfg=cfg or {}
                local L=Instance.new("TextLabel")
                L.Size=UDim2.new(1,0,0,16); L.BackgroundTransparency=1
                L.Text=cfg.Text or ""; L.TextColor3=cfg.Color or C.Muted
                L.TextSize=10; L.Font=Enum.Font.Gotham
                L.TextXAlignment=Enum.TextXAlignment.Left; L.TextWrapped=true; L.ZIndex=13
                AddItem(L)
                return {SetText=function(_,t) L.Text=t end}
            end

            -- ─────────────────────────────────
            --  SEPARADOR
            -- ─────────────────────────────────
            function Section:AddSeparator()
                local S=Instance.new("Frame")
                S.Size=UDim2.new(1,0,0,1); S.BackgroundColor3=C.Border
                S.BorderSizePixel=0; S.ZIndex=13
                AddItem(S)
            end

            return Section
        end

        return Tab
    end

    return Window
end

