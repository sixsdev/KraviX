    T.TextSize = 12; T.Font = Enum.Font.GothamBold
    T.TextXAlignment = Enum.TextXAlignment.Left; T.TextTransparency = 1
    local D = Instance.new("TextLabel", F)
    D.Size = UDim2.new(1,-14,0,22); D.Position = UDim2.new(0,10,0,28)
    D.BackgroundTransparency = 1; D.Text = text; D.TextColor3 = C.Sub
    D.TextSize = 10; D.Font = Enum.Font.Gotham
    D.TextXAlignment = Enum.TextXAlignment.Left; D.TextWrapped = true; D.TextTransparency = 1

    Tween(F, {Position=UDim2.new(1,-296,0,16), BackgroundTransparency=0.02}, 0.25, Enum.EasingStyle.Quint):Play()
    Tween(FStroke, {Transparency=0.3}, 0.25):Play()
