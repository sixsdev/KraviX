                -- ───── MOUSE KEYBIND ─────
                function Section:AddMouseKeybind(cfg)
                    cfg=cfg or {}
                    local cur
                    if type(cfg.Default)=="table" and cfg.Default.type then cur=cfg.Default
                    else cur={type="key",value=cfg.Default or Enum.KeyCode.E} end
                    local listen=false; local callback=cfg.Callback or function() end
                    local function bindLabel(b)
                        if not b then return "None" end
                        if b.type=="mouse" then return MOUSE_NAMES[b.value] or "M?"
                        else return b.value and b.value.Name or "?" end
                    end
                    local Row=Instance.new("Frame")
                    Row.Size=UDim2.new(1,0,0,24); Row.BackgroundTransparency=1; Row.ZIndex=13
                    local Lbl=Instance.new("TextLabel",Row)
                    Lbl.Size=UDim2.new(0.6,0,1,0); Lbl.BackgroundTransparency=1
                    Lbl.Text=cfg.Name or "Keybind"; Lbl.TextColor3=C.Sub
                    Lbl.TextSize=11; Lbl.Font=Enum.Font.Gotham
                    Lbl.TextXAlignment=Enum.TextXAlignment.Left; Lbl.ZIndex=14
                    local KB=Instance.new("TextButton",Row)
                    KB.Size=UDim2.new(0,42,0,18); KB.AnchorPoint=Vector2.new(1,0.5)
                    KB.Position=UDim2.new(1,0,0.5,0)
                    KB.BackgroundColor3=C.Bg4; KB.Text=bindLabel(cur)
                    KB.TextColor3=C.Sub; KB.TextSize=9; KB.Font=Enum.Font.Code
                    KB.AutoButtonColor=false; KB.ZIndex=14
                    makeCorner(KB,3); makeStroke(KB,C.BorderBright,1,0)
                    local Bind={Value=cur}
                    KB.InputBegan:Connect(function(inp)
                        if inp.UserInputType~=Enum.UserInputType.MouseButton1 then return end
                        if listen then return end
                        task.spawn(function()
                            RunService.Heartbeat:Wait()
                            listen=true; KB.Text="..."; KB.TextColor3=C.Accent
                        end)
                    end)
                    UserInputService.InputBegan:Connect(function(inp,processed)
                        if not listen then return end; if processed then return end
                        if inp.UserInputType==Enum.UserInputType.MouseButton1 then
                            task.wait(0.05); if not listen then return end
                        end
                        local isMouse=false
                        for _,mt in ipairs(MOUSE_TYPES) do
                            if inp.UserInputType==mt then isMouse=true; cur={type="mouse",value=inp.UserInputType}; break end
                        end
                        if not isMouse then
                            if inp.UserInputType==Enum.UserInputType.Keyboard then
                                if inp.KeyCode==Enum.KeyCode.Escape then listen=false; KB.Text=bindLabel(cur); KB.TextColor3=C.Sub; return end
                                cur={type="key",value=inp.KeyCode}
                            else return end
                        end
                        listen=false; Bind.Value=cur; KB.Text=bindLabel(cur); KB.TextColor3=C.Sub; callback(cur)
                    end)
                    function Bind:Set(b)
                        if type(b)=="table" and b.type then cur=b else cur={type="key",value=b} end
                        Bind.Value=cur; KB.Text=bindLabel(cur); KB.TextColor3=C.Sub; callback(cur)
                    end
                    AddItem(Row); return Bind
                end

