    config.Url     = config.Url     or ""
    config.Version = config.Version or "v1.0"
    config.Mode    = config.Mode    or "Standard"

    if config.Accent then
        C.Accent  = config.Accent
        C.Accent2 = lighten(config.Accent, 0.09)
        C.BgHover = Color3.new(
            math.clamp(config.Accent.R*0.12,0,1),
            math.clamp(config.Accent.G*0.08,0,1),
            math.clamp(config.Accent.B*0.12,0,1))
