            -- ── Slider ──
            function Section:AddSlider(config2)
                config2 = config2 or {}
                local min      = config2.Min      or 0
                local max      = config2.Max      or 100
                local val      = config2.Default  or min
                local rnd      = config2.Rounding or 0
                local callback = config2.Callback or function() end

                local Row = Instance.new("Frame")
                Row.Size                   = UDim2.new(1, 0, 0, 52)
                Row.BackgroundTransparency = 1
                Row.ZIndex                 = 13

                local Lbl = Instance.new("TextLabel", Row)
                Lbl.Size                   = UDim2.new(1, -70, 0, 20)
                Lbl.Position               = UDim2.new(0, 14, 0, 8)
                Lbl.BackgroundTransparency = 1
                Lbl.Text                   = config2.Name or "Slider"
                Lbl.TextColor3             = C.Text
                Lbl.TextSize               = 13
                Lbl.Font                   = Enum.Font.GothamSemibold
                Lbl.TextXAlignment         = Enum.TextXAlignment.Left
                Lbl.ZIndex                 = 14

                local ValLbl = Instance.new("TextLabel", Row)
                ValLbl.Size                   = UDim2.new(0, 55, 0, 20)
                ValLbl.Position               = UDim2.new(1, -68, 0, 8)
                ValLbl.BackgroundTransparency = 1
                ValLbl.Text                   = tostring(val)
                ValLbl.TextColor3             = C.Accent3
                ValLbl.TextSize               = 12
                ValLbl.Font                   = Enum.Font.GothamBold
                ValLbl.TextXAlignment         = Enum.TextXAlignment.Right
                ValLbl.ZIndex                 = 14

                local BarBg = Instance.new("Frame", Row)
                BarBg.Size             = UDim2.new(1, -28, 0, 4)
                BarBg.Position         = UDim2.new(0, 14, 1, -14)
                BarBg.BackgroundColor3 = C.Bg4
                BarBg.BorderSizePixel  = 0
                BarBg.ZIndex           = 14
                makeCorner(BarBg, 4)

                local BarFill2 = Instance.new("Frame", BarBg)
                BarFill2.Size             = UDim2.new((val - min) / (max - min), 0, 1, 0)
                BarFill2.BackgroundColor3 = C.Accent
                BarFill2.BorderSizePixel  = 0
                BarFill2.ZIndex           = 15
                makeCorner(BarFill2, 4)
                Instance.new("UIGradient", BarFill2).Color = ColorSequence.new(C.Accent2, C.Accent3)

                local SliderBtn = Instance.new("TextButton", BarBg)
                SliderBtn.Size                   = UDim2.new(1, 0, 0, 20)
                SliderBtn.Position               = UDim2.new(0, 0, 0.5, -10)
                SliderBtn.BackgroundTransparency = 1
                SliderBtn.Text                   = ""
                SliderBtn.ZIndex                 = 16

                local Slider = {Value = val}

                local function Round(n)
                    if rnd == 0 then return math.floor(n) end
                    return tonumber(string.format("%." .. rnd .. "f", n))
                end

                local function SetPx(px)
                    local pct    = math.clamp(px / BarBg.AbsoluteSize.X, 0, 1)
                    local newVal = Round(min + (max - min) * pct)
                    Slider.Value = newVal
                    ValLbl.Text  = tostring(newVal)
                    BarFill2.Size = UDim2.new(pct, 0, 1, 0)
                    callback(newVal)
                end

                local dragging = false
                SliderBtn.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = true
                        SetPx(Mouse.X - BarBg.AbsolutePosition.X)
                    end
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
                end)
                UserInputService.InputChanged:Connect(function(input)
                    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                        SetPx(Mouse.X - BarBg.AbsolutePosition.X)
                    end
                end)

                function Slider:Set(v)
                    v = math.clamp(Round(v), min, max)
                    Slider.Value  = v
                    ValLbl.Text   = tostring(v)
                    BarFill2.Size = UDim2.new((v - min) / (max - min), 0, 1, 0)
                    callback(v)
                end

                AddRow(Row)
                return Slider
            end

