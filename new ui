        RightList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            RightScroll.CanvasSize = UDim2.new(0, 0, 0, RightList.AbsoluteContentSize.Y + 12)
        end)

        table.insert(Window.Tabs, {
            Btn       = TabBtn,
            Container = TwoCol,
            Underline = TabUnderline,
            Index     = tabIndex,
        })

        local function SelectTab()
            activeTabIndex = tabIndex
            for _, t in ipairs(Window.Tabs) do
                local isActive = (t.Index == activeTabIndex)
                t.Container.Visible          = isActive
                t.Btn.TextColor3             = isActive and C.Text or C.Muted
                t.Btn.BackgroundTransparency = isActive and 0.7 or 1
                t.Underline.Visible          = isActive
            end
        end

        TabBtn.MouseButton1Click:Connect(SelectTab)
        TabBtn.MouseEnter:Connect(function()
            if tabIndex ~= activeTabIndex then
                Tween(TabBtn, {TextColor3 = C.TextSub}, 0.12):Play()
            end
        end)
        TabBtn.MouseLeave:Connect(function()
            if tabIndex ~= activeTabIndex then
                Tween(TabBtn, {TextColor3 = C.Muted}, 0.12):Play()
            end
        end)

        if #Window.Tabs == 1 then SelectTab() end

        -- ── AddSection (pode ser Left ou Right)
        -- column: "Left" (padrão) ou "Right"
        function Tab:AddSection(sectionName, column)
            local Section = {}
            local targetScroll = (column == "Right") and RightScroll or LeftScroll

            -- cabeçalho da seção
            local SecHdr = Instance.new("TextLabel", targetScroll)
