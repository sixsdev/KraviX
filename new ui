        TabUnderline.Position         = UDim2.new(0, 0, 1, -2)
        TabUnderline.BackgroundColor3 = C.Accent
        TabUnderline.BorderSizePixel  = 0
        TabUnderline.ZIndex           = 13
        TabUnderline.Visible          = false

        -- container de duas colunas para esta tab
        local TwoCol = Instance.new("Frame", ContentFrame)
        TwoCol.Size                   = UDim2.new(1, 0, 1, 0)
        TwoCol.BackgroundTransparency = 1
        TwoCol.BorderSizePixel        = 0
        TwoCol.Visible                = false
        TwoCol.ZIndex                 = 11

        -- coluna esquerda
