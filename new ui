    -- ══════════════════════════════════════
    function Window:CreateTab(name, icon)
        local Tab       = {}
        local tabIndex  = #Window.Tabs + 1  -- índice desta tab ANTES de inserir

        -- botão da tab
        local TabBtn = Instance.new("TextButton", TabBar)
        TabBtn.Size                   = UDim2.new(0, 0, 1, 0)
        TabBtn.AutomaticSize          = Enum.AutomaticSize.X
        TabBtn.BackgroundColor3       = C.Bg3
        TabBtn.BackgroundTransparency = 1
        TabBtn.Text                   = (icon and icon .. "  " or "") .. name
        TabBtn.TextColor3             = C.Muted
        TabBtn.TextSize               = 12
        TabBtn.Font                   = Enum.Font.GothamSemibold
        TabBtn.AutoButtonColor        = false
        TabBtn.ZIndex                 = 12
        TabBtn.LayoutOrder            = tabIndex
        makeCorner(TabBtn, 7)

        local TabBtnPad = Instance.new("UIPadding", TabBtn)
        TabBtnPad.PaddingLeft  = UDim.new(0, 12)
        TabBtnPad.PaddingRight = UDim.new(0, 12)

        local TabUnderline = Instance.new("Frame", TabBtn)
        TabUnderline.Size             = UDim2.new(1, 0, 0, 2)
        TabUnderline.Position         = UDim2.new(0, 0, 1, -2)
        TabUnderline.BackgroundColor3 = C.Accent
        TabUnderline.BorderSizePixel  = 0
        TabUnderline.ZIndex           = 13
        TabUnderline.Visible          = false
        makeCorner(TabUnderline, 2)

        -- scroll de conteúdo desta tab
        local TabScroll = Instance.new("ScrollingFrame", ContentFrame)
        TabScroll.Size                 = UDim2.new(1, 0, 1, 0)
        TabScroll.BackgroundTransparency = 1
        TabScroll.BorderSizePixel      = 0
        TabScroll.ScrollBarThickness   = 3
        TabScroll.ScrollBarImageColor3 = C.Accent
        TabScroll.CanvasSize           = UDim2.new(0, 0, 0, 0)
        TabScroll.Visible              = false   -- começa oculto
        TabScroll.ZIndex               = 11

        local ContentList = Instance.new("UIListLayout", TabScroll)
        ContentList.Padding             = UDim.new(0, 8)
        ContentList.SortOrder           = Enum.SortOrder.LayoutOrder
        ContentList.HorizontalAlignment = Enum.HorizontalAlignment.Center
        makePadding(TabScroll, 10, 10, 12, 12)

        ContentList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            TabScroll.CanvasSize = UDim2.new(0, 0, 0, ContentList.AbsoluteContentSize.Y + 20)
        end)

        -- insere na tabela ANTES de definir SelectTab
        -- para que tabIndex bata com a posição real
        table.insert(Window.Tabs, {
            Btn       = TabBtn,
            Scroll    = TabScroll,
            Underline = TabUnderline,
            Index     = tabIndex,
        })

        -- ── FIX PRINCIPAL ──
        -- SelectTab usa o índice numérico para decidir
        -- qual tab está ativa. Não depende de .Visible.
        local function SelectTab()
            activeTabIndex = tabIndex
            for _, t in ipairs(Window.Tabs) do
                local isActive = (t.Index == activeTabIndex)
                t.Scroll.Visible             = isActive
                t.Btn.TextColor3             = isActive and C.Accent3 or C.Muted
                t.Btn.BackgroundTransparency = isActive and 0.85 or 1
                t.Underline.Visible          = isActive
            end
        end

        TabBtn.MouseButton1Click:Connect(SelectTab)

        TabBtn.MouseEnter:Connect(function()
            if tabIndex ~= activeTabIndex then
                Tween(TabBtn, {TextColor3 = C.Text}, 0.15):Play()
            end
        end)
        TabBtn.MouseLeave:Connect(function()
            if tabIndex ~= activeTabIndex then
                Tween(TabBtn, {TextColor3 = C.Muted}, 0.15):Play()
            end
        end)

        -- primeira tab criada já começa selecionada
        if #Window.Tabs == 1 then SelectTab() end

