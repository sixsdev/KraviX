                DarkG.Rotation = 90

                local SatGrad = Instance.new("UIGradient", Canvas)
                SatGrad.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromHSV(hue, 1, 1))

                local CCursor = Instance.new("Frame", Canvas)
                CCursor.Size             = UDim2.new(0, 8, 0, 8)
                CCursor.AnchorPoint      = Vector2.new(0.5, 0.5)
                CCursor.Position         = UDim2.new(sat, 0, 1 - val2, 0)
                CCursor.BackgroundColor3 = C.White
                CCursor.BorderSizePixel  = 1
                CCursor.BorderColor3     = C.Black
                CCursor.ZIndex           = 103
                makeCorner(CCursor, 4)

                local HueBar = Instance.new("ImageButton", PickFrame)
                HueBar.Size             = UDim2.new(0, 16, 1, -30)
                HueBar.Position         = UDim2.new(1, -16, 0, 0)
                HueBar.BackgroundColor3 = C.White
                HueBar.ZIndex           = 101
                makeCorner(HueBar, 4)

                local HueGrad = Instance.new("UIGradient", HueBar)
                HueGrad.Rotation = 90
                HueGrad.Color    = ColorSequence.new({
                    ColorSequenceKeypoint.new(0,    Color3.fromRGB(255, 0,   0)),
                    ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
                    ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0,   255, 0)),
                    ColorSequenceKeypoint.new(0.5,  Color3.fromRGB(0,   255, 255)),
                    ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0,   0,   255)),
                    ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0,   255)),
                    ColorSequenceKeypoint.new(1,    Color3.fromRGB(255, 0,   0)),
                })

                local HCursor = Instance.new("Frame", HueBar)
                HCursor.Size             = UDim2.new(1, 4, 0, 3)
                HCursor.Position         = UDim2.new(0, -2, hue, 0)
                HCursor.BackgroundColor3 = C.White
                HCursor.BorderSizePixel  = 1
                HCursor.BorderColor3     = C.Black
                HCursor.ZIndex           = 102

                local function UpdateColor()
                    local c = Color3.fromHSV(hue, sat, val2)
                    Picker.Value            = c
                    Swatch.BackgroundColor3 = c
                    Canvas.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
                    SatGrad.Color           = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromHSV(hue, 1, 1))
                    CCursor.Position        = UDim2.new(sat, 0, 1 - val2, 0)
                    HCursor.Position        = UDim2.new(0, -2, hue, 0)
                    callback(c)
                end

                local cDrag, hDrag = false, false
                Canvas.InputBegan:Connect(function(i)
                    if i.UserInputType == Enum.UserInputType.MouseButton1 then
                        cDrag = true
                        sat   = math.clamp((Mouse.X - Canvas.AbsolutePosition.X) / Canvas.AbsoluteSize.X, 0, 1)
                        val2  = 1 - math.clamp((Mouse.Y - Canvas.AbsolutePosition.Y) / Canvas.AbsoluteSize.Y, 0, 1)
                        UpdateColor()
                    end
                end)
                HueBar.InputBegan:Connect(function(i)
                    if i.UserInputType == Enum.UserInputType.MouseButton1 then
                        hDrag = true
                        hue   = math.clamp((Mouse.Y - HueBar.AbsolutePosition.Y) / HueBar.AbsoluteSize.Y, 0, 1)
                        UpdateColor()
                    end
                end)
                UserInputService.InputEnded:Connect(function(i)
                    if i.UserInputType == Enum.UserInputType.MouseButton1 then
                        cDrag = false; hDrag = false
                    end
                end)
                UserInputService.InputChanged:Connect(function(i)
                    if i.UserInputType == Enum.UserInputType.MouseMovement then
                        if cDrag then
                            sat  = math.clamp((Mouse.X - Canvas.AbsolutePosition.X) / Canvas.AbsoluteSize.X, 0, 1)
                            val2 = 1 - math.clamp((Mouse.Y - Canvas.AbsolutePosition.Y) / Canvas.AbsoluteSize.Y, 0, 1)
                            UpdateColor()
                        end
                        if hDrag then
                            hue = math.clamp((Mouse.Y - HueBar.AbsolutePosition.Y) / HueBar.AbsoluteSize.Y, 0, 1)
                            UpdateColor()
                        end
                    end
                end)

                Swatch.MouseButton1Click:Connect(function()
                    pickerOpen        = not pickerOpen
                    PickFrame.Visible = pickerOpen
                    if pickerOpen then
                        local abs = Swatch.AbsolutePosition
                        PickFrame.Position = UDim2.fromOffset(abs.X - 140, abs.Y + 32)
                    end
                end)

                UserInputService.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        local mPos = UserInputService:GetMouseLocation()
                        local fp   = PickFrame.AbsolutePosition
                        local fs   = PickFrame.AbsoluteSize
                        if not (mPos.X >= fp.X and mPos.X <= fp.X + fs.X and mPos.Y >= fp.Y and mPos.Y <= fp.Y + fs.Y) then
                            pickerOpen        = false
                            PickFrame.Visible = false
                        end
                    end
                end)

                function Picker:Set(c)
                    Picker.Value = c
                    hue, sat, val2 = c:ToHSV()
                    UpdateColor()
                end

                AddRow(Row)
                return Picker
            end

            -- ── Label ──
            function Section:AddLabel(config2)
                config2 = config2 or {}

                local Lbl = Instance.new("TextLabel")
                Lbl.Size                   = UDim2.new(1, 0, 0, 36)
                Lbl.BackgroundTransparency = 1
                Lbl.Text                   = config2.Text or ""
                Lbl.TextColor3             = config2.Color or C.Muted
                Lbl.TextSize               = 11
                Lbl.Font                   = Enum.Font.Gotham
                Lbl.TextXAlignment         = Enum.TextXAlignment.Left
                Lbl.TextWrapped            = true
                Lbl.ZIndex                 = 13
                makePadding(Lbl, 0, 0, 14, 14)
                AddRow(Lbl)

                return { SetText = function(_, t) Lbl.Text = t end }
            end

            return Section
        end -- AddSection

        return Tab
    end -- CreateTab

    return Window
end -- CreateWindow

