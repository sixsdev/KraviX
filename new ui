            -- ── Keybind (compacto)
            function Section:AddKeybind(config2)
                config2 = config2 or {}
                local currentKey = config2.Default or Enum.KeyCode.E
                local listening  = false
                local callback   = config2.Callback or function() end

                local Row = Instance.new("Frame")
                Row.Size                   = UDim2.new(1, 0, 0, 20)
                Row.BackgroundTransparency = 1
                Row.ZIndex                 = 13

                local Lbl = Instance.new("TextLabel", Row)
                Lbl.Size                   = UDim2.new(0.6, 0, 1, 0)
                Lbl.BackgroundTransparency = 1
                Lbl.Text                   = config2.Name or "Keybind"
                Lbl.TextColor3             = C.TextSub
                Lbl.TextSize               = 10
                Lbl.Font                   = Enum.Font.Gotham
                Lbl.TextXAlignment         = Enum.TextXAlignment.Left
                Lbl.ZIndex                 = 14

                local KeyBtn = Instance.new("TextButton", Row)
                KeyBtn.Size             = UDim2.new(0.4, -2, 1, -2)
                KeyBtn.Position         = UDim2.new(0.6, 2, 0.5, -8)
                KeyBtn.BackgroundColor3 = C.Bg3
                KeyBtn.Text             = currentKey.Name
                KeyBtn.TextColor3       = C.Text
                KeyBtn.TextSize         = 9
                KeyBtn.Font             = Enum.Font.Gotham
                KeyBtn.AutoButtonColor  = false
                KeyBtn.ZIndex           = 14
                makeCorner(KeyBtn, 3)
                makeStroke(KeyBtn, C.Border, 1, 0)

                local Keybind = {Value = currentKey}

                KeyBtn.MouseButton1Click:Connect(function()
                    if not listening then
                        listening = true
                        KeyBtn.Text = "..."
                    end
                end)
                UserInputService.InputBegan:Connect(function(input, processed)
                    if listening and not processed and input.UserInputType == Enum.UserInputType.Keyboard then
                        listening = false; currentKey = input.KeyCode
                        Keybind.Value = currentKey; KeyBtn.Text = currentKey.Name
                        callback(currentKey)
                    end
                end)

                AddItem(Row)
                return Keybind
            end

