                config2 = config2 or {}
                local toggled  = config2.Default  or false
                local callback = config2.Callback or function() end

                local Row = Instance.new("Frame")
                Row.Size                   = UDim2.new(1, 0, 0, 20)
                Row.BackgroundTransparency = 1
                Row.ZIndex                 = 13

                -- círculo toggle estilo radio
                local CircleOuter = Instance.new("Frame", Row)
                CircleOuter.Size             = UDim2.new(0, 14, 0, 14)
                CircleOuter.Position         = UDim2.new(0, 0, 0.5, -7)
                CircleOuter.BackgroundColor3 = C.ToggleOff
                CircleOuter.BorderSizePixel  = 0
                CircleOuter.ZIndex           = 14
                makeCorner(CircleOuter, 7)

                local CircleInner = Instance.new("Frame", CircleOuter)
                CircleInner.Size             = UDim2.new(0, 8, 0, 8)
                CircleInner.AnchorPoint      = Vector2.new(0.5, 0.5)
                CircleInner.Position         = UDim2.new(0.5, 0, 0.5, 0)
                CircleInner.BackgroundColor3 = toggled and C.Accent or C.ToggleOff
                CircleInner.BackgroundTransparency = toggled and 0 or 1
                CircleInner.BorderSizePixel  = 0
                CircleInner.ZIndex           = 15
                makeCorner(CircleInner, 4)

                local Lbl = Instance.new("TextLabel", Row)
                Lbl.Size                   = UDim2.new(1, -80, 1, 0)
                Lbl.Position               = UDim2.new(0, 20, 0, 0)
                Lbl.BackgroundTransparency = 1
                Lbl.Text                   = config2.Name or "Toggle"
                Lbl.TextColor3             = toggled and C.Text or C.TextSub
                Lbl.TextSize               = 11
                Lbl.Font                   = Enum.Font.Gotham
                Lbl.TextXAlignment         = Enum.TextXAlignment.Left
                Lbl.ZIndex                 = 14

                -- campo de keybind opcional ao lado direito
                local KeyLabel
                if config2.Keybind then
                    KeyLabel = Instance.new("TextButton", Row)
                    KeyLabel.Size             = UDim2.new(0, 50, 0, 14)
                    KeyLabel.Position         = UDim2.new(1, -52, 0.5, -7)
                    KeyLabel.BackgroundColor3 = C.Bg4
                    KeyLabel.Text             = config2.Keybind
                    KeyLabel.TextColor3       = C.TextSub
                    KeyLabel.TextSize         = 9
                    KeyLabel.Font             = Enum.Font.Gotham
                    KeyLabel.AutoButtonColor  = false
                    KeyLabel.ZIndex           = 14
                    makeCorner(KeyLabel, 3)
                    makeStroke(KeyLabel, C.Border, 1, 0)
                end

                local Toggle = {Value = toggled}

                local function Update()
                    Tween(CircleOuter, {BackgroundColor3 = Toggle.Value and C.AccentDim or C.ToggleOff}, 0.15):Play()
                    Tween(CircleInner, {BackgroundColor3 = Toggle.Value and C.Accent or C.Muted, BackgroundTransparency = Toggle.Value and 0 or 1}, 0.15):Play()
                    Tween(Lbl, {TextColor3 = Toggle.Value and C.Text or C.TextSub}, 0.15):Play()
                end

                local ClickArea = Instance.new("TextButton", Row)
                ClickArea.Size                   = UDim2.new(1, 0, 1, 0)
                ClickArea.BackgroundTransparency = 1
                ClickArea.Text                   = ""
                ClickArea.ZIndex                 = 16
                ClickArea.MouseButton1Click:Connect(function()
                    Toggle.Value = not Toggle.Value
                    Update()
                    callback(Toggle.Value)
                end)

                function Toggle:Set(val)
                    Toggle.Value = val
                    Update()
                    callback(Toggle.Value)
                end

                AddItem(Row)
                return Toggle
            end

            -- ── Slider (estilo denso: label + valor à direita, barra fina abaixo)
            function Section:AddSlider(config2)
                config2 = config2 or {}
                local min      = config2.Min      or 0
                local max      = config2.Max      or 100
                local val      = config2.Default  or min
                local rnd      = config2.Rounding or 0
                local callback = config2.Callback or function() end

                local Row = Instance.new("Frame")
                Row.Size                   = UDim2.new(1, 0, 0, 32)
                Row.BackgroundTransparency = 1
                Row.ZIndex                 = 13

                local Lbl = Instance.new("TextLabel", Row)
                Lbl.Size                   = UDim2.new(1, 0, 0, 14)
                Lbl.Position               = UDim2.new(0, 0, 0, 2)
                Lbl.BackgroundTransparency = 1
                Lbl.Text                   = config2.Name or "Slider"
                Lbl.TextColor3             = C.TextSub
                Lbl.TextSize               = 10
                Lbl.Font                   = Enum.Font.Gotham
                Lbl.TextXAlignment         = Enum.TextXAlignment.Left
                Lbl.ZIndex                 = 14

                -- valor "atual/max" à direita
                local ValLbl = Instance.new("TextLabel", Row)
                ValLbl.Size                   = UDim2.new(0, 80, 0, 14)
                ValLbl.Position               = UDim2.new(1, -82, 0, 2)
                ValLbl.BackgroundTransparency = 1
                ValLbl.Text                   = tostring(val) .. "/" .. tostring(max)
                ValLbl.TextColor3             = C.TextSub
                ValLbl.TextSize               = 10
                ValLbl.Font                   = Enum.Font.Gotham
                ValLbl.TextXAlignment         = Enum.TextXAlignment.Right
                ValLbl.ZIndex                 = 14

                -- track
                local BarBg = Instance.new("Frame", Row)
                BarBg.Size             = UDim2.new(1, 0, 0, 3)
                BarBg.Position         = UDim2.new(0, 0, 0, 20)
                BarBg.BackgroundColor3 = C.SliderBg
                BarBg.BorderSizePixel  = 0
                BarBg.ZIndex           = 14
                makeCorner(BarBg, 2)

                local BarFill2 = Instance.new("Frame", BarBg)
                BarFill2.Size             = UDim2.new((val - min) / (max - min), 0, 1, 0)
                BarFill2.BackgroundColor3 = C.SliderFg
                BarFill2.BorderSizePixel  = 0
                BarFill2.ZIndex           = 15
                makeCorner(BarFill2, 2)

                local SliderBtn = Instance.new("TextButton", BarBg)
                SliderBtn.Size                   = UDim2.new(1, 0, 0, 16)
                SliderBtn.Position               = UDim2.new(0, 0, 0.5, -8)
                SliderBtn.BackgroundTransparency = 1
                SliderBtn.Text                   = ""
                SliderBtn.ZIndex                 = 16

                local Slider = {Value = val}

                local function Round(n)
                    if rnd == 0 then return math.floor(n) end
                    return tonumber(string.format("%." .. rnd .. "f", n))
                end

                local function SetPx(px)
                    local pct    = math.clamp(px / BarBg.AbsoluteSize.X, 0, 1)
                    local newVal = Round(min + (max - min) * pct)
                    Slider.Value  = newVal
                    ValLbl.Text   = tostring(newVal) .. "/" .. tostring(max)
                    BarFill2.Size = UDim2.new(pct, 0, 1, 0)
                    callback(newVal)
                end

                local dragging = false
                SliderBtn.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = true
                        SetPx(Mouse.X - BarBg.AbsolutePosition.X)
                    end
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
                end)
                UserInputService.InputChanged:Connect(function(input)
                    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                        SetPx(Mouse.X - BarBg.AbsolutePosition.X)
                    end
                end)

                function Slider:Set(v)
                    v = math.clamp(Round(v), min, max)
                    Slider.Value  = v
                    ValLbl.Text   = tostring(v) .. "/" .. tostring(max)
                    BarFill2.Size = UDim2.new((v - min) / (max - min), 0, 1, 0)
                    callback(v)
                end

                AddItem(Row)
                return Slider
            end

            -- ── Dropdown (compacto, estilo caixa com ▼)
            function Section:AddDropdown(config2)
                config2 = config2 or {}
                local options  = config2.Values   or {}
                local selected = config2.Default  or options[1]
                local callback = config2.Callback or function() end
                local opened   = false

                local Row = Instance.new("Frame")
                Row.Size                   = UDim2.new(1, 0, 0, 22)
                Row.BackgroundTransparency = 1
                Row.ZIndex                 = 13

                local Lbl = Instance.new("TextLabel", Row)
                Lbl.Size                   = UDim2.new(0.45, 0, 1, 0)
                Lbl.BackgroundTransparency = 1
                Lbl.Text                   = config2.Name or "Dropdown"
                Lbl.TextColor3             = C.TextSub
                Lbl.TextSize               = 10
                Lbl.Font                   = Enum.Font.Gotham
                Lbl.TextXAlignment         = Enum.TextXAlignment.Left
                Lbl.ZIndex                 = 14

                local SelBtn = Instance.new("TextButton", Row)
                SelBtn.Size             = UDim2.new(0.55, -2, 1, -2)
                SelBtn.Position         = UDim2.new(0.45, 2, 0.5, -9)
                SelBtn.BackgroundColor3 = C.Bg3
                SelBtn.Text             = (selected or "--") .. "  ▼"
                SelBtn.TextColor3       = C.Text
                SelBtn.TextSize         = 10
                SelBtn.Font             = Enum.Font.Gotham
                SelBtn.AutoButtonColor  = false
                SelBtn.ZIndex           = 14
                makeCorner(SelBtn, 3)
                makeStroke(SelBtn, C.Border, 1, 0)

                local Dropdown = {Value = selected}

                local DropFrame = Instance.new("Frame", ScreenGui)
                DropFrame.Size             = UDim2.new(0, 120, 0, #options * 20 + 4)
                DropFrame.BackgroundColor3 = C.Bg3
                DropFrame.BorderSizePixel  = 0
                DropFrame.Visible          = false
                DropFrame.ZIndex           = 100
                makeCorner(DropFrame, 4)
                makeStroke(DropFrame, C.Border, 1, 0)

                local DList = Instance.new("UIListLayout", DropFrame)
                DList.Padding   = UDim.new(0, 0)
                DList.SortOrder = Enum.SortOrder.LayoutOrder
                makePadding(DropFrame, 2, 2, 2, 2)

                for _, opt in ipairs(options) do
                    local OptBtn = Instance.new("TextButton", DropFrame)
                    OptBtn.Size                   = UDim2.new(1, 0, 0, 18)
                    OptBtn.BackgroundColor3       = C.Bg4
                    OptBtn.BackgroundTransparency = 1
                    OptBtn.Text                   = opt
                    OptBtn.TextColor3             = opt == selected and C.Text or C.Muted
                    OptBtn.TextSize               = 10
                    OptBtn.Font                   = Enum.Font.Gotham
                    OptBtn.AutoButtonColor        = false
                    OptBtn.ZIndex                 = 101
                    makeCorner(OptBtn, 3)
                    makePadding(OptBtn, 0, 0, 4, 4)

                    OptBtn.MouseEnter:Connect(function()
                        Tween(OptBtn, {BackgroundTransparency = 0.5, TextColor3 = C.Text}, 0.1):Play()
                    end)
                    OptBtn.MouseLeave:Connect(function()
                        Tween(OptBtn, {BackgroundTransparency = 1, TextColor3 = opt == Dropdown.Value and C.Text or C.Muted}, 0.1):Play()
                    end)
                    OptBtn.MouseButton1Click:Connect(function()
                        Dropdown.Value    = opt
                        SelBtn.Text       = opt .. "  ▼"
                        opened            = false
                        DropFrame.Visible = false
                        callback(opt)
                    end)
                end

                SelBtn.MouseButton1Click:Connect(function()
                    opened = not opened
                    DropFrame.Visible = opened
                    if opened then
                        local abs = SelBtn.AbsolutePosition
                        DropFrame.Position = UDim2.fromOffset(abs.X, abs.Y + SelBtn.AbsoluteSize.Y + 2)
                    end
                end)

                UserInputService.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        local mPos = UserInputService:GetMouseLocation()
                        local fp   = DropFrame.AbsolutePosition
                        local fs   = DropFrame.AbsoluteSize
                        if not (mPos.X >= fp.X and mPos.X <= fp.X + fs.X and mPos.Y >= fp.Y and mPos.Y <= fp.Y + fs.Y) then
                            opened = false; DropFrame.Visible = false
                        end
                    end
                end)

                function Dropdown:Set(val)
                    if table.find(options, val) then
                        Dropdown.Value = val; SelBtn.Text = val .. "  ▼"; callback(val)
                    end
                end

                AddItem(Row)
                return Dropdown
            end

            -- ── Button (compacto, linha simples)
            function Section:AddButton(config2)
