-- ─────────────────────────────────────────
-- Neve
-- ─────────────────────────────────────────
local function StartSnow(parent)
    local FLAKE_COUNT   = 70
    local snowContainer = Instance.new("Frame", parent)
    snowContainer.Size                   = UDim2.new(1, 0, 1, 0)
    snowContainer.BackgroundTransparency = 1
    snowContainer.ClipsDescendants       = true
    snowContainer.ZIndex                 = 0
    snowContainer.Name                   = "SnowContainer"

    local flakes = {}
    for i = 1, FLAKE_COUNT do
        local size = math.random(2, 5)
        local f = Instance.new("Frame", snowContainer)
        f.Size                   = UDim2.new(0, size, 0, size)
        f.BackgroundColor3       = C.White
        f.BackgroundTransparency = math.random(30, 65) / 100
        f.BorderSizePixel        = 0
        f.ZIndex                 = 1
        makeCorner(f, size)
        flakes[i] = {
            frame = f,
            x     = math.random(0, 1000) / 1000,
            y     = math.random(-20, 100) / 100,
            speed = math.random(3, 9) / 1000,
            drift = math.random(-4, 4) / 10000,
        }
        f.Position = UDim2.new(flakes[i].x, 0, flakes[i].y, 0)
    end

    RunService.Heartbeat:Connect(function(dt)
        if not snowContainer or not snowContainer.Parent then return end
        for _, fl in ipairs(flakes) do
            fl.y = fl.y + fl.speed * dt * 60
            fl.x = fl.x + fl.drift * dt * 60
            if fl.y > 1.05 then fl.y = -0.05; fl.x = math.random(0, 1000) / 1000 end
            if fl.x < 0 then fl.x = 1 end
            if fl.x > 1 then fl.x = 0 end
            fl.frame.Position = UDim2.new(fl.x, 0, fl.y, 0)
        end
    end)
end

-- ─────────────────────────────────────────
-- Draggable
-- ─────────────────────────────────────────
local function MakeDraggable(frame, handle)
    handle = handle or frame
    local dragging, dragStart, startPos

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging  = true
            dragStart = input.Position
            startPos  = frame.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement or
            input.UserInputType == Enum.UserInputType.Touch
        ) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

