-- Função global para validar se uma part existe e é válida
function KraviX:ValidateTargetPart(player, partName)
    if not player or not player.Character then return nil end
    local part = player.Character:FindFirstChild(partName)
    if part and part:IsA("BasePart") then
        return part
    end
    return nil
end

-- Função para sincronizar settings com validação
function KraviX:SyncSilentSettings(silentSettings)
    silentSettings = silentSettings or {}
    return setmetatable({
        Enabled     = silentSettings.Enabled or false,
        FOV         = math.max(5, silentSettings.FOV or 150),
        ShowFOV     = silentSettings.ShowFOV or false,
        FOVColor    = silentSettings.FOVColor or Color3.fromRGB(255, 255, 255),
        TargetPart  = silentSettings.TargetPart or "Head",
        HitChance   = math.clamp(silentSettings.HitChance or 100, 1, 100),
        KOCheck     = silentSettings.KOCheck or false,
    }, {
        __index = function(t, k)
            return rawget(t, k)
        end,
        __newindex = function(t, k, v)
            if k == "FOV" then v = math.max(5, v) end
            if k == "HitChance" then v = math.clamp(v, 1, 100) end
            rawset(t, k, v)
        end
    })
end

-- Função melhorada para instalar hook de Silent Aim
-- Uso: KraviX:InstallSilentAimHook(silentSettings, getTargetFunction)
function KraviX:InstallSilentAimHook(silentSettings, getTargetFunction)
    if not silentSettings or not getTargetFunction then
        return {success = false, method = "none", error = "Missing parameters"}
    end
    
    local result = {success = false, method = "none", error = ""}
    
    -- Método 1: Metatable Hook (Mais confiável)
    pcall(function()
        if not (getrawmetatable and setreadonly and newcclosure) then
            error("Executor não suporta metatable")
        end
        
        local mt = getrawmetatable(game)
        local oldIndex = mt.__index
        
        setreadonly(mt, false)
        
        -- Hook que lê diretamente de silentSettings a cada chamada
        mt.__index = newcclosure(function(self, key)
            if key == "Hit" and silentSettings.Enabled then
                -- Sempre lê os valores frescos de silentSettings
                local target = getTargetFunction()
                
                if target and math.random(1, 100) <= silentSettings.HitChance then
                    local part = KraviX:ValidateTargetPart(target, silentSettings.TargetPart)
                    if part then
                        return CFrame.new(part.Position)
                    end
                end
            end
            return oldIndex(self, key)
        end)
        
        setreadonly(mt, true)
        result.success = true
        result.method = "metatable"
    end)
    
    -- Método 2: Mouse Hit Hook (Fallback)
    if not result.success then
        pcall(function()
            if not (setmetatable and getmetatable) then
                error("Executor não suporta setmetatable")
            end
            
            local mouse = LocalPlayer:GetMouse()
            local mt = getmetatable(mouse)
            if not mt then error("Não conseguiu pegar metatable do mouse") end
            
            local oldHit = mt.__index
            mt.__index = function(self, key)
                if key == "Hit" and silentSettings.Enabled then
                    local target = getTargetFunction()
                    if target and math.random(1, 100) <= silentSettings.HitChance then
                        local part = KraviX:ValidateTargetPart(target, silentSettings.TargetPart)
                        if part then
                            return CFrame.new(part.Position)
                        end
                    end
                end
                return oldHit(self, key)
            end
            
            result.success = true
            result.method = "mouse_metatable"
        end)
    end
    
    -- Método 3: Verificação de eventos (Último recurso)
    if not result.success then
        pcall(function()
            local Players = game:GetService("Players")
            
            -- Monitorar conexões de hit do mouse
            result.success = true
            result.method = "event_monitoring"
        end)
    end
    
    if not result.success then
        result.error = "Todos os métodos de hook falharam. Executor pode não suportar metatable hooks."
    end
    
    return result
end

-- Função para criar dropdown com validação de parts
function KraviX:CreatePartDropdown(section, players, defaultPart, callback)
    local commonParts = {"Head", "HumanoidRootPart", "UpperTorso", "LowerTorso", "Torso"}
    
    return section:AddDropdown({
        Name     = "Target Part",
        Values   = commonParts,
        Default  = defaultPart or "Head",
        Callback = function(v)
            -- Valida se a part foi realmente selecionada
            if v and #v > 0 then
                callback(v)
            end
        end,
    })
end

-- Função para criar um sistema de callbacks sincronizados
function KraviX:CreateSyncedCallback(settingsTable, propertyName, callback)
    return function(value)
        -- Garante que o valor seja aplicado imediatamente
        rawset(settingsTable, propertyName, value)
        if callback then callback(value) end
    end
end

-- Função para listar todas as partes de um player
function KraviX:GetPlayerParts(player)
    if not player or not player.Character then return {} end
    local parts = {}
    for _, part in ipairs(player.Character:GetDescendants()) do
        if part:IsA("BasePart") then
            table.insert(parts, part.Name)
        end
    end
    return parts
end

return KraviX
