local HttpService = game:GetService("HttpService")

local function hash(str)
    local h = 0
    for i = 1, #str do
        h = (h * 31 + string.byte(str, i)) % 1000000007
    end
    return tostring(h)
end

local key = tostring(getgenv().KEY or ""):gsub("%s+", "")
if key == "" then
    warn("No key provided")
    return
end

local success, response = pcall(function()
    return game:HttpGet("https://raw.githubusercontent.com/sixsdev/test/refs/heads/main/main")
end)

if not success then
    warn("Error accessing the key server")
    return
end

local data = HttpService:JSONDecode(response)
local keyHash = hash(key)

-- DEBUG (remove depois)
print("KEY:", key)
print("HASH:", keyHash)
print("JSON RESULT:", data[keyHash])

if not data[keyHash] then
    warn("Key invalid")
    game.Players.LocalPlayer:Kick("Key invalid")
    return
end

print("Key ok")

loadstring(game:HttpGet("https://raw.githubusercontent.com/sixsdev/KraviX-Arsenal/refs/heads/main/Main.lua"))()
