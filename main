local KraviX = {}
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local function Tween(obj, props, time, style)
    return TweenService:Create(obj, TweenInfo.new(time or 0.3, style or Enum.EasingStyle.Quint), props)
end

local function CreateNotification(title, text, duration)
    local NotifGui = Instance.new("ScreenGui")
    NotifGui.Name = "KraviXNotif"
    NotifGui.Parent = game.CoreGui
    
    local Notif = Instance.new("Frame")
    Notif.Size = UDim2.new(0, 320, 0, 90)
    Notif.Position = UDim2.new(1, 20, 0, 20)
    Notif.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    Notif.BorderSizePixel = 0
    Notif.Parent = NotifGui
    
    Instance.new("UICorner", Notif).CornerRadius = UDim.new(0, 6)
    
    local Accent = Instance.new("Frame", Notif)
    Accent.Size = UDim2.new(0, 4, 1, 0)
    Accent.BackgroundColor3 = Color3.fromRGB(150, 50, 255)
    Accent.BorderSizePixel = 0
    Instance.new("UICorner", Accent).CornerRadius = UDim.new(0, 6)
    
    local Title = Instance.new("TextLabel", Notif)
    Title.Size = UDim2.new(1, -20, 0, 28)
    Title.Position = UDim2.new(0, 15, 0, 10)
    Title.BackgroundTransparency = 1
    Title.Text = title
    Title.TextColor3 = Color3.fromRGB(255, 255, 255)
    Title.TextSize = 15
    Title.Font = Enum.Font.GothamBold
    Title.TextXAlignment = Enum.TextXAlignment.Left
    
    local Desc = Instance.new("TextLabel", Notif)
    Desc.Size = UDim2.new(1, -20, 0, 45)
    Desc.Position = UDim2.new(0, 15, 0, 35)
    Desc.BackgroundTransparency = 1
    Desc.Text = text
    Desc.TextColor3 = Color3.fromRGB(160, 160, 160)
    Desc.TextSize = 13
    Desc.Font = Enum.Font.Gotham
    Desc.TextXAlignment = Enum.TextXAlignment.Left
    Desc.TextYAlignment = Enum.TextYAlignment.Top
    Desc.TextWrapped = true
    
    Tween(Notif, {Position = UDim2.new(1, -340, 0, 20)}, 0.5, Enum.EasingStyle.Back):Play()
    
    task.delay(duration or 3, function()
        Tween(Notif, {Position = UDim2.new(1, 20, 0, 20)}, 0.4):Play()
        task.wait(0.4)
        NotifGui:Destroy()
    end)
end

function KraviX:CreateWindow(config)
    local Window = {Tabs = {}, Keybind = config.Keybind or Enum.KeyCode.RightControl}
    Window.Notify = CreateNotification
    
    local isMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
    
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "KraviX"
    ScreenGui.Parent = game.CoreGui
    
    
    local Loading = Instance.new("Frame", ScreenGui)
    Loading.Size = UDim2.new(1, 0, 1, 0)
    Loading.BackgroundColor3 = Color3.fromRGB(8, 8, 8)
    Loading.BorderSizePixel = 0
    
    
    for i = 1, 15 do
        local Particle = Instance.new("Frame", Loading)
        Particle.Size = UDim2.new(0, math.random(2, 4), 0, math.random(2, 4))
        Particle.Position = UDim2.new(math.random(0, 100) / 100, 0, math.random(0, 100) / 100, 0)
        Particle.BackgroundColor3 = Color3.fromRGB(150, 50, 255)
        Particle.BorderSizePixel = 0
        Particle.BackgroundTransparency = math.random(30, 70) / 100
        Instance.new("UICorner", Particle).CornerRadius = UDim.new(1, 0)
        
        task.spawn(function()
            while Loading.Parent do
                Tween(Particle, {
                    Position = UDim2.new(math.random(0, 100) / 100, 0, math.random(0, 100) / 100, 0),
                    BackgroundTransparency = math.random(30, 90) / 100
                }, math.random(20, 40) / 10):Play()
                task.wait(math.random(20, 40) / 10)
            end
        end)
    end
    
    local Logo = Instance.new("TextLabel", Loading)
    Logo.Size = UDim2.new(1, 0, 0, 80)
    Logo.Position = UDim2.new(0, 0, 0.5, -80)
    Logo.BackgroundTransparency = 1
    Logo.Text = "KRAVIX"
    Logo.TextColor3 = Color3.fromRGB(255, 255, 255)
    Logo.TextSize = 64
    Logo.Font = Enum.Font.GothamBold
    Logo.TextTransparency = 1
    
    local LogoGradient = Instance.new("UIGradient", Logo)
    LogoGradient.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.fromRGB(180, 100, 255)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(150, 50, 255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(120, 30, 200))
    }
    
    task.spawn(function()
        while Loading.Parent do
            Tween(LogoGradient, {Rotation = 360}, 4, Enum.EasingStyle.Linear):Play()
            task.wait(4)
            LogoGradient.Rotation = 0
        end
    end)
    
    local LoadingText = Instance.new("TextLabel", Loading)
    LoadingText.Size = UDim2.new(1, 0, 0, 30)
    LoadingText.Position = UDim2.new(0, 0, 0.5, 10)
    LoadingText.BackgroundTransparency = 1
    LoadingText.Text = "Loading UI Components..."
    LoadingText.TextColor3 = Color3.fromRGB(140, 140, 140)
    LoadingText.TextSize = 16
    LoadingText.Font = Enum.Font.Gotham
    LoadingText.TextTransparency = 1
    
    local LoadingBar = Instance.new("Frame", Loading)
    LoadingBar.Size = UDim2.new(0, 400, 0, 4)
    LoadingBar.Position = UDim2.new(0.5, -200, 0.5, 60)
    LoadingBar.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    LoadingBar.BorderSizePixel = 0
    LoadingBar.BackgroundTransparency = 1
    Instance.new("UICorner", LoadingBar).CornerRadius = UDim.new(1, 0)
    
    local LoadingFill = Instance.new("Frame", LoadingBar)
    LoadingFill.Size = UDim2.new(0, 0, 1, 0)
    LoadingFill.BackgroundColor3 = Color3.fromRGB(150, 50, 255)
    LoadingFill.BorderSizePixel = 0
    Instance.new("UICorner", LoadingFill).CornerRadius = UDim.new(1, 0)
    
    local FillGradient = Instance.new("UIGradient", LoadingFill)
    FillGradient.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.fromRGB(120, 30, 200)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(180, 100, 255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(120, 30, 200))
    }
    
    task.spawn(function()
        while Loading.Parent do
            Tween(FillGradient, {Offset = Vector2.new(1, 0)}, 1.5, Enum.EasingStyle.Linear):Play()
            task.wait(1.5)
            FillGradient.Offset = Vector2.new(-1, 0)
        end
    end)
    
    local LoadingPercent = Instance.new("TextLabel", Loading)
    LoadingPercent.Size = UDim2.new(1, 0, 0, 25)
    LoadingPercent.Position = UDim2.new(0, 0, 0.5, 80)
    LoadingPercent.BackgroundTransparency = 1
    LoadingPercent.Text = "0%"
    LoadingPercent.TextColor3 = Color3.fromRGB(150, 50, 255)
    LoadingPercent.TextSize = 14
    LoadingPercent.Font = Enum.Font.GothamBold
    LoadingPercent.TextTransparency = 1
    
    
    Tween(Logo, {TextTransparency = 0}, 0.6):Play()
    task.wait(0.3)
    Tween(LoadingText, {TextTransparency = 0}, 0.5):Play()
    Tween(LoadingBar, {BackgroundTransparency = 0}, 0.5):Play()
    Tween(LoadingPercent, {TextTransparency = 0}, 0.5):Play()
    task.wait(0.5)
    
    local messages = {"Initializing...", "Loading Components...", "Preparing Interface...", "Almost Ready..."}
    for i = 1, 100 do
        LoadingFill.Size = UDim2.new(i / 100, 0, 1, 0)
        LoadingPercent.Text = i .. "%"
        if i % 25 == 0 then
            LoadingText.Text = messages[math.floor(i / 25)] or "Loading..."
        end
        task.wait(0.015)
    end
    
    task.wait(0.3)
    Tween(LoadingPercent, {TextTransparency = 1, TextSize = 18}, 0.3):Play()
    Tween(LoadingText, {TextTransparency = 1}, 0.3):Play()
    task.wait(0.2)
    Tween(LoadingBar, {BackgroundTransparency = 1}, 0.3):Play()
    Tween(LoadingFill, {BackgroundTransparency = 1}, 0.3):Play()
    task.wait(0.2)
    Tween(Logo, {TextTransparency = 1, TextSize = 80}, 0.4, Enum.EasingStyle.Back):Play()
    task.wait(0.4)
    Tween(Loading, {BackgroundTransparency = 1}, 0.3):Play()
    task.wait(0.3)
    Loading:Destroy()
    
    
    local Main = Instance.new("Frame", ScreenGui)
    Main.Name = "Main"
    Main.Size = UDim2.new(0, 700, 0, 450)
    Main.Position = UDim2.new(0.5, -350, 0.5, -225)
    Main.BackgroundColor3 = Color3.fromRGB(12, 12, 12)
    Main.BorderSizePixel = 0
    Instance.new("UICorner", Main).CornerRadius = UDim.new(0, 6)
    
    local Stroke = Instance.new("UIStroke", Main)
    Stroke.Color = Color3.fromRGB(150, 50, 255)
    Stroke.Thickness = 1
    Stroke.Transparency = 0.7
    
    
    local TopBar = Instance.new("Frame", Main)
    TopBar.Size = UDim2.new(1, 0, 0, 45)
    TopBar.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    TopBar.BorderSizePixel = 0
    Instance.new("UICorner", TopBar).CornerRadius = UDim.new(0, 6)
    
    local TopFix = Instance.new("Frame", TopBar)
    TopFix.Size = UDim2.new(1, 0, 0, 23)
    TopFix.Position = UDim2.new(0, 0, 1, -23)
    TopFix.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    TopFix.BorderSizePixel = 0
    
    local Title = Instance.new("TextLabel", TopBar)
    Title.Size = UDim2.new(0, 150, 0, 18)
    Title.Position = UDim2.new(0, 15, 0, 6)
    Title.BackgroundTransparency = 1
    Title.Text = "KRAVIX"
    Title.TextColor3 = Color3.fromRGB(255, 255, 255)
    Title.TextSize = 18
    Title.Font = Enum.Font.GothamBold
    Title.TextXAlignment = Enum.TextXAlignment.Left
    
    local TitleGradient = Instance.new("UIGradient", Title)
    TitleGradient.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.fromRGB(180, 100, 255)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(150, 50, 255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(180, 100, 255))
    }
    
    task.spawn(function()
        while Title.Parent do
            Tween(TitleGradient, {Offset = Vector2.new(1, 0)}, 2, Enum.EasingStyle.Linear):Play()
            task.wait(2)
            TitleGradient.Offset = Vector2.new(-1, 0)
        end
    end)
    
    local Subtitle = Instance.new("TextLabel", TopBar)
    Subtitle.Size = UDim2.new(0, 200, 0, 14)
    Subtitle.Position = UDim2.new(0, 15, 0, 26)
    Subtitle.BackgroundTransparency = 1
    Subtitle.Text = config.Name or "Premium UI Library"
    Subtitle.TextColor3 = Color3.fromRGB(100, 100, 100)
    Subtitle.TextSize = 10
    Subtitle.Font = Enum.Font.Gotham
    Subtitle.TextXAlignment = Enum.TextXAlignment.Left
    
    local CloseBtn = Instance.new("TextButton", TopBar)
    CloseBtn.Size = UDim2.new(0, 32, 0, 32)
    CloseBtn.Position = UDim2.new(1, -40, 0.5, -16)
    CloseBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    CloseBtn.Text = "×"
    CloseBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    CloseBtn.TextSize = 20
    CloseBtn.Font = Enum.Font.GothamBold
    Instance.new("UICorner", CloseBtn).CornerRadius = UDim.new(0, 6)
    
    CloseBtn.MouseEnter:Connect(function()
        Tween(CloseBtn, {BackgroundColor3 = Color3.fromRGB(150, 50, 255)}, 0.2):Play()
    end)
    
    CloseBtn.MouseLeave:Connect(function()
        Tween(CloseBtn, {BackgroundColor3 = Color3.fromRGB(20, 20, 20)}, 0.2):Play()
    end)
    
    CloseBtn.MouseButton1Click:Connect(function()
        Window.Visible = false
        Tween(Main, {Size = UDim2.new(0, 0, 0, 0), Position = UDim2.new(0.5, 0, 0.5, 0)}, 0.2, Enum.EasingStyle.Back):Play()
        task.wait(0.2)
        Main.Visible = false
        Main.Size = UDim2.new(0, 700, 0, 450)
        Main.Position = UDim2.new(0.5, -350, 0.5, -225)
        if isMobile and MobileBtn then
            MobileBtn.Visible = true
            Tween(MobileBtn, {Size = UDim2.new(0, 60, 0, 60)}, 0.3, Enum.EasingStyle.Back):Play()
        end
        CreateNotification("KraviX", isMobile and "Tap button to reopen" or "Press " .. Window.Keybind.Name .. " to reopen", 3)
    end)
    
    
    local TabContainer = Instance.new("Frame", Main)
    TabContainer.Size = UDim2.new(0, 150, 1, -55)
    TabContainer.Position = UDim2.new(0, 10, 0, 50)
    TabContainer.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    TabContainer.BorderSizePixel = 0
    Instance.new("UICorner", TabContainer).CornerRadius = UDim.new(0, 6)
    
    local TabList = Instance.new("UIListLayout", TabContainer)
    TabList.Padding = UDim.new(0, 6)
    
    local TabPadding = Instance.new("UIPadding", TabContainer)
    TabPadding.PaddingTop = UDim.new(0, 8)
    TabPadding.PaddingLeft = UDim.new(0, 8)
    TabPadding.PaddingRight = UDim.new(0, 8)
    TabPadding.PaddingBottom = UDim.new(0, 8)
    
    
    local ContentContainer = Instance.new("Frame", Main)
    ContentContainer.Size = UDim2.new(1, -180, 1, -55)
    ContentContainer.Position = UDim2.new(0, 170, 0, 50)
    ContentContainer.BackgroundTransparency = 1
    ContentContainer.BorderSizePixel = 0
    
    
    local dragging, dragInput, dragStart, startPos
    TopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = Main.Position
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    
    UserInputService.InputBegan:Connect(function(input)
        if input.KeyCode == Window.Keybind then
            Main.Visible = not Main.Visible
            if Main.Visible then
                if isMobile and MobileBtn then
                    MobileBtn.Visible = false
                end
                Main.Size = UDim2.new(0, 0, 0, 0)
                Main.Position = UDim2.new(0.5, 0, 0.5, 0)
                Tween(Main, {Size = UDim2.new(0, 700, 0, 450), Position = UDim2.new(0.5, -350, 0.5, -225)}, 0.3, Enum.EasingStyle.Back):Play()
            else
                Tween(Main, {Size = UDim2.new(0, 0, 0, 0), Position = UDim2.new(0.5, 0, 0.5, 0)}, 0.2, Enum.EasingStyle.Back):Play()
                task.wait(0.2)
                Main.Visible = false
                Main.Size = UDim2.new(0, 700, 0, 450)
                Main.Position = UDim2.new(0.5, -350, 0.5, -225)
                if isMobile and MobileBtn then
                    MobileBtn.Visible = true
                    Tween(MobileBtn, {Size = UDim2.new(0, 60, 0, 60)}, 0.3, Enum.EasingStyle.Back):Play()
                end
            end
        end
    end)
    
    -- Botão Mobile
    local MobileBtn
    if isMobile then
        MobileBtn = Instance.new("TextButton", ScreenGui)
        MobileBtn.Size = UDim2.new(0, 0, 0, 0)
        MobileBtn.Position = UDim2.new(0, 20, 0, 100)
        MobileBtn.BackgroundColor3 = Color3.fromRGB(150, 50, 255)
        MobileBtn.Text = "K"
        MobileBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        MobileBtn.TextSize = 24
        MobileBtn.Font = Enum.Font.GothamBold
        MobileBtn.Visible = false
        Instance.new("UICorner", MobileBtn).CornerRadius = UDim.new(0, 12)
        
        local MobileStroke = Instance.new("UIStroke", MobileBtn)
        MobileStroke.Color = Color3.fromRGB(255, 255, 255)
        MobileStroke.Thickness = 2
        MobileStroke.Transparency = 0.5
        
        -- Arrastar botão mobile
        local mobileDragging = false
        local mobileDragStart, mobileStartPos
        
        MobileBtn.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch then
                mobileDragging = true
                mobileDragStart = input.Position
                mobileStartPos = MobileBtn.Position
            end
        end)
        
        UserInputService.InputChanged:Connect(function(input)
            if mobileDragging and input.UserInputType == Enum.UserInputType.Touch then
                local delta = input.Position - mobileDragStart
                MobileBtn.Position = UDim2.new(mobileStartPos.X.Scale, mobileStartPos.X.Offset + delta.X, mobileStartPos.Y.Scale, mobileStartPos.Y.Offset + delta.Y)
            end
        end)
        
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch then
                mobileDragging = false
            end
        end)
        
        MobileBtn.MouseButton1Click:Connect(function()
            MobileBtn.Visible = false
            Main.Visible = true
            Main.Size = UDim2.new(0, 0, 0, 0)
            Main.Position = UDim2.new(0.5, 0, 0.5, 0)
            Tween(Main, {Size = UDim2.new(0, 700, 0, 450), Position = UDim2.new(0.5, -350, 0.5, -225)}, 0.3, Enum.EasingStyle.Back):Play()
        end)
    end
    
    function Window:CreateTab(name)
        local Tab = {}
        
        local TabBtn = Instance.new("TextButton", TabContainer)
        TabBtn.Size = UDim2.new(1, -16, 0, 38)
        TabBtn.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
        TabBtn.Text = name
        TabBtn.TextColor3 = Color3.fromRGB(130, 130, 130)
        TabBtn.TextSize = 13
        TabBtn.Font = Enum.Font.GothamBold
        TabBtn.AutoButtonColor = false
        Instance.new("UICorner", TabBtn).CornerRadius = UDim.new(0, 6)
        
        local TabContent = Instance.new("ScrollingFrame", ContentContainer)
        TabContent.Size = UDim2.new(1, 0, 1, 0)
        TabContent.Position = UDim2.new(0, 0, 0, 0)
        TabContent.BackgroundTransparency = 1
        TabContent.BorderSizePixel = 0
        TabContent.ScrollBarThickness = 4
        TabContent.ScrollBarImageColor3 = Color3.fromRGB(150, 50, 255)
        TabContent.Visible = false
        TabContent.CanvasSize = UDim2.new(0, 0, 0, 0)
        TabContent.ClipsDescendants = true
        
        local ContentList = Instance.new("UIListLayout", TabContent)
        ContentList.Padding = UDim.new(0, 8)
        
        local ContentPadding = Instance.new("UIPadding", TabContent)
        ContentPadding.PaddingTop = UDim.new(0, 5)
        ContentPadding.PaddingRight = UDim.new(0, 6)
        
        ContentList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            TabContent.CanvasSize = UDim2.new(0, 0, 0, ContentList.AbsoluteContentSize.Y + 10)
        end)
        
        TabBtn.MouseEnter:Connect(function()
            if not TabContent.Visible then
                Tween(TabBtn, {BackgroundColor3 = Color3.fromRGB(22, 22, 22)}, 0.2):Play()
            end
        end)
        
        TabBtn.MouseLeave:Connect(function()
            if not TabContent.Visible then
                Tween(TabBtn, {BackgroundColor3 = Color3.fromRGB(18, 18, 18)}, 0.2):Play()
            end
        end)
        
        TabBtn.MouseButton1Click:Connect(function()
            for _, tab in pairs(Window.Tabs) do
                tab.Content.Visible = false
                Tween(tab.Button, {BackgroundColor3 = Color3.fromRGB(18, 18, 18)}, 0.15):Play()
                Tween(tab.Button, {TextColor3 = Color3.fromRGB(130, 130, 130)}, 0.15):Play()
            end
            
            TabContent.Visible = true
            Tween(TabBtn, {BackgroundColor3 = Color3.fromRGB(150, 50, 255)}, 0.15):Play()
            Tween(TabBtn, {TextColor3 = Color3.fromRGB(255, 255, 255)}, 0.15):Play()
        end)
        
        if #Window.Tabs == 0 then
            TabContent.Visible = true
            TabBtn.BackgroundColor3 = Color3.fromRGB(150, 50, 255)
            TabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        end
        
        Tab.Button = TabBtn
        Tab.Content = TabContent
        table.insert(Window.Tabs, Tab)
        
        function Tab:CreateButton(text, callback)
            local Btn = Instance.new("TextButton", TabContent)
            Btn.Size = UDim2.new(1, 0, 0, 38)
            Btn.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
            Btn.Text = text
            Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            Btn.TextSize = 13
            Btn.Font = Enum.Font.GothamSemibold
            Btn.AutoButtonColor = false
            Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 6)
            
            Btn.MouseEnter:Connect(function()
                Tween(Btn, {BackgroundColor3 = Color3.fromRGB(22, 22, 22)}, 0.2):Play()
            end)
            
            Btn.MouseLeave:Connect(function()
                Tween(Btn, {BackgroundColor3 = Color3.fromRGB(18, 18, 18)}, 0.2):Play()
            end)
            
            Btn.MouseButton1Click:Connect(function()
                Tween(Btn, {BackgroundColor3 = Color3.fromRGB(150, 50, 255)}, 0.1):Play()
                task.wait(0.1)
                Tween(Btn, {BackgroundColor3 = Color3.fromRGB(18, 18, 18)}, 0.2):Play()
                callback()
            end)
        end
        
        function Tab:CreateToggle(text, default, callback)
            local toggled = default or false
            
            local Frame = Instance.new("Frame", TabContent)
            Frame.Size = UDim2.new(1, 0, 0, 38)
            Frame.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
            Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 6)
            
            local Label = Instance.new("TextLabel", Frame)
            Label.Size = UDim2.new(1, -60, 1, 0)
            Label.Position = UDim2.new(0, 10, 0, 0)
            Label.BackgroundTransparency = 1
            Label.Text = text
            Label.TextColor3 = Color3.fromRGB(255, 255, 255)
            Label.TextSize = 13
            Label.Font = Enum.Font.GothamSemibold
            Label.TextXAlignment = Enum.TextXAlignment.Left
            
            local ToggleBtn = Instance.new("TextButton", Frame)
            ToggleBtn.Size = UDim2.new(0, 40, 0, 20)
            ToggleBtn.Position = UDim2.new(1, -48, 0.5, -10)
            ToggleBtn.BackgroundColor3 = toggled and Color3.fromRGB(150, 50, 255) or Color3.fromRGB(30, 30, 30)
            ToggleBtn.Text = ""
            Instance.new("UICorner", ToggleBtn).CornerRadius = UDim.new(1, 0)
            
            local Circle = Instance.new("Frame", ToggleBtn)
            Circle.Size = UDim2.new(0, 14, 0, 14)
            Circle.Position = toggled and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
            Circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            Instance.new("UICorner", Circle).CornerRadius = UDim.new(1, 0)
            
            local ToggleObject = {}
            
            ToggleBtn.MouseButton1Click:Connect(function()
                toggled = not toggled
                Tween(ToggleBtn, {BackgroundColor3 = toggled and Color3.fromRGB(150, 50, 255) or Color3.fromRGB(30, 30, 30)}, 0.2):Play()
                Tween(Circle, {Position = toggled and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)}, 0.2):Play()
                callback(toggled)
            end)
            
            function ToggleObject:SetValue(value)
                toggled = value
                Tween(ToggleBtn, {BackgroundColor3 = toggled and Color3.fromRGB(150, 50, 255) or Color3.fromRGB(30, 30, 30)}, 0.2):Play()
                Tween(Circle, {Position = toggled and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)}, 0.2):Play()
            end
            
            return ToggleObject
        end
        
        function Tab:CreateSlider(text, min, max, default, callback)
            local value = default or min
            
            local Frame = Instance.new("Frame", TabContent)
            Frame.Size = UDim2.new(1, 0, 0, 50)
            Frame.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
            Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 6)
            
            local Label = Instance.new("TextLabel", Frame)
            Label.Size = UDim2.new(1, -60, 0, 20)
            Label.Position = UDim2.new(0, 10, 0, 8)
            Label.BackgroundTransparency = 1
            Label.Text = text
            Label.TextColor3 = Color3.fromRGB(255, 255, 255)
            Label.TextSize = 13
            Label.Font = Enum.Font.GothamSemibold
            Label.TextXAlignment = Enum.TextXAlignment.Left
            
            local ValueLabel = Instance.new("TextLabel", Frame)
            ValueLabel.Size = UDim2.new(0, 50, 0, 20)
            ValueLabel.Position = UDim2.new(1, -58, 0, 8)
            ValueLabel.BackgroundTransparency = 1
            ValueLabel.Text = tostring(value)
            ValueLabel.TextColor3 = Color3.fromRGB(150, 50, 255)
            ValueLabel.TextSize = 13
            ValueLabel.Font = Enum.Font.GothamBold
            ValueLabel.TextXAlignment = Enum.TextXAlignment.Right
            
            local SliderBar = Instance.new("Frame", Frame)
            SliderBar.Size = UDim2.new(1, -20, 0, 4)
            SliderBar.Position = UDim2.new(0, 10, 1, -12)
            SliderBar.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
            Instance.new("UICorner", SliderBar).CornerRadius = UDim.new(1, 0)
            
            local Fill = Instance.new("Frame", SliderBar)
            Fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
            Fill.BackgroundColor3 = Color3.fromRGB(150, 50, 255)
            Instance.new("UICorner", Fill).CornerRadius = UDim.new(1, 0)
            
            local dragging = false
            SliderBar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end
            end)
            SliderBar.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
            end)
            
            UserInputService.InputChanged:Connect(function(input)
                if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                    local pos = math.clamp((input.Position.X - SliderBar.AbsolutePosition.X) / SliderBar.AbsoluteSize.X, 0, 1)
                    value = math.floor(min + (max - min) * pos)
                    ValueLabel.Text = tostring(value)
                    Fill.Size = UDim2.new(pos, 0, 1, 0)
                    callback(value)
                end
            end)
        end
        
        function Tab:CreateLabel(text)
            local Label = Instance.new("TextLabel", TabContent)
            Label.Size = UDim2.new(1, 0, 0, 32)
            Label.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
            Label.Text = text
            Label.TextColor3 = Color3.fromRGB(255, 255, 255)
            Label.TextSize = 13
            Label.Font = Enum.Font.GothamSemibold
            Instance.new("UICorner", Label).CornerRadius = UDim.new(0, 6)
            
            return {
                SetText = function(self, newText)
                    Label.Text = newText
                end
            }
        end
        
        function Tab:CreateDropdown(text, options, callback)
            local selected = options[1] or ""
            local opened = false
            
            local Frame = Instance.new("Frame", TabContent)
            Frame.Size = UDim2.new(1, 0, 0, 38)
            Frame.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
            Frame.ClipsDescendants = true
            Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 6)
            
            local Label = Instance.new("TextLabel", Frame)
            Label.Size = UDim2.new(1, -110, 0, 38)
            Label.Position = UDim2.new(0, 10, 0, 0)
            Label.BackgroundTransparency = 1
            Label.Text = text
            Label.TextColor3 = Color3.fromRGB(255, 255, 255)
            Label.TextSize = 13
            Label.Font = Enum.Font.GothamSemibold
            Label.TextXAlignment = Enum.TextXAlignment.Left
            
            local Selected = Instance.new("TextLabel", Frame)
            Selected.Size = UDim2.new(0, 95, 0, 38)
            Selected.Position = UDim2.new(1, -103, 0, 0)
            Selected.BackgroundTransparency = 1
            Selected.Text = selected
            Selected.TextColor3 = Color3.fromRGB(150, 50, 255)
            Selected.TextSize = 12
            Selected.Font = Enum.Font.GothamBold
            Selected.TextXAlignment = Enum.TextXAlignment.Right
            
            local Btn = Instance.new("TextButton", Frame)
            Btn.Size = UDim2.new(1, 0, 0, 38)
            Btn.BackgroundTransparency = 1
            Btn.Text = ""
            
            local OptionsList = Instance.new("Frame", Frame)
            OptionsList.Size = UDim2.new(1, 0, 0, #options * 30)
            OptionsList.Position = UDim2.new(0, 0, 0, 38)
            OptionsList.BackgroundTransparency = 1
            
            local OptionsLayout = Instance.new("UIListLayout", OptionsList)
            OptionsLayout.Padding = UDim.new(0, 2)
            
            for _, option in ipairs(options) do
                local OptBtn = Instance.new("TextButton", OptionsList)
                OptBtn.Size = UDim2.new(1, 0, 0, 28)
                OptBtn.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
                OptBtn.Text = option
                OptBtn.TextColor3 = Color3.fromRGB(170, 170, 170)
                OptBtn.TextSize = 12
                OptBtn.Font = Enum.Font.Gotham
                Instance.new("UICorner", OptBtn).CornerRadius = UDim.new(0, 5)
                
                OptBtn.MouseEnter:Connect(function()
                    Tween(OptBtn, {BackgroundColor3 = Color3.fromRGB(150, 50, 255), TextColor3 = Color3.fromRGB(255, 255, 255)}, 0.2):Play()
                end)
                
                OptBtn.MouseLeave:Connect(function()
                    Tween(OptBtn, {BackgroundColor3 = Color3.fromRGB(15, 15, 15), TextColor3 = Color3.fromRGB(170, 170, 170)}, 0.2):Play()
                end)
                
                OptBtn.MouseButton1Click:Connect(function()
                    selected = option
                    Selected.Text = selected
                    opened = false
                    Tween(Frame, {Size = UDim2.new(1, 0, 0, 38)}, 0.2):Play()
                    callback(selected)
                end)
            end
            
            Btn.MouseButton1Click:Connect(function()
                opened = not opened
                Tween(Frame, {Size = opened and UDim2.new(1, 0, 0, 38 + #options * 30 + (#options - 1) * 2) or UDim2.new(1, 0, 0, 38)}, 0.2):Play()
            end)
        end
        
        function Tab:CreateTextbox(text, placeholder, callback)
            local Frame = Instance.new("Frame", TabContent)
            Frame.Size = UDim2.new(1, 0, 0, 38)
            Frame.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
            Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 6)
            
            local Label = Instance.new("TextLabel", Frame)
            Label.Size = UDim2.new(0, 110, 1, 0)
            Label.Position = UDim2.new(0, 10, 0, 0)
            Label.BackgroundTransparency = 1
            Label.Text = text
            Label.TextColor3 = Color3.fromRGB(255, 255, 255)
            Label.TextSize = 13
            Label.Font = Enum.Font.GothamSemibold
            Label.TextXAlignment = Enum.TextXAlignment.Left
            
            local Input = Instance.new("TextBox", Frame)
            Input.Size = UDim2.new(1, -135, 0, 24)
            Input.Position = UDim2.new(0, 125, 0.5, -12)
            Input.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
            Input.PlaceholderText = placeholder
            Input.PlaceholderColor3 = Color3.fromRGB(90, 90, 90)
            Input.Text = ""
            Input.TextColor3 = Color3.fromRGB(255, 255, 255)
            Input.TextSize = 12
            Input.Font = Enum.Font.Gotham
            Instance.new("UICorner", Input).CornerRadius = UDim.new(0, 5)
            
            local InputPadding = Instance.new("UIPadding", Input)
            InputPadding.PaddingLeft = UDim.new(0, 8)
            
            Input.FocusLost:Connect(function(enter)
                if enter then
                    callback(Input.Text)
                end
            end)
        end
        
        function Tab:CreateKeybind(text, default, callback)
            local currentKey = default or Enum.KeyCode.E
            local listening = false
            
            local Frame = Instance.new("Frame", TabContent)
            Frame.Size = UDim2.new(1, 0, 0, 38)
            Frame.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
            Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 6)
            
            local Label = Instance.new("TextLabel", Frame)
            Label.Size = UDim2.new(1, -110, 1, 0)
            Label.Position = UDim2.new(0, 10, 0, 0)
            Label.BackgroundTransparency = 1
            Label.Text = text
            Label.TextColor3 = Color3.fromRGB(255, 255, 255)
            Label.TextSize = 13
            Label.Font = Enum.Font.GothamSemibold
            Label.TextXAlignment = Enum.TextXAlignment.Left
            
            local KeyBtn = Instance.new("TextButton", Frame)
            KeyBtn.Size = UDim2.new(0, 95, 0, 24)
            KeyBtn.Position = UDim2.new(1, -103, 0.5, -12)
            KeyBtn.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
            KeyBtn.Text = currentKey.Name
            KeyBtn.TextColor3 = Color3.fromRGB(150, 50, 255)
            KeyBtn.TextSize = 12
            KeyBtn.Font = Enum.Font.GothamBold
            Instance.new("UICorner", KeyBtn).CornerRadius = UDim.new(0, 5)
            
            KeyBtn.MouseButton1Click:Connect(function()
                listening = true
                KeyBtn.Text = "..."
                KeyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            end)
            
            local connection
            connection = UserInputService.InputBegan:Connect(function(input)
                if listening and input.UserInputType == Enum.UserInputType.Keyboard then
                    listening = false
                    currentKey = input.KeyCode
                    KeyBtn.Text = currentKey.Name
                    KeyBtn.TextColor3 = Color3.fromRGB(150, 50, 255)
                    callback(currentKey)
                end
            end)
        end
        
        function Tab:CreateColorPicker(text, default, callback)
            local currentColor = default or Color3.fromRGB(255, 255, 255)
            local pickerOpen = false
            
            local Frame = Instance.new("Frame", TabContent)
            Frame.Size = UDim2.new(1, 0, 0, 38)
            Frame.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
            Frame.ClipsDescendants = true
            Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 6)
            
            local Label = Instance.new("TextLabel", Frame)
            Label.Size = UDim2.new(1, -110, 0, 38)
            Label.Position = UDim2.new(0, 10, 0, 0)
            Label.BackgroundTransparency = 1
            Label.Text = text
            Label.TextColor3 = Color3.fromRGB(255, 255, 255)
            Label.TextSize = 13
            Label.Font = Enum.Font.GothamSemibold
            Label.TextXAlignment = Enum.TextXAlignment.Left
            
            local ColorBox = Instance.new("TextButton", Frame)
            ColorBox.Size = UDim2.new(0, 95, 0, 24)
            ColorBox.Position = UDim2.new(1, -103, 0, 7)
            ColorBox.BackgroundColor3 = currentColor
            ColorBox.Text = ""
            Instance.new("UICorner", ColorBox).CornerRadius = UDim.new(0, 5)
            
            local ColorStroke = Instance.new("UIStroke", ColorBox)
            ColorStroke.Color = Color3.fromRGB(255, 255, 255)
            ColorStroke.Thickness = 1
            ColorStroke.Transparency = 0.7
            
            -- Picker Container
            local PickerContainer = Instance.new("Frame", Frame)
            PickerContainer.Size = UDim2.new(1, -20, 0, 180)
            PickerContainer.Position = UDim2.new(0, 10, 0, 45)
            PickerContainer.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
            Instance.new("UICorner", PickerContainer).CornerRadius = UDim.new(0, 5)
            
            -- Gradient Canvas
            local Canvas = Instance.new("ImageButton", PickerContainer)
            Canvas.Size = UDim2.new(1, -70, 1, -40)
            Canvas.Position = UDim2.new(0, 10, 0, 10)
            Canvas.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            Instance.new("UICorner", Canvas).CornerRadius = UDim.new(0, 4)
            
            local CanvasGradient = Instance.new("UIGradient", Canvas)
            CanvasGradient.Color = ColorSequence.new(Color3.fromRGB(255, 0, 0), Color3.fromRGB(255, 0, 0))
            CanvasGradient.Rotation = 0
            
            local Darkness = Instance.new("Frame", Canvas)
            Darkness.Size = UDim2.new(1, 0, 1, 0)
            Darkness.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
            Darkness.BackgroundTransparency = 0
            Instance.new("UICorner", Darkness).CornerRadius = UDim.new(0, 4)
            
            local DarknessGradient = Instance.new("UIGradient", Darkness)
            DarknessGradient.Transparency = NumberSequence.new{
                NumberSequenceKeypoint.new(0, 1),
                NumberSequenceKeypoint.new(1, 0)
            }
            DarknessGradient.Rotation = 90
            
            local Cursor = Instance.new("Frame", Canvas)
            Cursor.Size = UDim2.new(0, 8, 0, 8)
            Cursor.Position = UDim2.new(1, -4, 0, -4)
            Cursor.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            Cursor.BorderSizePixel = 2
            Cursor.BorderColor3 = Color3.fromRGB(0, 0, 0)
            Instance.new("UICorner", Cursor).CornerRadius = UDim.new(1, 0)
            
            -- Hue Slider
            local HueSlider = Instance.new("ImageButton", PickerContainer)
            HueSlider.Size = UDim2.new(0, 20, 1, -40)
            HueSlider.Position = UDim2.new(1, -30, 0, 10)
            HueSlider.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            Instance.new("UICorner", HueSlider).CornerRadius = UDim.new(0, 4)
            
            local HueGradient = Instance.new("UIGradient", HueSlider)
            HueGradient.Color = ColorSequence.new{
                ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
                ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
                ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
                ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 255, 255)),
                ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
                ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0))
            }
            HueGradient.Rotation = 90
            
            local HueCursor = Instance.new("Frame", HueSlider)
            HueCursor.Size = UDim2.new(1, 4, 0, 3)
            HueCursor.Position = UDim2.new(0, -2, 0, 0)
            HueCursor.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            HueCursor.BorderSizePixel = 1
            HueCursor.BorderColor3 = Color3.fromRGB(0, 0, 0)
            
            -- RGB Inputs
            local RGBContainer = Instance.new("Frame", PickerContainer)
            RGBContainer.Size = UDim2.new(1, -20, 0, 25)
            RGBContainer.Position = UDim2.new(0, 10, 1, -30)
            RGBContainer.BackgroundTransparency = 1
            
            local function createRGBInput(pos, letter, value)
                local Input = Instance.new("TextBox", RGBContainer)
                Input.Size = UDim2.new(0, 50, 0, 22)
                Input.Position = UDim2.new(0, pos, 0, 0)
                Input.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
                Input.Text = tostring(value)
                Input.TextColor3 = Color3.fromRGB(255, 255, 255)
                Input.TextSize = 11
                Input.Font = Enum.Font.Gotham
                Input.PlaceholderText = letter
                Instance.new("UICorner", Input).CornerRadius = UDim.new(0, 4)
                
                local InputLabel = Instance.new("TextLabel", Input)
                InputLabel.Size = UDim2.new(0, 15, 1, 0)
                InputLabel.Position = UDim2.new(0, -18, 0, 0)
                InputLabel.BackgroundTransparency = 1
                InputLabel.Text = letter
                InputLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
                InputLabel.TextSize = 11
                InputLabel.Font = Enum.Font.GothamBold
                
                return Input
            end
            
            local RInput = createRGBInput(20, "R", math.floor(currentColor.R * 255))
            local GInput = createRGBInput(90, "G", math.floor(currentColor.G * 255))
            local BInput = createRGBInput(160, "B", math.floor(currentColor.B * 255))
            
            local function updateColor(color)
                currentColor = color
                ColorBox.BackgroundColor3 = color
                RInput.Text = tostring(math.floor(color.R * 255))
                GInput.Text = tostring(math.floor(color.G * 255))
                BInput.Text = tostring(math.floor(color.B * 255))
                callback(color)
            end
            
            local hue, sat, val = 0, 1, 1
            
            local function updateFromHSV()
                local color = Color3.fromHSV(hue, sat, val)
                updateColor(color)
                CanvasGradient.Color = ColorSequence.new(Color3.fromHSV(hue, 1, 1), Color3.fromHSV(hue, 1, 1))
            end
            
            -- Canvas Dragging
            local canvasDragging = false
            Canvas.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    canvasDragging = true
                end
            end)
            
            Canvas.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    canvasDragging = false
                end
            end)
            
            UserInputService.InputChanged:Connect(function(input)
                if canvasDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                    local posX = math.clamp((input.Position.X - Canvas.AbsolutePosition.X) / Canvas.AbsoluteSize.X, 0, 1)
                    local posY = math.clamp((input.Position.Y - Canvas.AbsolutePosition.Y) / Canvas.AbsoluteSize.Y, 0, 1)
                    sat = posX
                    val = 1 - posY
                    Cursor.Position = UDim2.new(posX, -4, posY, -4)
                    updateFromHSV()
                end
            end)
            
            -- Hue Dragging
            local hueDragging = false
            HueSlider.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    hueDragging = true
                end
            end)
            
            HueSlider.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    hueDragging = false
                end
            end)
            
            UserInputService.InputChanged:Connect(function(input)
                if hueDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                    local posY = math.clamp((input.Position.Y - HueSlider.AbsolutePosition.Y) / HueSlider.AbsoluteSize.Y, 0, 1)
                    hue = posY
                    HueCursor.Position = UDim2.new(0, -2, posY, -1.5)
                    updateFromHSV()
                end
            end)
            
            -- RGB Input Changes
            local function onRGBChange()
                local r = math.clamp(tonumber(RInput.Text) or 0, 0, 255)
                local g = math.clamp(tonumber(GInput.Text) or 0, 0, 255)
                local b = math.clamp(tonumber(BInput.Text) or 0, 0, 255)
                local color = Color3.fromRGB(r, g, b)
                hue, sat, val = color:ToHSV()
                updateColor(color)
                Cursor.Position = UDim2.new(sat, -4, 1 - val, -4)
                HueCursor.Position = UDim2.new(0, -2, hue, -1.5)
                CanvasGradient.Color = ColorSequence.new(Color3.fromHSV(hue, 1, 1), Color3.fromHSV(hue, 1, 1))
            end
            
            RInput.FocusLost:Connect(onRGBChange)
            GInput.FocusLost:Connect(onRGBChange)
            BInput.FocusLost:Connect(onRGBChange)
            
            -- Toggle Picker
            ColorBox.MouseButton1Click:Connect(function()
                pickerOpen = not pickerOpen
                Tween(Frame, {Size = pickerOpen and UDim2.new(1, 0, 0, 233) or UDim2.new(1, 0, 0, 38)}, 0.2):Play()
            end)
            
            -- Initialize
            hue, sat, val = currentColor:ToHSV()
            Cursor.Position = UDim2.new(sat, -4, 1 - val, -4)
            HueCursor.Position = UDim2.new(0, -2, hue, -1.5)
            CanvasGradient.Color = ColorSequence.new(Color3.fromHSV(hue, 1, 1), Color3.fromHSV(hue, 1, 1))
            
            return {
                SetColor = function(self, color)
                    currentColor = color
                    ColorBox.BackgroundColor3 = color
                    hue, sat, val = color:ToHSV()
                    Cursor.Position = UDim2.new(sat, -4, 1 - val, -4)
                    HueCursor.Position = UDim2.new(0, -2, hue, -1.5)
                    CanvasGradient.Color = ColorSequence.new(Color3.fromHSV(hue, 1, 1), Color3.fromHSV(hue, 1, 1))
                    RInput.Text = tostring(math.floor(color.R * 255))
                    GInput.Text = tostring(math.floor(color.G * 255))
                    BInput.Text = tostring(math.floor(color.B * 255))
                    callback(color)
                end
            }
        end
        
        return Tab
    end
    
    CreateNotification("KraviX", "Loaded! Press " .. Window.Keybind.Name .. " to toggle", 3)
    return Window
end

return KraviX
