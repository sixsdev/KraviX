local KraviX = {}

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Theme = {
    Bg = Color3.fromRGB(18,19,24),
    Top = Color3.fromRGB(22,23,28),
    Panel = Color3.fromRGB(20,21,26),
    Text = Color3.fromRGB(235,235,235),
    Muted = Color3.fromRGB(150,150,150),
    Yellow = Color3.fromRGB(255,204,77),
    Purple = Color3.fromRGB(160,120,255),
    Font = Enum.Font.Gotham,
    FontBold = Enum.Font.GothamSemibold
}

function KraviX:CreateWindow(config)
    local Window = {}
    Window.Tabs = {}

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "KraviX_Givenchy"
    ScreenGui.Parent = game.CoreGui

    -- MAIN
    local Main = Instance.new("Frame", ScreenGui)
    Main.Size = UDim2.new(0, 920, 0, 520)
    Main.Position = UDim2.new(0.5, -460, 0.5, -260)
    Main.BackgroundColor3 = Theme.Bg
    Main.BorderSizePixel = 0
    Instance.new("UICorner", Main).CornerRadius = UDim.new(0,6)

    -- TOP BAR
    local TopBar = Instance.new("Frame", Main)
    TopBar.Size = UDim2.new(1,0,0,48)
    TopBar.BackgroundColor3 = Theme.Top
    TopBar.BorderSizePixel = 0

    local Title = Instance.new("TextLabel", TopBar)
    Title.Size = UDim2.new(0,200,1,0)
    Title.Position = UDim2.new(0,16,0,0)
    Title.BackgroundTransparency = 1
    Title.Text = config.Title or "Givenchy"
    Title.Font = Theme.FontBold
    Title.TextSize = 18
    Title.TextColor3 = Theme.Text
    Title.TextXAlignment = Enum.TextXAlignment.Left

    -- TAB HOLDER (HORIZONTAL TOP)
    local TabHolder = Instance.new("Frame", TopBar)
    TabHolder.Size = UDim2.new(0,500,1,0)
    TabHolder.Position = UDim2.new(0,240,0,0)
    TabHolder.BackgroundTransparency = 1

    local TabLayout = Instance.new("UIListLayout", TabHolder)
    TabLayout.FillDirection = Enum.FillDirection.Horizontal
    TabLayout.Padding = UDim.new(0,26)
    TabLayout.VerticalAlignment = Enum.VerticalAlignment.Center

    -- CONTENT AREA
    local Content = Instance.new("Frame", Main)
    Content.Size = UDim2.new(1,-40,1,-64)
    Content.Position = UDim2.new(0,20,0,56)
    Content.BackgroundTransparency = 1

    -- LEFT PANEL
    local LeftPanel = Instance.new("Frame", Content)
    LeftPanel.Size = UDim2.new(0.48,0,1,0)
    LeftPanel.BackgroundColor3 = Theme.Panel
    LeftPanel.BorderSizePixel = 0
    Instance.new("UICorner", LeftPanel).CornerRadius = UDim.new(0,4)

    local LPadding = Instance.new("UIPadding", LeftPanel)
    LPadding.PaddingTop = UDim.new(0,12)
    LPadding.PaddingLeft = UDim.new(0,12)
    LPadding.PaddingRight = UDim.new(0,12)

    local LLayout = Instance.new("UIListLayout", LeftPanel)
    LLayout.Padding = UDim.new(0,6)

    -- RIGHT PANEL
    local RightPanel = Instance.new("Frame", Content)
    RightPanel.Size = UDim2.new(0.48,0,1,0)
    RightPanel.Position = UDim2.new(0.52,0,0,0)
    RightPanel.BackgroundColor3 = Theme.Panel
    RightPanel.BorderSizePixel = 0
    Instance.new("UICorner", RightPanel).CornerRadius = UDim.new(0,4)

    local RPadding = Instance.new("UIPadding", RightPanel)
    RPadding.PaddingTop = UDim.new(0,12)
    RPadding.PaddingLeft = UDim.new(0,12)
    RPadding.PaddingRight = UDim.new(0,12)

    local RLayout = Instance.new("UIListLayout", RightPanel)
    RLayout.Padding = UDim.new(0,10)

    -- CREATE TAB
    function Window:CreateTab(name)
        local Tab = {}
        Tab.Name = name

        -- TAB BUTTON (TOP)
        local TabButton = Instance.new("TextButton", TabHolder)
        TabButton.Size = UDim2.new(0,80,1,0)
        TabButton.BackgroundTransparency = 1
        TabButton.Text = name
        TabButton.Font = Theme.FontBold
        TabButton.TextSize = 13
        TabButton.TextColor3 = Theme.Muted
        TabButton.AutoButtonColor = false

        -- CONTENT FOLDER
        local TabContent = Instance.new("Folder", Content)
        TabContent.Name = name

        Tab.Button = TabButton
        Tab.Content = TabContent

        table.insert(Window.Tabs, Tab)

        return Tab
    end

    Window.Main = Main
    Window.LeftPanel = LeftPanel
    Window.RightPanel = RightPanel

    return Window
end

return KraviX
