--// KraviX UI - 1:1 Image Style

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")

if game.CoreGui:FindFirstChild("KraviX_UI") then
    game.CoreGui.KraviX_UI:Destroy()
end

local Theme = {
    Bg = Color3.fromRGB(17,17,20),
    Top = Color3.fromRGB(22,22,26),
    Panel = Color3.fromRGB(20,20,24),
    Item = Color3.fromRGB(24,24,28),

    Text = Color3.fromRGB(255,255,255),
    Muted = Color3.fromRGB(160,160,160),

    Accent = Color3.fromRGB(255,205,80), -- amarelo da imagem
    Stroke = Color3.fromRGB(35,35,40),

    Font = Enum.Font.Gotham,
    FontBold = Enum.Font.GothamBold
}

-- GUI
local Gui = Instance.new("ScreenGui", game.CoreGui)
Gui.Name = "KraviX_UI"
Gui.ResetOnSpawn = false

-- MAIN
local Main = Instance.new("Frame", Gui)
Main.Size = UDim2.new(0, 880, 0, 520)
Main.Position = UDim2.new(0.5, -440, 0.5, -260)
Main.BackgroundColor3 = Theme.Bg
Main.BorderSizePixel = 0
Main.Active = true
Main.Draggable = true
Instance.new("UICorner", Main).CornerRadius = UDim.new(0,10)

local Stroke = Instance.new("UIStroke", Main)
Stroke.Color = Theme.Stroke
Stroke.Thickness = 1

-- TOP BAR
local Top = Instance.new("Frame", Main)
Top.Size = UDim2.new(1,0,0,48)
Top.BackgroundColor3 = Theme.Top
Top.BorderSizePixel = 0
Instance.new("UICorner", Top).CornerRadius = UDim.new(0,10)

local Fix = Instance.new("Frame", Top)
Fix.Size = UDim2.new(1,0,0,20)
Fix.Position = UDim2.new(0,0,1,-20)
Fix.BackgroundColor3 = Theme.Top
Fix.BorderSizePixel = 0

local Title = Instance.new("TextLabel", Top)
Title.Size = UDim2.new(0,200,1,0)
Title.Position = UDim2.new(0,16,0,0)
Title.BackgroundTransparency = 1
Title.Text = "Givenchy"
Title.Font = Theme.FontBold
Title.TextSize = 18
Title.TextColor3 = Theme.Text
Title.TextXAlignment = Enum.TextXAlignment.Left

-- TOP TABS
local Tabs = {"Combat","Visuals","Exploits","Misc"}
local TabHolder = Instance.new("Frame", Top)
TabHolder.Size = UDim2.new(0,400,1,0)
TabHolder.Position = UDim2.new(0,200,0,0)
TabHolder.BackgroundTransparency = 1

local TabLayout = Instance.new("UIListLayout", TabHolder)
TabLayout.FillDirection = Enum.FillDirection.Horizontal
TabLayout.Padding = UDim.new(0,20)
TabLayout.VerticalAlignment = Enum.VerticalAlignment.Center

for _,name in ipairs(Tabs) do
    local T = Instance.new("TextButton", TabHolder)
    T.BackgroundTransparency = 1
    T.Text = name
    T.Font = Theme.FontBold
    T.TextSize = 13
    T.TextColor3 = name == "Visuals" and Theme.Text or Theme.Muted
    T.AutoButtonColor = false
end

-- CONTENT
local Content = Instance.new("Frame", Main)
Content.Size = UDim2.new(1,-40,1,-70)
Content.Position = UDim2.new(0,20,0,58)
Content.BackgroundTransparency = 1

-- LEFT PANEL
local Left = Instance.new("Frame", Content)
Left.Size = UDim2.new(0.48,0,1,0)
Left.BackgroundColor3 = Theme.Panel
Left.BorderSizePixel = 0
Instance.new("UICorner", Left).CornerRadius = UDim.new(0,8)

local LL = Instance.new("UIListLayout", Left)
LL.Padding = UDim.new(0,6)

local LP = Instance.new("UIPadding", Left)
LP.PaddingTop = UDim.new(0,10)
LP.PaddingLeft = UDim.new(0,10)
LP.PaddingRight = UDim.new(0,10)

-- RIGHT PANEL
local Right = Instance.new("Frame", Content)
Right.Size = UDim2.new(0.48,0,1,0)
Right.Position = UDim2.new(0.52,0,0,0)
Right.BackgroundColor3 = Theme.Panel
Right.BorderSizePixel = 0
Instance.new("UICorner", Right).CornerRadius = UDim.new(0,8)

local RL = Instance.new("UIListLayout", Right)
RL.Padding = UDim.new(0,10)

local RP = Instance.new("UIPadding", Right)
RP.PaddingTop = UDim.new(0,10)
RP.PaddingLeft = UDim.new(0,10)
RP.PaddingRight = UDim.new(0,10)

-- DROPDOWN (Player Filter)
local function Dropdown(text, value)
    local F = Instance.new("Frame", Left)
    F.Size = UDim2.new(1,0,0,36)
    F.BackgroundColor3 = Theme.Item
    Instance.new("UICorner", F).CornerRadius = UDim.new(0,6)

    local L = Instance.new("TextLabel", F)
    L.Size = UDim2.new(0.6,0,1,0)
    L.Position = UDim2.new(0,10,0,0)
    L.BackgroundTransparency = 1
    L.Text = text
    L.Font = Theme.Font
    L.TextSize = 13
    L.TextColor3 = Theme.Text
    L.TextXAlignment = Enum.TextXAlignment.Left

    local V = Instance.new("TextLabel", F)
    V.Size = UDim2.new(0.35,0,1,0)
    V.Position = UDim2.new(0.65,0,0,0)
    V.BackgroundTransparency = 1
    V.Text = value
    V.Font = Theme.FontBold
    V.TextSize = 12
    V.TextColor3 = Theme.Accent
    V.TextXAlignment = Enum.TextXAlignment.Right
end

-- TOGGLE
local function Toggle(text, on)
    local F = Instance.new("Frame", Left)
    F.Size = UDim2.new(1,0,0,36)
    F.BackgroundColor3 = Theme.Item
    Instance.new("UICorner", F).CornerRadius = UDim.new(0,6)

    local L = Instance.new("TextLabel", F)
    L.Size = UDim2.new(1,-60,1,0)
    L.Position = UDim2.new(0,10,0,0)
    L.BackgroundTransparency = 1
    L.Text = text
    L.Font = Theme.Font
    L.TextSize = 13
    L.TextColor3 = Theme.Text
    L.TextXAlignment = Enum.TextXAlignment.Left

    local Dot = Instance.new("Frame", F)
    Dot.Size = UDim2.new(0,8,0,8)
    Dot.Position = UDim2.new(1,-20,0.5,-4)
    Dot.BackgroundColor3 = on and Theme.Accent or Color3.fromRGB(80,80,80)
    Instance.new("UICorner", Dot).CornerRadius = UDim.new(1,0)
end

-- LEFT CONTENT (igual foto)
Dropdown("Player Filter", "Everyone Except Local")
Toggle("Box", true)
Toggle("Filled Box", false)
Toggle("Gradient", false)
Toggle("Display Username", true)
Toggle("Distance", true)
Toggle("Tool", false)
Toggle("Weapon Icon", false)

