local KraviX = {}
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local Tween = function(obj, props, time, style)
    return TweenService:Create(obj, TweenInfo.new(time or 0.3, style or Enum.EasingStyle.Quint, Enum.EasingDirection.Out), props)
end

local function CreateNotification(title, text, duration)
    local NotifGui = Instance.new("ScreenGui")
    NotifGui.Name = "KraviXNotif"
    NotifGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    NotifGui.Parent = game.CoreGui
    
    local Notif = Instance.new("Frame")
    Notif.Size = UDim2.new(0, 320, 0, 90)
    Notif.Position = UDim2.new(1, 20, 0, 20)
    Notif.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    Notif.BorderSizePixel = 0
    Notif.Parent = NotifGui
    
    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 6)
    Corner.Parent = Notif
    
    local Accent = Instance.new("Frame")
    Accent.Size = UDim2.new(0, 4, 1, 0)
    Accent.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
    Accent.BorderSizePixel = 0
    Accent.Parent = Notif
    
    local AccentCorner = Instance.new("UICorner")
    AccentCorner.CornerRadius = UDim.new(0, 6)
    AccentCorner.Parent = Accent
    
    local Title = Instance.new("TextLabel")
    Title.Size = UDim2.new(1, -20, 0, 28)
    Title.Position = UDim2.new(0, 15, 0, 10)
    Title.BackgroundTransparency = 1
    Title.Text = title
    Title.TextColor3 = Color3.fromRGB(255, 255, 255)
    Title.TextSize = 15
    Title.Font = Enum.Font.GothamBold
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.Parent = Notif
    
    local Text = Instance.new("TextLabel")
    Text.Size = UDim2.new(1, -20, 0, 45)
    Text.Position = UDim2.new(0, 15, 0, 35)
    Text.BackgroundTransparency = 1
    Text.Text = text
    Text.TextColor3 = Color3.fromRGB(160, 160, 160)
    Text.TextSize = 13
    Text.Font = Enum.Font.Gotham
    Text.TextXAlignment = Enum.TextXAlignment.Left
    Text.TextYAlignment = Enum.TextYAlignment.Top
    Text.TextWrapped = true
    Text.Parent = Notif
    
    Tween(Notif, {Position = UDim2.new(1, -340, 0, 20)}, 0.5, Enum.EasingStyle.Back):Play()
    
    task.delay(duration or 3, function()
        Tween(Notif, {Position = UDim2.new(1, 20, 0, 20)}, 0.4):Play()
        task.wait(0.4)
        NotifGui:Destroy()
    end)
end

function KraviX:CreateWindow(config)
    local Window = {Visible = true, Keybind = config.Keybind or Enum.KeyCode.RightControl}
    
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "KraviX"
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    ScreenGui.Parent = game.CoreGui
    
    local LoadingFrame = Instance.new("Frame")
    LoadingFrame.Size = UDim2.new(1, 0, 1, 0)
    LoadingFrame.BackgroundColor3 = Color3.fromRGB(8, 8, 8)
    LoadingFrame.BorderSizePixel = 0
    LoadingFrame.Parent = ScreenGui
    
    local Particles = {}
    for i = 1, 15 do
        local Particle = Instance.new("Frame")
        Particle.Size = UDim2.new(0, math.random(2, 4), 0, math.random(2, 4))
        Particle.Position = UDim2.new(math.random(0, 100) / 100, 0, math.random(0, 100) / 100, 0)
        Particle.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
        Particle.BorderSizePixel = 0
        Particle.BackgroundTransparency = math.random(30, 70) / 100
        Particle.Parent = LoadingFrame
        
        local ParticleCorner = Instance.new("UICorner")
        ParticleCorner.CornerRadius = UDim.new(1, 0)
        ParticleCorner.Parent = Particle
        
        table.insert(Particles, Particle)
        
        task.spawn(function()
            while LoadingFrame.Parent do
                Tween(Particle, {
                    Position = UDim2.new(math.random(0, 100) / 100, 0, math.random(0, 100) / 100, 0),
                    BackgroundTransparency = math.random(30, 90) / 100
                }, math.random(20, 40) / 10):Play()
                task.wait(math.random(20, 40) / 10)
            end
        end)
    end
    
    local LoadingBox = Instance.new("Frame")
    LoadingBox.Size = UDim2.new(0, 450, 0, 250)
    LoadingBox.Position = UDim2.new(0.5, -225, 0.5, -125)
    LoadingBox.BackgroundColor3 = Color3.fromRGB(12, 12, 12)
    LoadingBox.BorderSizePixel = 0
    LoadingBox.BackgroundTransparency = 1
    LoadingBox.Parent = LoadingFrame
    
    local BoxCorner = Instance.new("UICorner")
    BoxCorner.CornerRadius = UDim.new(0, 8)
    BoxCorner.Parent = LoadingBox
    
    local BoxStroke = Instance.new("UIStroke")
    BoxStroke.Color = Color3.fromRGB(200, 0, 0)
    BoxStroke.Thickness = 1.5
    BoxStroke.Transparency = 1
    BoxStroke.Parent = LoadingBox
    
    Tween(LoadingBox, {BackgroundTransparency = 0}, 0.5):Play()
    Tween(BoxStroke, {Transparency = 0.5}, 0.5):Play()
    task.wait(0.3)
    
    local LoadingLogo = Instance.new("TextLabel")
    LoadingLogo.Size = UDim2.new(1, 0, 0, 60)
    LoadingLogo.Position = UDim2.new(0, 0, 0, 40)
    LoadingLogo.BackgroundTransparency = 1
    LoadingLogo.Text = "KRAVIX"
    LoadingLogo.TextColor3 = Color3.fromRGB(255, 255, 255)
    LoadingLogo.TextSize = 48
    LoadingLogo.Font = Enum.Font.GothamBold
    LoadingLogo.TextTransparency = 1
    LoadingLogo.Parent = LoadingBox
    
    local LogoGradient = Instance.new("UIGradient")
    LogoGradient.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 60, 60)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 0, 0))
    }
    LogoGradient.Parent = LoadingLogo
    
    task.spawn(function()
        while LoadingFrame.Parent do
            Tween(LogoGradient, {Rotation = 360}, 3, Enum.EasingStyle.Linear):Play()
            task.wait(3)
            LogoGradient.Rotation = 0
        end
    end)
    
    local LoadingText = Instance.new("TextLabel")
    LoadingText.Size = UDim2.new(1, 0, 0, 25)
    LoadingText.Position = UDim2.new(0, 0, 0, 110)
    LoadingText.BackgroundTransparency = 1
    LoadingText.Text = "Loading UI Components..."
    LoadingText.TextColor3 = Color3.fromRGB(140, 140, 140)
    LoadingText.TextSize = 14
    LoadingText.Font = Enum.Font.Gotham
    LoadingText.TextTransparency = 1
    LoadingText.Parent = LoadingBox
    
    local LoadingBar = Instance.new("Frame")
    LoadingBar.Size = UDim2.new(0, 350, 0, 4)
    LoadingBar.Position = UDim2.new(0.5, -175, 0, 160)
    LoadingBar.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    LoadingBar.BorderSizePixel = 0
    LoadingBar.BackgroundTransparency = 1
    LoadingBar.Parent = LoadingBox
    
    local BarCorner = Instance.new("UICorner")
    BarCorner.CornerRadius = UDim.new(1, 0)
    BarCorner.Parent = LoadingBar
    
    local LoadingFill = Instance.new("Frame")
    LoadingFill.Size = UDim2.new(0, 0, 1, 0)
    LoadingFill.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
    LoadingFill.BorderSizePixel = 0
    LoadingFill.Parent = LoadingBar
    
    local FillCorner = Instance.new("UICorner")
    FillCorner.CornerRadius = UDim.new(1, 0)
    FillCorner.Parent = LoadingFill
    
    local FillGradient = Instance.new("UIGradient")
    FillGradient.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.fromRGB(200, 0, 0)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 50, 50)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 0, 0))
    }
    FillGradient.Parent = LoadingFill
    
    local LoadingPercent = Instance.new("TextLabel")
    LoadingPercent.Size = UDim2.new(1, 0, 0, 20)
    LoadingPercent.Position = UDim2.new(0, 0, 0, 175)
    LoadingPercent.BackgroundTransparency = 1
    LoadingPercent.Text = "0%"
    LoadingPercent.TextColor3 = Color3.fromRGB(200, 0, 0)
    LoadingPercent.TextSize = 13
    LoadingPercent.Font = Enum.Font.GothamBold
    LoadingPercent.TextTransparency = 1
    LoadingPercent.Parent = LoadingBox
    
    Tween(LoadingLogo, {TextTransparency = 0}, 0.6):Play()
    task.wait(0.3)
    Tween(LoadingText, {TextTransparency = 0}, 0.5):Play()
    Tween(LoadingBar, {BackgroundTransparency = 0}, 0.5):Play()
    Tween(LoadingPercent, {TextTransparency = 0}, 0.5):Play()
    task.wait(0.5)
    
    local messages = {"Initializing...", "Loading Components...", "Preparing Interface...", "Almost Ready..."}
    for i = 1, 100 do
        LoadingFill.Size = UDim2.new(i / 100, 0, 1, 0)
        LoadingPercent.Text = i .. "%"
        if i % 25 == 0 then
            LoadingText.Text = messages[math.floor(i / 25)] or "Loading..."
        end
        task.wait(0.015)
    end
    
    task.wait(0.3)
    Tween(LoadingBox, {BackgroundTransparency = 1}, 0.4):Play()
    Tween(BoxStroke, {Transparency = 1}, 0.4):Play()
    Tween(LoadingLogo, {TextTransparency = 1}, 0.4):Play()
    Tween(LoadingText, {TextTransparency = 1}, 0.4):Play()
    Tween(LoadingBar, {BackgroundTransparency = 1}, 0.4):Play()
    Tween(LoadingFill, {BackgroundTransparency = 1}, 0.4):Play()
    Tween(LoadingPercent, {TextTransparency = 1}, 0.4):Play()
    Tween(LoadingFrame, {BackgroundTransparency = 1}, 0.4):Play()
    task.wait(0.4)
    LoadingFrame:Destroy()
    
    local Main = Instance.new("Frame")
    Main.Name = "Main"
    Main.Size = UDim2.new(0, 750, 0, 480)
    Main.Position = UDim2.new(0.5, -375, 0.5, -240)
    Main.BackgroundColor3 = Color3.fromRGB(12, 12, 12)
    Main.BorderSizePixel = 0
    Main.BackgroundTransparency = 1
    Main.Parent = ScreenGui
    
    local MainCorner = Instance.new("UICorner")
    MainCorner.CornerRadius = UDim.new(0, 6)
    MainCorner.Parent = Main
    
    local MainStroke = Instance.new("UIStroke")
    MainStroke.Color = Color3.fromRGB(200, 0, 0)
    MainStroke.Thickness = 1
    MainStroke.Transparency = 1
    MainStroke.Parent = Main
    
    Tween(Main, {BackgroundTransparency = 0}, 0.4):Play()
    Tween(MainStroke, {Transparency = 0.7}, 0.4):Play()
    
    local TopBar = Instance.new("Frame")
    TopBar.Size = UDim2.new(1, 0, 0, 50)
    TopBar.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    TopBar.BorderSizePixel = 0
    TopBar.Parent = Main
    
    local TopCorner = Instance.new("UICorner")
    TopCorner.CornerRadius = UDim.new(0, 6)
    TopCorner.Parent = TopBar
    
    local TopFix = Instance.new("Frame")
    TopFix.Size = UDim2.new(1, 0, 0, 25)
    TopFix.Position = UDim2.new(0, 0, 1, -25)
    TopFix.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    TopFix.BorderSizePixel = 0
    TopFix.Parent = TopBar
    
    local AccentLine = Instance.new("Frame")
    AccentLine.Size = UDim2.new(1, 0, 0, 2)
    AccentLine.Position = UDim2.new(0, 0, 1, 0)
    AccentLine.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
    AccentLine.BorderSizePixel = 0
    AccentLine.Parent = TopBar
    
    local LineGradient = Instance.new("UIGradient")
    LineGradient.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.fromRGB(200, 0, 0)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 50, 50)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 0, 0))
    }
    LineGradient.Parent = AccentLine
    
    task.spawn(function()
        while Main.Parent do
            Tween(LineGradient, {Offset = Vector2.new(1, 0)}, 2, Enum.EasingStyle.Linear):Play()
            task.wait(2)
            LineGradient.Offset = Vector2.new(-1, 0)
        end
    end)
    
    local Logo = Instance.new("TextLabel")
    Logo.Size = UDim2.new(0, 150, 1, 0)
    Logo.Position = UDim2.new(0, 15, 0, 0)
    Logo.BackgroundTransparency = 1
    Logo.Text = "KRAVIX"
    Logo.TextColor3 = Color3.fromRGB(255, 255, 255)
    Logo.TextSize = 20
    Logo.Font = Enum.Font.GothamBold
    Logo.TextXAlignment = Enum.TextXAlignment.Left
    Logo.Parent = TopBar
    
    local LogoGrad = Instance.new("UIGradient")
    LogoGrad.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 60, 60)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 0, 0))
    }
    LogoGrad.Parent = Logo
    
    local Subtitle = Instance.new("TextLabel")
    Subtitle.Size = UDim2.new(0, 200, 0, 16)
    Subtitle.Position = UDim2.new(0, 15, 0, 28)
    Subtitle.BackgroundTransparency = 1
    Subtitle.Text = config.Name or "Premium UI Library"
    Subtitle.TextColor3 = Color3.fromRGB(110, 110, 110)
    Subtitle.TextSize = 11
    Subtitle.Font = Enum.Font.Gotham
    Subtitle.TextXAlignment = Enum.TextXAlignment.Left
    Subtitle.Parent = TopBar
    
    local CloseBtn = Instance.new("TextButton")
    CloseBtn.Size = UDim2.new(0, 34, 0, 34)
    CloseBtn.Position = UDim2.new(1, -42, 0.5, -17)
    CloseBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    CloseBtn.Text = ""
    CloseBtn.Parent = TopBar
    
    local CloseCorner = Instance.new("UICorner")
    CloseCorner.CornerRadius = UDim.new(0, 6)
    CloseCorner.Parent = CloseBtn
    
    local CloseIcon = Instance.new("TextLabel")
    CloseIcon.Size = UDim2.new(1, 0, 1, 0)
    CloseIcon.BackgroundTransparency = 1
    CloseIcon.Text = "×"
    CloseIcon.TextColor3 = Color3.fromRGB(255, 255, 255)
    CloseIcon.TextSize = 22
    CloseIcon.Font = Enum.Font.GothamBold
    CloseIcon.Parent = CloseBtn
    
    CloseBtn.MouseEnter:Connect(function()
        Tween(CloseBtn, {BackgroundColor3 = Color3.fromRGB(200, 0, 0)}, 0.2):Play()
        Tween(CloseBtn, {Size = UDim2.new(0, 36, 0, 36)}, 0.2, Enum.EasingStyle.Back):Play()
    end)
    
    CloseBtn.MouseLeave:Connect(function()
        Tween(CloseBtn, {BackgroundColor3 = Color3.fromRGB(20, 20, 20)}, 0.2):Play()
        Tween(CloseBtn, {Size = UDim2.new(0, 34, 0, 34)}, 0.2):Play()
    end)
    
    CloseBtn.MouseButton1Click:Connect(function()
        Window.Visible = false
        Tween(Main, {Size = UDim2.new(0, 750, 0, 0)}, 0.3):Play()
        task.wait(0.3)
        Main.Visible = false
        CreateNotification("KraviX", "Press " .. Window.Keybind.Name .. " to reopen", 3)
    end)
    
    local TabContainer = Instance.new("ScrollingFrame")
    TabContainer.Size = UDim2.new(1, -20, 0, 45)
    TabContainer.Position = UDim2.new(0, 10, 0, 60)
    TabContainer.BackgroundTransparency = 1
    TabContainer.BorderSizePixel = 0
    TabContainer.ScrollBarThickness = 0
    TabContainer.CanvasSize = UDim2.new(0, 0, 0, 0)
    TabContainer.ScrollingDirection = Enum.ScrollingDirection.X
    TabContainer.Parent = Main
    
    local TabList = Instance.new("UIListLayout")
    TabList.FillDirection = Enum.FillDirection.Horizontal
    TabList.SortOrder = Enum.SortOrder.LayoutOrder
    TabList.Padding = UDim.new(0, 8)
    TabList.Parent = TabContainer
    
    TabList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        TabContainer.CanvasSize = UDim2.new(0, TabList.AbsoluteContentSize.X, 0, 0)
    end)
    
    local ContentContainer = Instance.new("Frame")
    ContentContainer.Size = UDim2.new(1, -20, 1, -125)
    ContentContainer.Position = UDim2.new(0, 10, 0, 115)
    ContentContainer.BackgroundTransparency = 1
    ContentContainer.Parent = Main
    
    local dragging, dragInput, dragStart, startPos
    
    TopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = Main.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    
    TopBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            dragInput = input
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            Tween(Main, {Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)}, 0.1):Play()
        end
    end)
    
    UserInputService.InputBegan:Connect(function(input)
        if input.KeyCode == Window.Keybind then
            Window.Visible = not Window.Visible
            if Window.Visible then
                Main.Visible = true
                Main.Size = UDim2.new(0, 750, 0, 0)
                Tween(Main, {Size = UDim2.new(0, 750, 0, 480)}, 0.3, Enum.EasingStyle.Back):Play()
            else
                Tween(Main, {Size = UDim2.new(0, 750, 0, 0)}, 0.3):Play()
                task.wait(0.3)
                Main.Visible = false
            end
        end
    end)
    
    Window.Tabs = {}
    Window.Notify = CreateNotification
    
    function Window:CreateTab(name)
        local Tab = {}
        local tabIndex = #Window.Tabs + 1
        
        local TabBtn = Instance.new("TextButton")
        TabBtn.Size = UDim2.new(0, 110, 0, 38)
        TabBtn.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
        TabBtn.Text = ""
        TabBtn.Parent = TabContainer
        
        local TabCorner = Instance.new("UICorner")
        TabCorner.CornerRadius = UDim.new(0, 6)
        TabCorner.Parent = TabBtn
        
        local TabStroke = Instance.new("UIStroke")
        TabStroke.Color = Color3.fromRGB(30, 30, 30)
        TabStroke.Thickness = 1
        TabStroke.Transparency = 0.5
        TabStroke.Parent = TabBtn
        
        local TabLabel = Instance.new("TextLabel")
        TabLabel.Size = UDim2.new(1, 0, 1, 0)
        TabLabel.BackgroundTransparency = 1
        TabLabel.Text = name
        TabLabel.TextColor3 = Color3.fromRGB(130, 130, 130)
        TabLabel.TextSize = 13
        TabLabel.Font = Enum.Font.GothamBold
        TabLabel.Parent = TabBtn
        
        local TabContent = Instance.new("ScrollingFrame")
        TabContent.Size = UDim2.new(1, 0, 1, 0)
        TabContent.BackgroundTransparency = 1
        TabContent.BorderSizePixel = 0
        TabContent.ScrollBarThickness = 4
        TabContent.ScrollBarImageColor3 = Color3.fromRGB(200, 0, 0)
        TabContent.Visible = false
        TabContent.Position = UDim2.new(0, 20, 0, 0)
        TabContent.Parent = ContentContainer
        
        local ContentList = Instance.new("UIListLayout")
        ContentList.SortOrder = Enum.SortOrder.LayoutOrder
        ContentList.Padding = UDim.new(0, 8)
        ContentList.Parent = TabContent
        
        local ContentPadding = Instance.new("UIPadding")
        ContentPadding.PaddingTop = UDim.new(0, 5)
        ContentPadding.PaddingRight = UDim.new(0, 6)
        ContentPadding.Parent = TabContent
        
        ContentList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            TabContent.CanvasSize = UDim2.new(0, 0, 0, ContentList.AbsoluteContentSize.Y + 10)
        end)
        
        TabBtn.MouseEnter:Connect(function()
            if not TabContent.Visible then
                Tween(TabBtn, {BackgroundColor3 = Color3.fromRGB(22, 22, 22)}, 0.2):Play()
                Tween(TabStroke, {Transparency = 0.3}, 0.2):Play()
                Tween(TabBtn, {Size = UDim2.new(0, 115, 0, 40)}, 0.2, Enum.EasingStyle.Back):Play()
            end
        end)
        
        TabBtn.MouseLeave:Connect(function()
            if not TabContent.Visible then
                Tween(TabBtn, {BackgroundColor3 = Color3.fromRGB(18, 18, 18)}, 0.2):Play()
                Tween(TabStroke, {Transparency = 0.5}, 0.2):Play()
                Tween(TabBtn, {Size = UDim2.new(0, 110, 0, 38)}, 0.2):Play()
            end
        end)
        
        TabBtn.MouseButton1Click:Connect(function()
            for _, tab in pairs(ContentContainer:GetChildren()) do
                if tab:IsA("ScrollingFrame") then
                    Tween(tab, {Position = UDim2.new(0, -20, 0, 0)}, 0.2):Play()
                    task.wait(0.1)
                    tab.Visible = false
                end
            end
            for _, btn in pairs(TabContainer:GetChildren()) do
                if btn:IsA("TextButton") then
                    Tween(btn, {BackgroundColor3 = Color3.fromRGB(18, 18, 18), Size = UDim2.new(0, 110, 0, 38)}, 0.2):Play()
                    for _, child in pairs(btn:GetChildren()) do
                        if child:IsA("TextLabel") then
                            Tween(child, {TextColor3 = Color3.fromRGB(130, 130, 130)}, 0.2):Play()
                        end
                        if child:IsA("UIStroke") then
                            Tween(child, {Color = Color3.fromRGB(30, 30, 30), Transparency = 0.5}, 0.2):Play()
                        end
                    end
                end
            end
            TabContent.Position = UDim2.new(0, 20, 0, 0)
            TabContent.Visible = true
            Tween(TabContent, {Position = UDim2.new(0, 0, 0, 0)}, 0.3, Enum.EasingStyle.Back):Play()
            Tween(TabBtn, {BackgroundColor3 = Color3.fromRGB(200, 0, 0), Size = UDim2.new(0, 115, 0, 40)}, 0.2, Enum.EasingStyle.Back):Play()
            Tween(TabLabel, {TextColor3 = Color3.fromRGB(255, 255, 255)}, 0.2):Play()
            Tween(TabStroke, {Color = Color3.fromRGB(255, 50, 50), Transparency = 0}, 0.2):Play()
        end)
        
        if #Window.Tabs == 0 then
            TabContent.Visible = true
            TabBtn.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
            TabBtn.Size = UDim2.new(0, 115, 0, 40)
            TabLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            TabStroke.Color = Color3.fromRGB(255, 50, 50)
            TabStroke.Transparency = 0
        end
        
        table.insert(Window.Tabs, Tab)
        
        function Tab:CreateButton(text, callback)
            local Button = Instance.new("TextButton")
            Button.Size = UDim2.new(1, 0, 0, 40)
            Button.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
            Button.Text = ""
            Button.Parent = TabContent
            
            local BtnCorner = Instance.new("UICorner")
            BtnCorner.CornerRadius = UDim.new(0, 6)
            BtnCorner.Parent = Button
            
            local BtnStroke = Instance.new("UIStroke")
            BtnStroke.Color = Color3.fromRGB(30, 30, 30)
            BtnStroke.Thickness = 1
            BtnStroke.Transparency = 0.5
            BtnStroke.Parent = Button
            
            local BtnAccent = Instance.new("Frame")
            BtnAccent.Size = UDim2.new(0, 3, 0, 20)
            BtnAccent.Position = UDim2.new(0, 8, 0.5, -10)
            BtnAccent.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
            BtnAccent.BorderSizePixel = 0
            BtnAccent.Parent = Button
            
            local AccentCorner = Instance.new("UICorner")
            AccentCorner.CornerRadius = UDim.new(1, 0)
            AccentCorner.Parent = BtnAccent
            
            local BtnLabel = Instance.new("TextLabel")
            BtnLabel.Size = UDim2.new(1, -25, 1, 0)
            BtnLabel.Position = UDim2.new(0, 18, 0, 0)
            BtnLabel.BackgroundTransparency = 1
            BtnLabel.Text = text
            BtnLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            BtnLabel.TextSize = 13
            BtnLabel.Font = Enum.Font.GothamSemibold
            BtnLabel.TextXAlignment = Enum.TextXAlignment.Left
            BtnLabel.Parent = Button
            
            Button.MouseEnter:Connect(function()
                Tween(Button, {BackgroundColor3 = Color3.fromRGB(22, 22, 22)}, 0.2):Play()
                Tween(BtnStroke, {Color = Color3.fromRGB(200, 0, 0), Transparency = 0.3}, 0.2):Play()
                Tween(BtnAccent, {Size = UDim2.new(0, 3, 0, 26)}, 0.2, Enum.EasingStyle.Back):Play()
            end)
            
            Button.MouseLeave:Connect(function()
                Tween(Button, {BackgroundColor3 = Color3.fromRGB(18, 18, 18)}, 0.2):Play()
                Tween(BtnStroke, {Color = Color3.fromRGB(30, 30, 30), Transparency = 0.5}, 0.2):Play()
                Tween(BtnAccent, {Size = UDim2.new(0, 3, 0, 20)}, 0.2):Play()
            end)
            
            Button.MouseButton1Click:Connect(function()
                Tween(Button, {BackgroundColor3 = Color3.fromRGB(200, 0, 0)}, 0.1):Play()
                Tween(BtnStroke, {Transparency = 0}, 0.1):Play()
                task.wait(0.12)
                Tween(Button, {BackgroundColor3 = Color3.fromRGB(18, 18, 18)}, 0.2):Play()
                Tween(BtnStroke, {Color = Color3.fromRGB(30, 30, 30), Transparency = 0.5}, 0.2):Play()
                callback()
            end)
        end
        
        function Tab:CreateToggle(text, default, callback)
            local toggled = default or false
            
            local Toggle = Instance.new("Frame")
            Toggle.Size = UDim2.new(1, 0, 0, 40)
            Toggle.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
            Toggle.Parent = TabContent
            
            local ToggleCorner = Instance.new("UICorner")
            ToggleCorner.CornerRadius = UDim.new(0, 6)
            ToggleCorner.Parent = Toggle
            
            local ToggleStroke = Instance.new("UIStroke")
            ToggleStroke.Color = Color3.fromRGB(30, 30, 30)
            ToggleStroke.Thickness = 1
            ToggleStroke.Transparency = 0.5
            ToggleStroke.Parent = Toggle
            
            local ToggleAccent = Instance.new("Frame")
            ToggleAccent.Size = UDim2.new(0, 3, 0, 20)
            ToggleAccent.Position = UDim2.new(0, 8, 0.5, -10)
            ToggleAccent.BackgroundColor3 = toggled and Color3.fromRGB(200, 0, 0) or Color3.fromRGB(50, 50, 50)
            ToggleAccent.BorderSizePixel = 0
            ToggleAccent.Parent = Toggle
            
            local AccentCorner = Instance.new("UICorner")
            AccentCorner.CornerRadius = UDim.new(1, 0)
            AccentCorner.Parent = ToggleAccent
            
            local ToggleLabel = Instance.new("TextLabel")
            ToggleLabel.Size = UDim2.new(1, -75, 1, 0)
            ToggleLabel.Position = UDim2.new(0, 18, 0, 0)
            ToggleLabel.BackgroundTransparency = 1
            ToggleLabel.Text = text
            ToggleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            ToggleLabel.TextSize = 13
            ToggleLabel.Font = Enum.Font.GothamSemibold
            ToggleLabel.TextXAlignment = Enum.TextXAlignment.Left
            ToggleLabel.Parent = Toggle
            
            local ToggleBtn = Instance.new("TextButton")
            ToggleBtn.Size = UDim2.new(0, 42, 0, 22)
            ToggleBtn.Position = UDim2.new(1, -50, 0.5, -11)
            ToggleBtn.BackgroundColor3 = toggled and Color3.fromRGB(200, 0, 0) or Color3.fromRGB(30, 30, 30)
            ToggleBtn.Text = ""
            ToggleBtn.Parent = Toggle
            
            local ToggleBtnCorner = Instance.new("UICorner")
            ToggleBtnCorner.CornerRadius = UDim.new(1, 0)
            ToggleBtnCorner.Parent = ToggleBtn
            
            local ToggleCircle = Instance.new("Frame")
            ToggleCircle.Size = UDim2.new(0, 16, 0, 16)
            ToggleCircle.Position = toggled and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
            ToggleCircle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            ToggleCircle.Parent = ToggleBtn
            
            local CircleCorner = Instance.new("UICorner")
            CircleCorner.CornerRadius = UDim.new(1, 0)
            CircleCorner.Parent = ToggleCircle
            
            ToggleBtn.MouseButton1Click:Connect(function()
                toggled = not toggled
                Tween(ToggleBtn, {BackgroundColor3 = toggled and Color3.fromRGB(200, 0, 0) or Color3.fromRGB(30, 30, 30)}, 0.2):Play()
                Tween(ToggleCircle, {Position = toggled and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)}, 0.2, Enum.EasingStyle.Back):Play()
                Tween(ToggleAccent, {BackgroundColor3 = toggled and Color3.fromRGB(200, 0, 0) or Color3.fromRGB(50, 50, 50)}, 0.2):Play()
                callback(toggled)
            end)
        end
        
        function Tab:CreateSlider(text, min, max, default, callback)
            local value = default or min
            
            local Slider = Instance.new("Frame")
            Slider.Size = UDim2.new(1, 0, 0, 52)
            Slider.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
            Slider.Parent = TabContent
            
            local SliderCorner = Instance.new("UICorner")
            SliderCorner.CornerRadius = UDim.new(0, 6)
            SliderCorner.Parent = Slider
            
            local SliderStroke = Instance.new("UIStroke")
            SliderStroke.Color = Color3.fromRGB(30, 30, 30)
            SliderStroke.Thickness = 1
            SliderStroke.Transparency = 0.5
            SliderStroke.Parent = Slider
            
            local SliderAccent = Instance.new("Frame")
            SliderAccent.Size = UDim2.new(0, 3, 0, 20)
            SliderAccent.Position = UDim2.new(0, 8, 0, 10)
            SliderAccent.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
            SliderAccent.BorderSizePixel = 0
            SliderAccent.Parent = Slider
            
            local AccentCorner = Instance.new("UICorner")
            AccentCorner.CornerRadius = UDim.new(1, 0)
            AccentCorner.Parent = SliderAccent
            
            local SliderLabel = Instance.new("TextLabel")
            SliderLabel.Size = UDim2.new(1, -75, 0, 20)
            SliderLabel.Position = UDim2.new(0, 18, 0, 10)
            SliderLabel.BackgroundTransparency = 1
            SliderLabel.Text = text
            SliderLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            SliderLabel.TextSize = 13
            SliderLabel.Font = Enum.Font.GothamSemibold
            SliderLabel.TextXAlignment = Enum.TextXAlignment.Left
            SliderLabel.Parent = Slider
            
            local SliderValue = Instance.new("TextLabel")
            SliderValue.Size = UDim2.new(0, 55, 0, 20)
            SliderValue.Position = UDim2.new(1, -63, 0, 10)
            SliderValue.BackgroundTransparency = 1
            SliderValue.Text = tostring(value)
            SliderValue.TextColor3 = Color3.fromRGB(200, 0, 0)
            SliderValue.TextSize = 13
            SliderValue.Font = Enum.Font.GothamBold
            SliderValue.TextXAlignment = Enum.TextXAlignment.Right
            SliderValue.Parent = Slider
            
            local SliderBar = Instance.new("Frame")
            SliderBar.Size = UDim2.new(1, -28, 0, 4)
            SliderBar.Position = UDim2.new(0, 14, 1, -14)
            SliderBar.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
            SliderBar.BorderSizePixel = 0
            SliderBar.Parent = Slider
            
            local BarCorner = Instance.new("UICorner")
            BarCorner.CornerRadius = UDim.new(1, 0)
            BarCorner.Parent = SliderBar
            
            local SliderFill = Instance.new("Frame")
            SliderFill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
            SliderFill.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
            SliderFill.BorderSizePixel = 0
            SliderFill.Parent = SliderBar
            
            local FillCorner = Instance.new("UICorner")
            FillCorner.CornerRadius = UDim.new(1, 0)
            FillCorner.Parent = SliderFill
            
            local dragging = false
            
            SliderBar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = true
                end
            end)
            
            SliderBar.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = false
                end
            end)
            
            UserInputService.InputChanged:Connect(function(input)
                if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                    local pos = math.clamp((input.Position.X - SliderBar.AbsolutePosition.X) / SliderBar.AbsoluteSize.X, 0, 1)
                    value = math.floor(min + (max - min) * pos)
                    SliderValue.Text = tostring(value)
                    Tween(SliderFill, {Size = UDim2.new(pos, 0, 1, 0)}, 0.1):Play()
                    callback(value)
                end
            end)
        end
        
        function Tab:CreateDropdown(text, options, callback)
            local selected = options[1] or ""
            local opened = false
            
            local Dropdown = Instance.new("Frame")
            Dropdown.Size = UDim2.new(1, 0, 0, 40)
            Dropdown.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
            Dropdown.ClipsDescendants = true
            Dropdown.Parent = TabContent
            
            local DropCorner = Instance.new("UICorner")
            DropCorner.CornerRadius = UDim.new(0, 6)
            DropCorner.Parent = Dropdown
            
            local DropStroke = Instance.new("UIStroke")
            DropStroke.Color = Color3.fromRGB(30, 30, 30)
            DropStroke.Thickness = 1
            DropStroke.Transparency = 0.5
            DropStroke.Parent = Dropdown
            
            local DropAccent = Instance.new("Frame")
            DropAccent.Size = UDim2.new(0, 3, 0, 20)
            DropAccent.Position = UDim2.new(0, 8, 0, 10)
            DropAccent.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
            DropAccent.BorderSizePixel = 0
            DropAccent.Parent = Dropdown
            
            local AccentCorner = Instance.new("UICorner")
            AccentCorner.CornerRadius = UDim.new(1, 0)
            AccentCorner.Parent = DropAccent
            
            local DropLabel = Instance.new("TextLabel")
            DropLabel.Size = UDim2.new(1, -130, 0, 40)
            DropLabel.Position = UDim2.new(0, 18, 0, 0)
            DropLabel.BackgroundTransparency = 1
            DropLabel.Text = text
            DropLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            DropLabel.TextSize = 13
            DropLabel.Font = Enum.Font.GothamSemibold
            DropLabel.TextXAlignment = Enum.TextXAlignment.Left
            DropLabel.Parent = Dropdown
            
            local DropSelected = Instance.new("TextLabel")
            DropSelected.Size = UDim2.new(0, 100, 0, 40)
            DropSelected.Position = UDim2.new(1, -108, 0, 0)
            DropSelected.BackgroundTransparency = 1
            DropSelected.Text = selected
            DropSelected.TextColor3 = Color3.fromRGB(200, 0, 0)
            DropSelected.TextSize = 12
            DropSelected.Font = Enum.Font.GothamBold
            DropSelected.TextXAlignment = Enum.TextXAlignment.Right
            DropSelected.Parent = Dropdown
            
            local DropButton = Instance.new("TextButton")
            DropButton.Size = UDim2.new(1, 0, 0, 40)
            DropButton.BackgroundTransparency = 1
            DropButton.Text = ""
            DropButton.Parent = Dropdown
            
            local OptionsList = Instance.new("Frame")
            OptionsList.Size = UDim2.new(1, 0, 0, #options * 32)
            OptionsList.Position = UDim2.new(0, 0, 0, 40)
            OptionsList.BackgroundTransparency = 1
            OptionsList.Parent = Dropdown
            
            local OptionsLayout = Instance.new("UIListLayout")
            OptionsLayout.SortOrder = Enum.SortOrder.LayoutOrder
            OptionsLayout.Padding = UDim.new(0, 2)
            OptionsLayout.Parent = OptionsList
            
            for _, option in ipairs(options) do
                local OptionBtn = Instance.new("TextButton")
                OptionBtn.Size = UDim2.new(1, 0, 0, 30)
                OptionBtn.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
                OptionBtn.Text = option
                OptionBtn.TextColor3 = Color3.fromRGB(170, 170, 170)
                OptionBtn.TextSize = 12
                OptionBtn.Font = Enum.Font.Gotham
                OptionBtn.Parent = OptionsList
                
                local OptCorner = Instance.new("UICorner")
                OptCorner.CornerRadius = UDim.new(0, 5)
                OptCorner.Parent = OptionBtn
                
                OptionBtn.MouseEnter:Connect(function()
                    Tween(OptionBtn, {BackgroundColor3 = Color3.fromRGB(200, 0, 0), TextColor3 = Color3.fromRGB(255, 255, 255)}, 0.2):Play()
                end)
                
                OptionBtn.MouseLeave:Connect(function()
                    Tween(OptionBtn, {BackgroundColor3 = Color3.fromRGB(15, 15, 15), TextColor3 = Color3.fromRGB(170, 170, 170)}, 0.2):Play()
                end)
                
                OptionBtn.MouseButton1Click:Connect(function()
                    selected = option
                    DropSelected.Text = selected
                    opened = false
                    Tween(Dropdown, {Size = UDim2.new(1, 0, 0, 40)}, 0.2):Play()
                    callback(selected)
                end)
            end
            
            DropButton.MouseButton1Click:Connect(function()
                opened = not opened
                Tween(Dropdown, {Size = opened and UDim2.new(1, 0, 0, 40 + #options * 32 + (#options - 1) * 2) or UDim2.new(1, 0, 0, 40)}, 0.2, Enum.EasingStyle.Back):Play()
            end)
        end
        
        function Tab:CreateTextbox(text, placeholder, callback)
            local Textbox = Instance.new("Frame")
            Textbox.Size = UDim2.new(1, 0, 0, 40)
            Textbox.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
            Textbox.Parent = TabContent
            
            local TextboxCorner = Instance.new("UICorner")
            TextboxCorner.CornerRadius = UDim.new(0, 6)
            TextboxCorner.Parent = Textbox
            
            local TextboxStroke = Instance.new("UIStroke")
            TextboxStroke.Color = Color3.fromRGB(30, 30, 30)
            TextboxStroke.Thickness = 1
            TextboxStroke.Transparency = 0.5
            TextboxStroke.Parent = Textbox
            
            local TextboxAccent = Instance.new("Frame")
            TextboxAccent.Size = UDim2.new(0, 3, 0, 20)
            TextboxAccent.Position = UDim2.new(0, 8, 0.5, -10)
            TextboxAccent.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
            TextboxAccent.BorderSizePixel = 0
            TextboxAccent.Parent = Textbox
            
            local AccentCorner = Instance.new("UICorner")
            AccentCorner.CornerRadius = UDim.new(1, 0)
            AccentCorner.Parent = TextboxAccent
            
            local TextboxLabel = Instance.new("TextLabel")
            TextboxLabel.Size = UDim2.new(0, 120, 1, 0)
            TextboxLabel.Position = UDim2.new(0, 18, 0, 0)
            TextboxLabel.BackgroundTransparency = 1
            TextboxLabel.Text = text
            TextboxLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            TextboxLabel.TextSize = 13
            TextboxLabel.Font = Enum.Font.GothamSemibold
            TextboxLabel.TextXAlignment = Enum.TextXAlignment.Left
            TextboxLabel.Parent = Textbox
            
            local Input = Instance.new("TextBox")
            Input.Size = UDim2.new(1, -155, 0, 26)
            Input.Position = UDim2.new(0, 143, 0.5, -13)
            Input.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
            Input.PlaceholderText = placeholder
            Input.PlaceholderColor3 = Color3.fromRGB(90, 90, 90)
            Input.Text = ""
            Input.TextColor3 = Color3.fromRGB(255, 255, 255)
            Input.TextSize = 12
            Input.Font = Enum.Font.Gotham
            Input.Parent = Textbox
            
            local InputCorner = Instance.new("UICorner")
            InputCorner.CornerRadius = UDim.new(0, 5)
            InputCorner.Parent = Input
            
            local InputPadding = Instance.new("UIPadding")
            InputPadding.PaddingLeft = UDim.new(0, 8)
            InputPadding.Parent = Input
            
            Input.Focused:Connect(function()
                Tween(TextboxStroke, {Color = Color3.fromRGB(200, 0, 0), Transparency = 0.3}, 0.2):Play()
                Tween(Input, {BackgroundColor3 = Color3.fromRGB(20, 20, 20)}, 0.2):Play()
            end)
            
            Input.FocusLost:Connect(function(enter)
                Tween(TextboxStroke, {Color = Color3.fromRGB(30, 30, 30), Transparency = 0.5}, 0.2):Play()
                Tween(Input, {BackgroundColor3 = Color3.fromRGB(15, 15, 15)}, 0.2):Play()
                if enter then
                    callback(Input.Text)
                end
            end)
        end
        
        function Tab:CreateLabel(text)
            local Label = Instance.new("TextLabel")
            Label.Size = UDim2.new(1, 0, 0, 34)
            Label.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
            Label.Text = text
            Label.TextColor3 = Color3.fromRGB(255, 255, 255)
            Label.TextSize = 13
            Label.Font = Enum.Font.GothamSemibold
            Label.Parent = TabContent
            
            local LabelCorner = Instance.new("UICorner")
            LabelCorner.CornerRadius = UDim.new(0, 6)
            LabelCorner.Parent = Label
            
            local LabelStroke = Instance.new("UIStroke")
            LabelStroke.Color = Color3.fromRGB(30, 30, 30)
            LabelStroke.Thickness = 1
            LabelStroke.Transparency = 0.5
            LabelStroke.Parent = Label
            
            local LabelAccent = Instance.new("Frame")
            LabelAccent.Size = UDim2.new(0, 3, 0, 18)
            LabelAccent.Position = UDim2.new(0, 8, 0.5, -9)
            LabelAccent.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
            LabelAccent.BorderSizePixel = 0
            LabelAccent.Parent = Label
            
            local AccentCorner = Instance.new("UICorner")
            AccentCorner.CornerRadius = UDim.new(1, 0)
            AccentCorner.Parent = LabelAccent
            
            local LabelPadding = Instance.new("UIPadding")
            LabelPadding.PaddingLeft = UDim.new(0, 18)
            LabelPadding.Parent = Label
            
            return {
                SetText = function(self, newText)
                    Label.Text = newText
                end
            }
        end
        
        return Tab
    end
    
    CreateNotification("KraviX", "Loaded successfully! Press " .. Window.Keybind.Name .. " to toggle", 4)
    
    return Window
end

return KraviX
