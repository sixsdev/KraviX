-- JUMP POWER
-- ============================================================
local JumpState = {
    Enabled   = false,
    Power     = 50,
    InfJump   = false,
}

local function GetHumanoid()
    local char = Players.LocalPlayer.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function ApplyJump()
    local hum = GetHumanoid()
    if hum then
        hum.JumpPower = JumpState.Enabled and JumpState.Power or 50
    end
end

Players.LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(0.5)
    ApplyJump()
end)

UserInputService.JumpRequest:Connect(function()
    if not JumpState.InfJump then return end
    local char = Players.LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
end)

local MovGroup = Misc:Group("Movimento")

MovGroup:Toggle({
    Name    = "Jump Power",
    Tooltip = "Aumenta a força do pulo",
    Callback = function(v)
        JumpState.Enabled = v
        ApplyJump()
        Library:Notify(v and "Jump Power ativado!" or "Jump Power desativado", v and "success" or "warning")
    end
})

MovGroup:Slider({
    Name    = "Força do Pulo",
    Min     = 50,
    Max     = 500,
    Default = 50,
    Unit    = "",
    Tooltip = "50 = padrão Roblox",
    Callback = function(v)
        JumpState.Power = v
        if JumpState.Enabled then ApplyJump() end
    end
})

MovGroup:Toggle({
    Name    = "Infinite Jump",
    Tooltip = "Pula no ar quantas vezes quiser",
    Callback = function(v)
        JumpState.InfJump = v
        Library:Notify(v and "Infinite Jump ON" or "Infinite Jump OFF", v and "success" or "warning")
    end
})

MovGroup:Button({
    Name    = "Resetar Pulo",
    Variant = "Danger",
    Tooltip = "Volta ao padrão de 50",
    Callback = function()
        JumpState.Enabled = false
        JumpState.Power   = 50
        local hum = GetHumanoid()
        if hum then hum.JumpPower = 50 end
        Library:Notify("Pulo resetado para o padrão", "warning")
    end
})

