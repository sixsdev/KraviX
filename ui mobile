    Create("Frame", {
        Parent = g,
        Size = UDim2.new(1, 0, 0, 2),
        AnchorPoint = Vector2.new(xFlip and 1 or 0, yFlip and 1 or 0),
        Position = UDim2.new(xFlip and 1 or 0, 0, yFlip and 1 or 0, 0),
        BackgroundColor3 = CFG.AccentColor,
        BorderSizePixel = 0
    })
    Create("Frame", {
        Parent = g,
        Size = UDim2.new(0, 2, 1, 0),
        AnchorPoint = Vector2.new(xFlip and 1 or 0, yFlip and 1 or 0),
        Position = UDim2.new(xFlip and 1 or 0, 0, yFlip and 1 or 0, 0),
        BackgroundColor3 = CFG.AccentColor,
        BorderSizePixel = 0
    })
end
