local function CornerDeco(parent, xFlip, yFlip)
    local g = Create("Frame", {
        Parent = parent,
        Size = UDim2.new(0, 14, 0, 14),
        AnchorPoint = Vector2.new(xFlip and 1 or 0, yFlip and 1 or 0),
        Position = UDim2.new(xFlip and 1 or 0, xFlip and -1 or 1, yFlip and 1 or 0, yFlip and -1 or 1),
