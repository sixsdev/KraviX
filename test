    local S2Grad = Instance.new("UIGradient", Shine2)
    S2Grad.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0,0.55),NumberSequenceKeypoint.new(1,1)})

    -- ── Canto lacrimal (medial) ──────────────────────────────────
    local LacR = Instance.new("Frame", EyeRoot)
    LacR.Size = UDim2.new(0,18,0,14)
    LacR.AnchorPoint = Vector2.new(0,0.5)
    LacR.Position = UDim2.new(0,-EW/2-4,0.5,0)
    LacR.BackgroundColor3 = C.Lacrimal
    LacR.BackgroundTransparency = 1
    LacR.BorderSizePixel = 0; LacR.ZIndex = 218
    makeCorner(LacR,999)
    -- pontinho róseo
    local LacDot = Instance.new("Frame", LacR)
    LacDot.Size = UDim2.new(0,7,0,7); LacDot.AnchorPoint = Vector2.new(0.5,0.5)
    LacDot.Position = UDim2.new(0.5,0,0.5,0); LacDot.BackgroundColor3 = Color3.fromRGB(195,130,120)
    LacDot.BackgroundTransparency = 0.2; LacDot.BorderSizePixel = 0; LacDot.ZIndex = 219
    makeCorner(LacDot,999)

    -- Reflexo úmido na borda inferior da esclera
    local WetLine = Instance.new("Frame", EyeRoot)
    WetLine.Size = UDim2.new(0, EW-40, 0, 1)
    WetLine.AnchorPoint = Vector2.new(0.5,0.5)
    WetLine.Position = UDim2.new(0.5,0,0.5, EH/2-8)
    WetLine.BackgroundColor3 = Color3.fromRGB(180,210,235)
    WetLine.BackgroundTransparency = 0.5
    WetLine.BorderSizePixel = 0; WetLine.ZIndex = 208
    makeCorner(WetLine,1)
    local WLGrad = Instance.new("UIGradient", WetLine)
    WLGrad.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(0.2,0.4),NumberSequenceKeypoint.new(0.8,0.4),NumberSequenceKeypoint.new(1,1)})

    -- ── PÁLPEBRA SUPERIOR ────────────────────────────────────────
    -- A pálpebra é um frame que se move. Começa tapando o olho (Y=0),
    -- e se abre subindo para Y negativo.

    local LidTop = Instance.new("Frame", EyeRoot)
    LidTop.Size = UDim2.new(0, EW+20, 0, EH/2+10)
    LidTop.AnchorPoint = Vector2.new(0.5, 1)
    LidTop.Position = UDim2.new(0.5, 0, 0.5, 0)  -- tapando
    LidTop.BackgroundColor3 = C.LidSkin2
    LidTop.BorderSizePixel = 0; LidTop.ZIndex = 215
    makeCorner(LidTop, 0)
    local LTGrad = Instance.new("UIGradient", LidTop)
    LTGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0,  C.LoadBg),
        ColorSequenceKeypoint.new(0.6, C.LidSkin1),
        ColorSequenceKeypoint.new(1,  C.LidSkin2),
    })
    LTGrad.Rotation = 90

    -- Dobra da pálpebra superior (linha horizontal sutil)
    local LidFold = Instance.new("Frame", LidTop)
    LidFold.Size = UDim2.new(0.85,0,0,1)
    LidFold.AnchorPoint = Vector2.new(0.5,0.5)
    LidFold.Position = UDim2.new(0.5,0,0.35,0)
    LidFold.BackgroundColor3 = C.LidSkin1
    LidFold.BackgroundTransparency = 0.5; LidFold.BorderSizePixel = 0; LidFold.ZIndex = 216
    local LFGrad = Instance.new("UIGradient", LidFold)
    LFGrad.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(0.5,0),NumberSequenceKeypoint.new(1,1)})

    -- Base dos cílios superiores (linha escura na borda da pálpebra)
    local LashLine = Instance.new("Frame", LidTop)
    LashLine.Size = UDim2.new(1,0,0,3)
    LashLine.AnchorPoint = Vector2.new(0.5,1)
    LashLine.Position = UDim2.new(0.5,0,1,0)
    LashLine.BackgroundColor3 = C.LashBase
    LashLine.BackgroundTransparency = 0; LashLine.BorderSizePixel = 0; LashLine.ZIndex = 216

    -- Cílios superiores: vários frames finos rotacionados
    local lashData = {
        -- {posX_relativo, ângulo_graus, comprimento}
        {0.10, -78, 18}, {0.17, -75, 20}, {0.24, -72, 22}, {0.31, -70, 22},
        {0.38, -68, 23}, {0.44, -67, 24}, {0.50, -66, 24}, {0.56, -67, 24},
        {0.62, -68, 23}, {0.68, -70, 22}, {0.75, -72, 21}, {0.82, -75, 19},
        {0.88, -78, 17},
    }
    for _, ld in ipairs(lashData) do
        local lx, la, ll = ld[1], ld[2], ld[3]
        local Lash = Instance.new("Frame", LidTop)
        Lash.Size = UDim2.new(0, 1, 0, ll)
        Lash.AnchorPoint = Vector2.new(0.5, 1)
        Lash.Position = UDim2.new(lx, 0, 1, 0)
        Lash.BackgroundColor3 = C.LashBase
        Lash.BackgroundTransparency = 0.05
        Lash.BorderSizePixel = 0; Lash.ZIndex = 217
        Lash.Rotation = la
        local LashGrad = Instance.new("UIGradient", Lash)
        LashGrad.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0,0),NumberSequenceKeypoint.new(0.7,0.1),NumberSequenceKeypoint.new(1,0.8)})
        LashGrad.Rotation = 90
    end

    -- ── PÁLPEBRA INFERIOR ────────────────────────────────────────
    local LidBot = Instance.new("Frame", EyeRoot)
    LidBot.Size = UDim2.new(0, EW+20, 0, EH/2+10)
    LidBot.AnchorPoint = Vector2.new(0.5, 0)
    LidBot.Position = UDim2.new(0.5, 0, 0.5, 0)  -- tapando
    LidBot.BackgroundColor3 = C.LidSkin2
    LidBot.BorderSizePixel = 0; LidBot.ZIndex = 215
    makeCorner(LidBot, 0)
    local LBGrad = Instance.new("UIGradient", LidBot)
    LBGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0,  C.LidSkin2),
        ColorSequenceKeypoint.new(0.4, C.LidSkin1),
        ColorSequenceKeypoint.new(1,  C.LoadBg),
    })
    LBGrad.Rotation = 90

    -- Base dos cílios inferiores
    local LashLineBot = Instance.new("Frame", LidBot)
    LashLineBot.Size = UDim2.new(1,0,0,2)
    LashLineBot.AnchorPoint = Vector2.new(0.5,0)
    LashLineBot.Position = UDim2.new(0.5,0,0,0)
    LashLineBot.BackgroundColor3 = C.LashBase
    LashLineBot.BackgroundTransparency = 0.2; LashLineBot.BorderSizePixel = 0; LashLineBot.ZIndex = 216

    -- Cílios inferiores (menores)
    local lashBotData = {
        {0.15,-112,10},{0.24,-110,11},{0.33,-108,12},{0.42,-107,12},
        {0.50,-107,12},{0.58,-107,12},{0.67,-108,12},{0.76,-110,11},{0.85,-112,10},
    }
    for _, ld in ipairs(lashBotData) do
        local lx, la, ll = ld[1], ld[2], ld[3]
        local Lash = Instance.new("Frame", LidBot)
        Lash.Size = UDim2.new(0, 1, 0, ll)
        Lash.AnchorPoint = Vector2.new(0.5, 0)
        Lash.Position = UDim2.new(lx, 0, 0, 0)
        Lash.BackgroundColor3 = C.LashBase
        Lash.BackgroundTransparency = 0.2; Lash.BorderSizePixel = 0; Lash.ZIndex = 217
        Lash.Rotation = la
        local LashGrad = Instance.new("UIGradient", Lash)
        LashGrad.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0,0.1),NumberSequenceKeypoint.new(1,0.9)})
        LashGrad.Rotation = 90
    end

    -- ── Bolinhas de loading ──────────────────────────────────────
    local DOT_COUNT = 5
    local dotFrames = {}
    for i = 1, DOT_COUNT do
        local d = Instance.new("Frame", EyeRoot)
        d.Size = UDim2.new(0,6,0,6)
        d.AnchorPoint = Vector2.new(0.5,0.5)
        local spacing = 16
        local totalW  = (DOT_COUNT-1)*spacing
        d.Position = UDim2.new(0.5, (i-1)*spacing - totalW/2, 0.5, EH/2+32)
        d.BackgroundColor3 = C.White
        d.BackgroundTransparency = 1
        d.BorderSizePixel = 0; d.ZIndex = 220
        makeCorner(d, 999)
        dotFrames[i] = d
    end

    -- ── SEQUÊNCIA DE ANIMAÇÃO ─────────────────────────────────────
    local dotConn
    local dotTime = 0
    dotConn = RunService.Heartbeat:Connect(function(dt)
        if not EyeRoot.Parent then dotConn:Disconnect(); return end
        dotTime = dotTime + dt
        for i, d in ipairs(dotFrames) do
            if d.BackgroundTransparency < 0.95 then
                local phase = dotTime * 2.8 - (i-1)*0.32
                local t2    = (math.sin(phase) + 1) / 2
                d.BackgroundTransparency = 0.15 + (1-t2)*0.72
                local spacing = 16
                local totalW  = (DOT_COUNT-1)*spacing
                d.Position = UDim2.new(0.5, (i-1)*spacing - totalW/2, 0.5, EH/2+32 - math.sin(phase)*6)
            end
        end
    end)

    -- Gradiente girante do Kx
    local kxAngle = 90
    local kxConn
    kxConn = RunService.Heartbeat:Connect(function(dt)
        if not KxLbl.Parent then kxConn:Disconnect(); return end
        kxAngle = (kxAngle + dt*70) % 360
        KxGrad.Rotation = kxAngle
    end)

    task.spawn(function()
        -- Estado inicial: tudo invisível / pálpebras fechadas
        Glow.BackgroundTransparency     = 1
        Sclera.BackgroundTransparency   = 1
        Iris.BackgroundTransparency     = 1
        Limbus.BackgroundTransparency   = 1
        FiberCont.BackgroundTransparency = 1
        Pupil.BackgroundTransparency    = 1
        KxLbl.TextTransparency          = 1
        Shine1.BackgroundTransparency   = 1
        ShineCore.BackgroundTransparency = 1
        Shine2.BackgroundTransparency   = 1
        IrisRing.BackgroundTransparency = 1
        LacR.BackgroundTransparency     = 1
        WetLine.BackgroundTransparency  = 0.5
        for _,s in ipairs({makeStroke}) do end

        task.wait(0.45)

        -- 1. Glow ambiente aparece
        Tween(Glow, {BackgroundTransparency=0.82}, 0.5, Enum.EasingStyle.Sine):Play()
        task.wait(0.2)

        -- 2. Esclera aparece (olho ainda fechado)
        Tween(Sclera, {BackgroundTransparency=0}, 0.4, Enum.EasingStyle.Quad):Play()
        task.wait(0.35)

        -- 3. Pálpebras abrem com overshoot (Back)
        local openTopY  = -(EH/2 + 14)
        local openBotY  =  (EH/2 + 14)
        Tween(LidTop, {Position=UDim2.new(0.5,0,0.5,openTopY)}, 0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out):Play()
        Tween(LidBot, {Position=UDim2.new(0.5,0,0.5,openBotY)}, 0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out):Play()
        task.wait(0.22)

        -- 4. Veias aparecem
        for _, v in ipairs({V1,V2,V3,V4,V5,V6}) do
            Tween(v, {BackgroundTransparency=v.BackgroundTransparency}, 0.3):Play()
        end

        -- 5. Íris e limbus surgem
        Tween(Limbus,   {BackgroundTransparency=0.4}, 0.4, Enum.EasingStyle.Quint):Play()
        Tween(Iris,     {BackgroundTransparency=0},   0.45, Enum.EasingStyle.Quint):Play()
        Tween(IrisRing, {BackgroundTransparency=0.55},0.5, Enum.EasingStyle.Quint):Play()
        task.wait(0.3)

        -- 6. Pupila aparece
        Tween(Pupil, {BackgroundTransparency=0}, 0.35, Enum.EasingStyle.Quint):Play()
        task.wait(0.2)

        -- 7. Reflexos aparecem
        Tween(Shine1,     {BackgroundTransparency=0.08}, 0.4, Enum.EasingStyle.Back):Play()
        Tween(ShineCore,  {BackgroundTransparency=0},    0.3):Play()
        Tween(Shine2,     {BackgroundTransparency=0.55}, 0.4):Play()
        Tween(LacR,       {BackgroundTransparency=0.1},  0.4):Play()
        task.wait(0.25)

        -- 8. Kx aparece
        Tween(KxLbl, {TextTransparency=0}, 0.4, Enum.EasingStyle.Back):Play()
        task.wait(0.3)

        -- 9. Bolinhas de loading aparecem em cascata
        for i, d in ipairs(dotFrames) do
            task.delay((i-1)*0.07, function()
                Tween(d, {BackgroundTransparency=0.2}, 0.25):Play()
            end)
        end
        task.wait(0.6)

        -- 10. Pupila dilata ligeiramente (efeito orgânico)
        Tween(Pupil, {Size=UDim2.new(0,PUPIL_R*2+6,0,PUPIL_R*2+6)}, 1.2, Enum.EasingStyle.Sine):Play()
        task.wait(0.8)
        Tween(Pupil, {Size=UDim2.new(0,PUPIL_R*2,0,PUPIL_R*2)}, 1.4, Enum.EasingStyle.Sine):Play()

        -- 11. Aguarda loading
        task.wait(2.2)

        -- 12. Bolinhas somem
        for _, d in ipairs(dotFrames) do
            Tween(d, {BackgroundTransparency=1}, 0.2):Play()
        end
        task.wait(0.15)

        -- 13. Kx some
        Tween(KxLbl, {TextTransparency=1}, 0.28):Play()
        task.wait(0.12)

        -- 14. Reflexos somem
        Tween(Shine1,    {BackgroundTransparency=1}, 0.2):Play()
        Tween(ShineCore, {BackgroundTransparency=1}, 0.2):Play()
        Tween(Shine2,    {BackgroundTransparency=1}, 0.2):Play()
        task.wait(0.1)

        -- 15. Pupila contrai antes de fechar (piscar rápido)
        Tween(Pupil, {Size=UDim2.new(0,8,0,8)}, 0.15, Enum.EasingStyle.Back):Play()
        task.wait(0.15)

        -- 16. Pálpebras fecham
        Tween(LidTop, {Position=UDim2.new(0.5,0,0.5,0)}, 0.38, Enum.EasingStyle.Quint):Play()
        Tween(LidBot, {Position=UDim2.new(0.5,0,0.5,0)}, 0.38, Enum.EasingStyle.Quint):Play()
        task.wait(0.22)

        -- 17. Íris e esclera somem
        Tween(Iris,   {BackgroundTransparency=1}, 0.22):Play()
        Tween(Limbus, {BackgroundTransparency=1}, 0.22):Play()
        Tween(Pupil,  {BackgroundTransparency=1}, 0.22):Play()
        Tween(Sclera, {BackgroundTransparency=1}, 0.28):Play()
        Tween(Glow,   {BackgroundTransparency=1}, 0.35):Play()
        Tween(LacR,   {BackgroundTransparency=1}, 0.2):Play()
        task.wait(0.3)

        -- 18. Fade out geral
        Tween(Loader, {BackgroundTransparency=1}, 0.38):Play()
        task.wait(0.4)

        if kxConn then kxConn:Disconnect() end
        if dotConn then dotConn:Disconnect() end
        Loader:Destroy()
        onDone()
    end)
end

