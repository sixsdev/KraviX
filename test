    Shine.Size = UDim2.new(0,10,0,10)
    Shine.AnchorPoint = Vector2.new(0.5,0.5)
    Shine.Position = UDim2.new(0.5,-28,0.5,-28)
    Shine.BackgroundColor3 = Color3.fromRGB(255,255,255)
    Shine.BackgroundTransparency = 1
    Shine.BorderSizePixel = 0
    Shine.ZIndex = 211
    makeCorner(Shine, 999)

    -- Pálpebra superior (bloco simples, mesma cor do fundo)
    local LidTop = Instance.new("Frame", EyeRoot)
    LidTop.Size = UDim2.new(0,EW+20,0,EH/2+10)
    LidTop.AnchorPoint = Vector2.new(0.5,1)
    LidTop.Position = UDim2.new(0.5,0,0.5,0)
    LidTop.BackgroundColor3 = Color3.fromRGB(20,18,28)
    LidTop.BorderSizePixel = 0
    LidTop.ZIndex = 215

    -- Pálpebra inferior
    local LidBot = Instance.new("Frame", EyeRoot)
    LidBot.Size = UDim2.new(0,EW+20,0,EH/2+10)
    LidBot.AnchorPoint = Vector2.new(0.5,0)
    LidBot.Position = UDim2.new(0.5,0,0.5,0)
    LidBot.BackgroundColor3 = Color3.fromRGB(20,18,28)
    LidBot.BorderSizePixel = 0
    LidBot.ZIndex = 215

    -- Bolinhas de loading
    local DOT_N = 5
    local dots  = {}
    for i = 1, DOT_N do
        local d = Instance.new("Frame", EyeRoot)
        d.Size = UDim2.new(0,7,0,7)
        d.AnchorPoint = Vector2.new(0.5,0.5)
        local sp = 18
        d.Position = UDim2.new(0.5,(i-1)*sp-(DOT_N-1)*sp/2,0.5,EH/2+38)
        d.BackgroundColor3 = Color3.fromRGB(255,255,255)
        d.BackgroundTransparency = 1
        d.BorderSizePixel = 0
        d.ZIndex = 220
        makeCorner(d, 999)
        dots[i] = d
    end

    -- Conexões Heartbeat
    local dotTime = 0
    local dotConn = RunService.Heartbeat:Connect(function(dt)
        if not EyeRoot.Parent then return end
        dotTime = dotTime + dt
        for i, d in ipairs(dots) do
            if d.BackgroundTransparency < 0.95 then
                local ph = dotTime*2.6 - (i-1)*0.30
                local t2 = (math.sin(ph)+1)/2
                d.BackgroundTransparency = 0.10 + (1-t2)*0.76
                local sp = 18
                d.Position = UDim2.new(0.5,(i-1)*sp-(DOT_N-1)*sp/2,0.5,EH/2+38 - math.sin(ph)*7)
            end
        end
    end)

    local kxAngle = 90
    local kxConn = RunService.Heartbeat:Connect(function(dt)
        if not KxLbl.Parent then return end
        kxAngle = (kxAngle + dt*60) % 360
        KxGrad.Rotation = kxAngle
    end)

    -- Estado inicial: tudo invisível, pálpebras fechadas
    Sclera.BackgroundTransparency = 1
    Limbus.BackgroundTransparency = 1
    Iris.BackgroundTransparency   = 1
    Pupil.BackgroundTransparency  = 1
    KxLbl.TextTransparency        = 1
    Shine.BackgroundTransparency  = 1
    for _, d in ipairs(dots) do d.BackgroundTransparency = 1 end

    task.spawn(function()
        task.wait(0.4)

        -- 1. Esclera aparece
        Tween(Sclera, {BackgroundTransparency=0}, 0.3, Enum.EasingStyle.Quad):Play()
        task.wait(0.25)

        -- 2. Pálpebras abrem
        local openY = EH/2 + 14
        Tween(LidTop, {Position=UDim2.new(0.5,0,0.5,-openY)}, 0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out):Play()
        Tween(LidBot, {Position=UDim2.new(0.5,0,0.5, openY)}, 0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out):Play()
        task.wait(0.18)

        -- 3. Limbus + íris surgem
        Tween(Limbus, {BackgroundTransparency=0},   0.35, Enum.EasingStyle.Quint):Play()
        Tween(Iris,   {BackgroundTransparency=0},   0.38, Enum.EasingStyle.Quint):Play()
        task.wait(0.26)

        -- 4. Pupila
        Tween(Pupil, {BackgroundTransparency=0}, 0.28, Enum.EasingStyle.Quint):Play()
        task.wait(0.18)

        -- 5. Reflexo + Kx
        Tween(Shine,  {BackgroundTransparency=0.05}, 0.3):Play()
        Tween(KxLbl,  {TextTransparency=0},          0.35, Enum.EasingStyle.Back):Play()
        task.wait(0.55)

        -- 5b. PISCAR 2x no começo
        local function blink()
            Tween(LidTop, {Position=UDim2.new(0.5,0,0.5,0)},        0.07, Enum.EasingStyle.Quad):Play()
            Tween(LidBot, {Position=UDim2.new(0.5,0,0.5,0)},        0.07, Enum.EasingStyle.Quad):Play()
            task.wait(0.08)
            Tween(LidTop, {Position=UDim2.new(0.5,0,0.5,-openY)},   0.10, Enum.EasingStyle.Quad):Play()
            Tween(LidBot, {Position=UDim2.new(0.5,0,0.5, openY)},   0.10, Enum.EasingStyle.Quad):Play()
            task.wait(0.12)
        end
        blink()
        task.wait(0.45)
        blink()
        task.wait(0.2)

        -- 6. Bolinhas
        for i, d in ipairs(dots) do
            task.delay((i-1)*0.06, function()
                Tween(d, {BackgroundTransparency=0.15}, 0.22):Play()
            end)
        end
        task.wait(0.5)

        -- 7. Pupila dilata/contrai (orgânico)
        Tween(Pupil, {Size=UDim2.new(0,PUPIL_R*2+10,0,PUPIL_R*2+10)}, 1.0, Enum.EasingStyle.Sine):Play()
        task.wait(0.6)
        Tween(Pupil, {Size=UDim2.new(0,PUPIL_R*2,0,PUPIL_R*2)}, 1.1, Enum.EasingStyle.Sine):Play()

        -- 8. Aguarda
        task.wait(2.3)

        -- 9. Saída: bolinhas somem
        for _, d in ipairs(dots) do Tween(d,{BackgroundTransparency=1},0.16):Play() end
        task.wait(0.12)

        -- 10. Kx e reflexo somem
        Tween(KxLbl, {TextTransparency=1}, 0.22):Play()
        Tween(Shine,  {BackgroundTransparency=1}, 0.18):Play()
        task.wait(0.10)

        -- 11. Pupila contrai (piscar)
        Tween(Pupil, {Size=UDim2.new(0,6,0,6)}, 0.10, Enum.EasingStyle.Back):Play()
        task.wait(0.10)

        -- 12. Pálpebras fecham
        Tween(LidTop, {Position=UDim2.new(0.5,0,0.5,0)}, 0.32, Enum.EasingStyle.Quint):Play()
        Tween(LidBot, {Position=UDim2.new(0.5,0,0.5,0)}, 0.32, Enum.EasingStyle.Quint):Play()
        task.wait(0.20)

        -- 13. Tudo some
        Tween(Iris,   {BackgroundTransparency=1}, 0.18):Play()
        Tween(Limbus, {BackgroundTransparency=1}, 0.18):Play()
        Tween(Pupil,  {BackgroundTransparency=1}, 0.18):Play()
        Tween(Sclera, {BackgroundTransparency=1}, 0.22):Play()
        task.wait(0.24)

        -- 14. Fade final
        Tween(Loader, {BackgroundTransparency=1}, 0.32):Play()
        task.wait(0.35)

        if kxConn then kxConn:Disconnect() end
        if dotConn then dotConn:Disconnect() end
        Loader:Destroy()
        onDone()
    end)
end

