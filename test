local function Tween(obj, props, t, style, dir)
    return TweenService:Create(obj,
        TweenInfo.new(t or 0.22, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out),
        props)
end

local function protect(gui)
    for _, v in ipairs(CoreGui:GetChildren()) do
        if v.Name == gui.Name then v:Destroy() end
    end
    if gethui then
        for _, v in ipairs(gethui():GetChildren()) do
            if v.Name == gui.Name then v:Destroy() end
        end
    end
    if syn and syn.protect_gui then syn.protect_gui(gui); gui.Parent = CoreGui
    elseif gethui then gui.Parent = gethui()
    else gui.Parent = CoreGui end
end

local function makeCorner(p, r)
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r or 6); c.Parent = p; return c
end
local function makeStroke(p, col, thick, trans)
    local s = Instance.new("UIStroke")
    s.Color = col or Color3.fromRGB(42,42,70); s.Thickness = thick or 1; s.Transparency = trans or 0
    s.Parent = p; return s
end
local function makePadding(p, top, bot, left, right)
    local pad = Instance.new("UIPadding")
    pad.PaddingTop = UDim.new(0, top or 0); pad.PaddingBottom = UDim.new(0, bot or 0)
    pad.PaddingLeft = UDim.new(0, left or 0); pad.PaddingRight = UDim.new(0, right or 0)
    pad.Parent = p; return pad
end

