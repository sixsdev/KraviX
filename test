local function StartSnow(parent)
    local COUNT = 80
    local cont = Instance.new("Frame", parent)
    cont.Size = UDim2.new(1,0,1,0); cont.BackgroundTransparency = 1
    cont.ClipsDescendants = true; cont.ZIndex = 0; cont.Name = "SnowContainer"
    local flakes = {}
    for i = 1, COUNT do
        local sz = math.random(2,5)
        local f = Instance.new("Frame", cont)
        f.Size = UDim2.new(0,sz,0,sz); f.BackgroundColor3 = C.White
        f.BackgroundTransparency = math.random(30,68)/100
        f.BorderSizePixel = 0; f.ZIndex = 1; makeCorner(f,sz)
        flakes[i] = { frame=f, x=math.random(0,1000)/1000, y=math.random(-20,100)/100,
                      speed=math.random(3,9)/1000, drift=math.random(-4,4)/10000 }
        f.Position = UDim2.new(flakes[i].x,0,flakes[i].y,0)
    end
    RunService.Heartbeat:Connect(function(dt)
        if not cont or not cont.Parent then return end
        for _, fl in ipairs(flakes) do
            fl.y=fl.y+fl.speed*dt*60; fl.x=fl.x+fl.drift*dt*60
            if fl.y>1.05 then fl.y=-0.05; fl.x=math.random(0,1000)/1000 end
            if fl.x<0 then fl.x=1 end; if fl.x>1 then fl.x=0 end
            fl.frame.Position = UDim2.new(fl.x,0,fl.y,0)
        end
    end)
end

local function MakeDraggable(frame, handle)
    handle = handle or frame
    local drag, ds, sp
    handle.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
            drag=true; ds=i.Position; sp=frame.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if drag and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then
            local d = i.Position - ds
            frame.Position = UDim2.new(sp.X.Scale,sp.X.Offset+d.X,sp.Y.Scale,sp.Y.Offset+d.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
            drag=false
        end
    end)
end

