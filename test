    local KxLbl = Instance.new("TextLabel", EyeRoot)
    KxLbl.Size = UDim2.new(0,70,0,44)
    KxLbl.AnchorPoint = Vector2.new(0.5,0.5)
    KxLbl.Position = UDim2.new(0.5,0,0.5,0)
