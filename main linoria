    Library:CreateLabel({
        Position=UDim2.new(0,4,0,0); Size=UDim2.new(1,-4,1,0);
        Text=Text; TextXAlignment=Enum.TextXAlignment.Left;
        TextSize=14; ZIndex=103; Parent=nFrame;
    })
    local leftColor = Library:Create('Frame', {
        BackgroundColor3=Library.AccentColor; BorderSizePixel=0;
        Position=UDim2.new(0,-1,0,-1); Size=UDim2.new(0,3,1,2);
        ZIndex=104; Parent=nOuter;
    })
    Library:AddToRegistry(leftColor, { BackgroundColor3='AccentColor' }, true)
    pcall(nOuter.TweenSize, nOuter, UDim2.new(0,xSize+12,0,ySize), 'Out','Quad',0.4,true)
    task.spawn(function()
        task.wait(Time or 5)
        pcall(nOuter.TweenSize, nOuter, UDim2.new(0,0,0,ySize), 'Out','Quad',0.4,true)
        task.wait(0.4); nOuter:Destroy()
    end)
end

