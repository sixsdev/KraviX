    -- ── ══════════════════════════════════ ──
    -- ██  BOTÃO TOGGLE (abre/fecha a UI)   ██
    -- ██  Fica flutuante, sempre visível   ██
    -- ── ══════════════════════════════════ ──
    local ToggleBtn = Library:Create('TextButton', {
        Size             = UDim2.new(0, IsMobile and 56 or 44, 0, IsMobile and 56 or 44);
        Position         = UDim2.new(0, 10, 0.5, 0);
        BackgroundColor3 = Library.AccentColor;
        Text             = '☰';
        TextColor3       = Color3.new(1,1,1);
        TextSize         = IsMobile and 26 or 20;
        Font             = Enum.Font.GothamBold;
        AutoButtonColor  = false;
        ZIndex           = 300;
        Parent           = ScreenGui;
    })
    Library:Create('UICorner', { CornerRadius=UDim.new(0,10); Parent=ToggleBtn })

    -- Indica estado: ON = UI visível, OFF = UI oculta
    local toggleUIOpen = false

    local function SetToggleBtnState(open)
        toggleUIOpen = open
        ToggleBtn.Text            = open and '✕' or '☰'
        ToggleBtn.BackgroundColor3= open and Color3.fromRGB(200,50,50) or Library.AccentColor
    end

    -- Torna o botão arrastável no mobile
    local tDrag, tDragStart, tBtnStart = false
    ToggleBtn.InputBegan:Connect(function(inp)
        if inp.UserInputType==Enum.UserInputType.Touch
        or inp.UserInputType==Enum.UserInputType.MouseButton1 then
            tDrag      = true
            tDragStart = Vector2.new(inp.Position.X, inp.Position.Y)
            tBtnStart  = ToggleBtn.Position
        end
    end)
    local tMoved = false
    InputService.InputChanged:Connect(function(inp)
        if tDrag and (inp.UserInputType==Enum.UserInputType.Touch or inp.UserInputType==Enum.UserInputType.MouseMovement) then
            local delta = Vector2.new(inp.Position.X,inp.Position.Y) - tDragStart
            if delta.Magnitude > 5 then tMoved=true end
            if tMoved then
                ToggleBtn.Position = UDim2.new(
                    tBtnStart.X.Scale, tBtnStart.X.Offset+delta.X,
                    tBtnStart.Y.Scale, tBtnStart.Y.Offset+delta.Y
                )
            end
        end
    end)
    InputService.InputEnded:Connect(function(inp)
        if inp.UserInputType==Enum.UserInputType.Touch
        or inp.UserInputType==Enum.UserInputType.MouseButton1 then
            if tDrag and not tMoved then
                -- clique real → toggle
                if Library.Toggle then Library:Toggle() end
            end
            tDrag=false; tMoved=false
        end
    end)

    -- ── ══════════════════════════════════ ──
    -- ██  BOTÃO HIDE UI                    ██
    -- ██  Trava/destrava arraste da janela ██
    -- ── ══════════════════════════════════ ──
    local HideBtn = Library:Create('TextButton', {
