        end
    end)
    -- touch no HideBtn
    HideBtn.InputBegan:Connect(function(inp)
        if inp.UserInputType==Enum.UserInputType.Touch then
            isPinned = not isPinned
            if isPinned then
                HideBtn.Text             = '📌 Pinned'
                HideBtn.BackgroundColor3 = Color3.fromRGB(0,60,0)
                hbStroke.Color           = Color3.fromRGB(0,200,0)
